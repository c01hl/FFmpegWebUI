        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--spacing-3);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 170px;
    }

    .field-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .search-field {
        flex: 1 1 260px;
    }

    .result-count {
        margin: 0;
        color: var(--text-secondary);
