@code {
    private List<CommandTemplate> _allTemplates = [];
    private List<CommandTemplate> _visible = [];

    private string _searchInput = string.Empty;
    private string _typeFilter = "all";
    private string _sortColumn = "sort";
    private bool _sortAscending = true;

    private bool _isLoading = true;
    private bool _isExporting;
    private bool _isImporting;

    private AppStatus? _status;
    private bool _dataDirWritable;
    private int _cleanupDays = 30;
    private bool _isCleaning;

    private CommandTemplate? _editorTemplate;
    private bool _editorOpen;
    private bool _editorIsSystem;

    private CommandTemplate? _deleteTarget;
    private bool _deleteOpen;
    private bool _deleteBusy;

    private bool _resetOpen;
    private bool _resetBusy;

    private bool _importOpen;
    private string _importJson = string.Empty;
    private bool _importAsSystem;

    private bool IsBusy => _isExporting || _isImporting || _deleteBusy || _resetBusy || _isCleaning;

    private int _systemCount => _allTemplates.Count(t => t.Type == TemplateType.System);
    private int _userCount => _allTemplates.Count(t => t.Type == TemplateType.User);

    /// <summary>内置预设占用了 0..N，新建模板从「最大值 + 10」开始，避免排序值撞车。</summary>
    private int NextSortOrder => _allTemplates.Count == 0 ? 10 : _allTemplates.Max(t => t.SortOrder) + 10;

    private bool DeleteTargetIsSystem => _deleteTarget?.Type == TemplateType.System;

    private string _deleteTitle => DeleteTargetIsSystem ? "删除系统预设模板" : "删除模板";

    private string _deleteMessage => _deleteTarget is null
        ? string.Empty
        : $"确定要删除「{_deleteTarget.Name}」吗？";

    private string? _deleteDetail => _deleteTarget is null
        ? null
        : DeleteTargetIsSystem
            ? "这是系统预设模板：删除后，只要它仍然存在于内置预设列表中，" +
              "下次系统预设同步（应用升级或重置）时它还会重新出现。"
            : "这是用户自建模板：删除只影响模板本身，已经用它执行过的任务记录不受影响。";

    // ────────────────────────────────────────────────────────────────
    // 初始化
    // ────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // 诊断面板要显示实时的运行中/等待中数量，订阅后必须退订（Dispose）
        TaskService.TaskStatusChanged += OnTaskStatusChanged;

        await LoadAllAsync();
        await LoadDiagnosticsAsync();
    }

    public void Dispose()
    {
        TaskService.TaskStatusChanged -= OnTaskStatusChanged;
    }

    private void OnTaskStatusChanged(object? sender, TaskStatusEventArgs e) => _ = InvokeAsync(StateHasChanged);

    private async Task RefreshAllAsync()
    {
        await LoadAllAsync();
        await LoadDiagnosticsAsync();
    }

    private async Task LoadAllAsync()
    {
        _isLoading = true;
        try
        {
            _allTemplates = await TemplateService.GetAllTemplatesAsync();
        }
        catch (Exception ex)
        {
            _allTemplates = [];
            Toast.Error($"加载模板失败：{ex.Message}");
        }
        finally
        {
            _isLoading = false;
            RebuildView();
        }
    }

    private async Task LoadDiagnosticsAsync()
    {
        try
        {
            _status = await AppStatusService.GetStatusAsync();
        }
        catch (Exception ex)
        {
            _status = null;
            Toast.Warning($"读取运行状态失败：{ex.Message}");
        }

        try
        {
            _dataDirWritable = FileService.IsDirectoryWritable(AppPaths.DataDirectory);
        }
        catch (Exception ex)
        {
            _dataDirWritable = false;
            Toast.Warning($"无法确认数据目录是否可写：{ex.Message}");
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 表格：筛选 / 排序
    // ────────────────────────────────────────────────────────────────

    private void RebuildView()
    {
        IEnumerable<CommandTemplate> query = _allTemplates;

        if (_typeFilter == "system")
        {
            query = query.Where(t => t.Type == TemplateType.System);
        }
        else if (_typeFilter == "user")
        {
            query = query.Where(t => t.Type == TemplateType.User);
        }

        var search = _searchInput.Trim();
        if (search.Length > 0)
        {
            query = query.Where(t => Matches(t, search));
        }

        var filtered = query.ToList();

        _visible = _sortColumn switch
        {
            "name" => Order(filtered, t => t.Name, StringComparer.CurrentCulture),
            "category" => Order(filtered, t => t.Category, StringComparer.CurrentCulture),
            "type" => Order(filtered, t => (int)t.Type, null),
            "extension" => Order(filtered, t => t.OutputExtension, StringComparer.OrdinalIgnoreCase),
            "encoder" => Order(filtered, EncoderDisplay, StringComparer.CurrentCulture),
            "updated" => Order(filtered, t => t.UpdatedAt, null),
            _ => Order(filtered, t => t.SortOrder, null)
        };
    }

    private List<CommandTemplate> Order<TKey>(
        List<CommandTemplate> source,
        Func<CommandTemplate, TKey> keySelector,
        IComparer<TKey>? comparer)
    {
        var ordered = _sortAscending
            ? source.OrderBy(keySelector, comparer)
            : source.OrderByDescending(keySelector, comparer);

        return ordered.ThenBy(t => t.Name, StringComparer.CurrentCulture).ToList();
    }

    private void ToggleSort(string column)
    {
        if (string.Equals(_sortColumn, column, StringComparison.Ordinal))
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = column is "name" or "category" or "extension" or "encoder";
        }
        RebuildView();
    }

    private string AriaSort(string column) =>
        !string.Equals(_sortColumn, column, StringComparison.Ordinal)
            ? "none"
            : _sortAscending ? "ascending" : "descending";

    private string SortIndicator(string column) =>
        !string.Equals(_sortColumn, column, StringComparison.Ordinal)
            ? "↕"
            : _sortAscending ? "▲" : "▼";

    private void ClearFilters()
    {
        _searchInput = string.Empty;
        _typeFilter = "all";
        RebuildView();
    }

    private static bool Matches(CommandTemplate template, string search)
    {
        if (Contains(template.Name, search)) return true;
        if (Contains(template.Description, search)) return true;
        if (Contains(template.Category, search)) return true;
        if (Contains(template.OutputExtension, search)) return true;
        if (Contains(template.RequiredEncoder, search)) return true;
        return template.Tags.Any(tag => Contains(tag, search));
    }

    private static bool Contains(string? source, string search) =>
        !string.IsNullOrEmpty(source) && source.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static string EncoderDisplay(CommandTemplate template)
    {
        if (template.HardwareMode == HardwareAccelerationMode.None) return "不使用硬件加速";
        var mode = template.HardwareMode == HardwareAccelerationMode.Required ? "必须" : "自动";
        return $"{mode}：{EncoderLabel(template.RequiredEncoder)}";
    }

    private static string EncoderLabel(string? requiredEncoder)
    {
        if (string.IsNullOrWhiteSpace(requiredEncoder)) return "任意可用编码器";
        var family = EncoderCatalog.Find(requiredEncoder)?.Family ?? requiredEncoder;
        return EncoderCatalog.FamilyDisplayName(family);
    }

    // ────────────────────────────────────────────────────────────────
    // 新建 / 编辑
    // ────────────────────────────────────────────────────────────────

    private void OpenCreateEditor()
    {
        _editorTemplate = new CommandTemplate
        {
            Type = TemplateType.System,
            HardwareMode = HardwareAccelerationMode.None,
            SortOrder = NextSortOrder
        };
        _editorIsSystem = true;
        _editorOpen = true;
    }

    private void OpenEditEditor(CommandTemplate template)
    {
        if (template is null) return;
        _editorTemplate = CloneTemplate(template);
        _editorIsSystem = template.Type == TemplateType.System;
        _editorOpen = true;
    }

    private void OnEditorOpenChanged(bool open)
    {
        _editorOpen = open;
    }

    private async Task OnTemplateSaved(CommandTemplate template)
    {
        _editorOpen = false;
        _editorTemplate = null;
        Toast.Success($"模板「{template?.Name}」已保存");
        await LoadAllAsync();
    }

    // ────────────────────────────────────────────────────────────────
    // 删除
    // ────────────────────────────────────────────────────────────────

    private void RequestDelete(CommandTemplate template)
    {
        if (template is null) return;
        _deleteTarget = template;
        _deleteOpen = true;
    }

    private void OnDeleteOpenChanged(bool open)
    {
        _deleteOpen = open;
        if (!open && !_deleteBusy) _deleteTarget = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var target = _deleteTarget;
        if (target is null)
        {
            _deleteOpen = false;
            return;
        }

        _deleteBusy = true;
        try
        {
            var deleted = target.Type == TemplateType.System
                ? await TemplateService.DeleteSystemTemplateAsync(target.Id)
                : await TemplateService.DeleteTemplateAsync(target.Id);

            if (deleted)
            {
                Toast.Success(target.Type == TemplateType.System
                    ? $"已删除系统预设「{target.Name}」；只要它仍在内置预设列表中，下次预设同步或重置时就会重新出现。"
                    : $"已删除用户模板「{target.Name}」");
                _deleteOpen = false;
                _deleteTarget = null;
                await LoadAllAsync();
            }
            else
            {
                Toast.Error($"删除失败：服务返回未删除「{target.Name}」，它可能已经不存在，或类型不匹配。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"删除模板失败：{ex.Message}");
        }
        finally
        {
            _deleteBusy = false;
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 重置系统预设
    // ────────────────────────────────────────────────────────────────

    private void RequestReset()
    {
        _resetOpen = true;
    }

    private void OnResetOpenChanged(bool open)
    {
        _resetOpen = open;
    }

    private async Task ConfirmResetAsync()
    {
        _resetBusy = true;
        try
        {
            await TemplateService.ResetSystemTemplatesAsync();
            _resetOpen = false;
            Toast.Success($"系统预设模板已重置到 v{TemplateService.PresetVersion}（用户自建模板未受影响）");
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"重置系统预设失败：{ex.Message}");
        }
        finally
        {
            _resetBusy = false;
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 历史清理
    // ────────────────────────────────────────────────────────────────

    private async Task CleanupHistoryAsync()
    {
        if (_isCleaning) return;

        _isCleaning = true;
        try
        {
            var days = Math.Clamp(_cleanupDays, 1, 3650);
            var removed = await TaskService.CleanupHistoryAsync(DateTime.UtcNow.AddDays(-days));

            Toast.Success(removed > 0
                ? $"已清理 {removed} 条早于 {days} 天的历史任务记录（运行中/等待中的任务不受影响）"
                : $"没有早于 {days} 天的历史任务记录需要清理");

            await LoadDiagnosticsAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"清理历史任务失败：{ex.Message}");
        }
        finally
        {
            _isCleaning = false;
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 导入 / 导出
    // ────────────────────────────────────────────────────────────────

    private async Task ExportAsync()
    {
        if (_isExporting) return;

        if (_allTemplates.Count == 0)
        {
            Toast.Warning("没有可导出的模板。");
            return;
        }

        _isExporting = true;
        try
        {
            var json = TemplateService.ExportToJson(_allTemplates);
            var fileName = $"ffmpegwebui-templates-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            var saved = await JS.InvokeAsync<bool>("ffui.saveTextFile", fileName, json, "application/json");

            if (saved)
            {
                Toast.Success($"已导出 {_allTemplates.Count} 个模板到 {fileName}");
            }
            else
            {
                Toast.Error("导出失败：浏览器没有触发下载，请检查浏览器的下载权限或拦截设置。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"导出失败：{ex.Message}");
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void OpenImport()
    {
        _importJson = string.Empty;
        _importAsSystem = false;
        _importOpen = true;
    }

    private void CloseImport()
    {
        _importOpen = false;
    }

    private void OnImportOpenChanged(bool open)
    {
        _importOpen = open;
    }

    private async Task ImportAsync()
    {
        if (_isImporting) return;

        var json = (_importJson ?? string.Empty).Trim();
        if (json.Length == 0)
        {
            Toast.Warning("请先粘贴模板 JSON 内容。");
            return;
        }

        _isImporting = true;
        try
        {
            var imported = await TemplateService.ImportFromJsonAsync(json, _importAsSystem);
            if (imported > 0)
            {
                Toast.Success(_importAsSystem
                    ? $"已导入 {imported} 个模板（作为系统预设）"
                    : $"已导入 {imported} 个用户模板");
                _importOpen = false;
                _importJson = string.Empty;
                await LoadAllAsync();
            }
            else
            {
                Toast.Warning("没有导入任何模板：JSON 里没有含 name 与 commandArgs 的模板条目。");
            }
        }
        catch (InvalidOperationException ex)
        {
            Toast.Error($"导入失败：{ex.Message}");
        }
        catch (Exception ex)
        {
            Toast.Error($"导入失败：{ex.Message}");
        }
        finally
        {
            _isImporting = false;
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 工具
    // ────────────────────────────────────────────────────────────────

    private static CommandTemplate CloneTemplate(CommandTemplate source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Description = source.Description,
        CommandArgs = source.CommandArgs,
        Type = source.Type,
        Category = source.Category,
        SupportedInputFormats = [.. source.SupportedInputFormats],
        OutputExtension = source.OutputExtension,
        TargetCodec = source.TargetCodec,
        RequiresHardwareAcceleration = source.RequiresHardwareAcceleration,
        HardwareMode = source.HardwareMode,
        RequiredEncoder = source.RequiredEncoder,
        Parameters = source.Parameters.Select(p => new TemplateParameter
        {
            Name = p.Name,
            Label = p.Label,
            Description = p.Description,
            Kind = p.Kind,
            DefaultValue = p.DefaultValue,
            Options = p.Options.Select(o => new TemplateParameterOption(o.Value, o.Label, o.Description)).ToList(),
            Min = p.Min,
            Max = p.Max,
            TrueValue = p.TrueValue,
            FalseValue = p.FalseValue
        }).ToList(),
        Tags = [.. source.Tags],
        IsRecommended = source.IsRecommended,
        PresetVersion = source.PresetVersion,
        CreatedAt = source.CreatedAt,
        UpdatedAt = source.UpdatedAt,
        SortOrder = source.SortOrder
    };
}
