        font-size: 0.88rem;
    }

    .admin-warning {
        margin-bottom: var(--spacing-4);
    }

    .admin-warning p {
        margin: 0 0 0.35rem;
    }

    .admin-warning p:last-child {
        margin-bottom: 0;
    }

