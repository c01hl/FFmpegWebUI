@page "/templates-admin"
@page "/templates/admin"
@inject ITemplateService TemplateService
@inject ITaskService TaskService
@inject IFileService FileService
@inject IAppStatusService AppStatusService
@inject IToastService Toast
@inject IJSRuntime JS
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>预设模板管理 - @AppInfo.Name</PageTitle>

<div class="ffui-container">
    <div class="page-head">
        <div>
            <h1>🔧 预设模板管理</h1>
            <p class="page-sub">系统预设模板的完整增删改查、预设重置与运行诊断。</p>
        </div>
        <span class="ffui-badge ffui-badge-warning">⚠️ 高级页面</span>
    </div>

    <div class="ffui-alert ffui-alert-warning admin-warning" role="alert">
        <span aria-hidden="true">⚠️</span>
        <div>
            <p>
                这个页面可以直接修改<strong>系统预设模板</strong>，改动会影响「转换」与「批量处理」里的选项。
            </p>
            <p>
                应用默认只监听 127.0.0.1（仅本机可访问），因此没有额外的登录校验；
                如果把服务暴露到局域网，任何人都可以修改这里的模板。
            </p>
        </div>
    </div>

    <div class="head-actions">
        <button type="button" class="ffui-btn ffui-btn-primary" @onclick="OpenCreateEditor" disabled="@IsBusy">
            ➕ 新建
        </button>
        <button type="button" class="ffui-btn" @onclick="ExportAsync" disabled="@(IsBusy || _allTemplates.Count == 0)">
            ⬇️ 导出全部
        </button>
        <button type="button" class="ffui-btn" @onclick="OpenImport" disabled="@IsBusy">
            📥 导入
        </button>
        <button type="button" class="ffui-btn" @onclick="RefreshAllAsync" disabled="@IsBusy">
            🔄 刷新
        </button>
    </div>

    <div class="ffui-panel toolbar">
        <div class="toolbar-row">
            <label class="field search-field">
                <span class="field-label">搜索</span>
                <input type="search" placeholder="搜索名称、描述、分类、编码器…"
                       aria-label="搜索模板" @bind="_searchInput" @bind:event="oninput" @bind:after="RebuildView" />
            </label>

            <label class="field">
                <span class="field-label">类型</span>
                <select aria-label="按类型筛选" @bind="_typeFilter" @bind:after="RebuildView">
                    <option value="all">全部</option>
                    <option value="system">系统</option>
                    <option value="user">用户</option>
                </select>
            </label>

            <button type="button" class="ffui-btn" @onclick="ClearFilters" disabled='@(_searchInput.Length == 0 && _typeFilter == "all")'>
                清除筛选
            </button>
        </div>

        <p class="result-count" aria-live="polite">
            显示 @_visible.Count 个模板（共 @_allTemplates.Count 个：系统 @_systemCount · 用户 @_userCount）
        </p>
    </div>

    <div class="ffui-panel table-panel">
        <h2 class="ffui-panel-title">模板列表</h2>

        @if (_isLoading)
        {
            <div class="ffui-loading-row" aria-busy="true">
                <span class="spinner" aria-hidden="true"></span>
                <span>正在加载模板…</span>
            </div>
        }
        else if (_allTemplates.Count == 0)
        {
            <div class="ffui-empty-state">
                <p>数据库里还没有任何模板。可以点「新建」创建一个，或点「导入」导入 JSON。</p>
            </div>
        }
        else if (_visible.Count == 0)
        {
            <div class="ffui-empty-state">
                <p>没有符合当前筛选条件的模板。</p>
                <button type="button" class="ffui-btn" @onclick="ClearFilters">清除筛选</button>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col" aria-sort='@AriaSort("name")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("name")'>
                                    名称 @SortIndicator("name")
                                </button>
                            </th>
                            <th scope="col" aria-sort='@AriaSort("category")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("category")'>
                                    分类 @SortIndicator("category")
                                </button>
                            </th>
                            <th scope="col" aria-sort='@AriaSort("type")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("type")'>
                                    类型 @SortIndicator("type")
                                </button>
                            </th>
                            <th scope="col" aria-sort='@AriaSort("extension")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("extension")'>
                                    输出格式 @SortIndicator("extension")
                                </button>
                            </th>
                            <th scope="col" aria-sort='@AriaSort("encoder")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("encoder")'>
                                    编码器 @SortIndicator("encoder")
                                </button>
                            </th>
                            <th scope="col" aria-sort='@AriaSort("sort")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("sort")'>
                                    排序 @SortIndicator("sort")
                                </button>
                            </th>
                            <th scope="col" aria-sort='@AriaSort("updated")'>
                                <button type="button" class="th-sort" @onclick='() => ToggleSort("updated")'>
                                    更新时间 @SortIndicator("updated")
                                </button>
                            </th>
                            <th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in _visible)
                        {
                            <tr @key="template.Id">
                                <td>
                                    <span class="name-cell">@template.Name</span>
                                    @if (template.IsRecommended)
                                    {
                                        <span class="ffui-badge ffui-badge-primary">推荐</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(template.Category) ? "未分类" : template.Category)</td>
                                <td>
                                    <span class="ffui-badge @(template.Type == TemplateType.System ? "ffui-badge-info" : "ffui-badge-success")">
                                        @(template.Type == TemplateType.System ? "系统" : "用户")
                                    </span>
                                </td>
                                <td class="mono">@(string.IsNullOrWhiteSpace(template.OutputExtension) ? "-" : "." + template.OutputExtension)</td>
                                <td>@EncoderDisplay(template)</td>
                                <td class="num">@template.SortOrder</td>
                                <td class="num">@template.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <div class="cell-actions">
                                        <button type="button" class="ffui-btn ffui-btn-sm"
                                                disabled="@IsBusy" @onclick="() => OpenEditEditor(template)">
                                            ✏️ 编辑
                                        </button>
                                        <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger"
                                                disabled="@IsBusy" @onclick="() => RequestDelete(template)">
                                            🗑️ 删除
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="ffui-panel diag-panel">
        <h2 class="ffui-panel-title">运行诊断</h2>
        <div class="diag-grid">
            <div class="diag-item">
                <span class="diag-key">数据目录</span>
                <span class="diag-value mono">@AppPaths.DataDirectory</span>
                <span class="ffui-badge @(_dataDirWritable ? "ffui-badge-success" : "ffui-badge-danger")">
                    @(_dataDirWritable ? "可写" : "不可写")
                </span>
            </div>

            <div class="diag-item">
                <span class="diag-key">模板数量</span>
                <span class="diag-value">@_allTemplates.Count 个（系统 @_systemCount · 用户 @_userCount）</span>
            </div>

            <div class="diag-item">
                <span class="diag-key">任务队列</span>
                <span class="diag-value">
                    运行中 @TaskService.ActiveCount · 等待中 @TaskService.QueuedCount · 历史记录 @(_status?.TaskCount ?? 0)
                </span>
            </div>

            <div class="diag-item">
                <span class="diag-key">历史清理</span>
                <span class="diag-value">
                    <label class="inline-field">
                        保留最近
                        <input type="number" min="1" max="3650" aria-label="历史保留天数" @bind="_cleanupDays" />
                        天
                    </label>
                    <button type="button" class="ffui-btn ffui-btn-sm" @onclick="CleanupHistoryAsync" disabled="@_isCleaning">
                        @if (_isCleaning)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                        }
                        🧹 清理历史
                    </button>
                </span>
            </div>

            <div class="diag-item">
                <span class="diag-key">FFmpeg</span>
                <span class="diag-value">
                    @if (_status is null)
                    {
                        <span>查询中…</span>
                    }
                    else if (_status.FFmpegAvailable)
                    {
                        <span>@_status.FFmpegVersion</span>
                    }
                    else
                    {
                        <span class="ffui-badge ffui-badge-danger">不可用</span>
                    }
                </span>
                <span class="diag-value mono">@(_status?.FFmpegPath ?? string.Empty)</span>
            </div>

            <div class="diag-item">
                <span class="diag-key">预设版本</span>
                <span class="diag-value">v@(TemplateService.PresetVersion)</span>
            </div>
        </div>
    </div>

    <details class="danger-zone">
        <summary>⚠️ 危险区域</summary>
        <div class="danger-body">
            <div class="danger-item">
                <div class="danger-text">
                    <h3>重置系统预设模板</h3>
                    <p>
                        删除当前数据库里的<strong>全部系统预设模板</strong>，然后按内置预设
                        （v@(TemplateService.PresetVersion)）重新写入。
                        <strong>用户自己创建的模板会保留</strong>，但对系统预设做过的所有手工修改都会丢失。
                    </p>
                </div>
                <button type="button" class="ffui-btn ffui-btn-danger" @onclick="RequestReset" disabled="@IsBusy">
                    🔄 重置系统模板
                </button>
            </div>
        </div>
    </details>
</div>

<TemplateEditor Template="_editorTemplate"
                IsOpen="_editorOpen"
                IsOpenChanged="OnEditorOpenChanged"
                IsSystem="_editorIsSystem"
                OnSaved="OnTemplateSaved" />

<Modal IsOpen="_importOpen" IsOpenChanged="OnImportOpenChanged" Title="导入模板" Size="lg"
       DisableClose="@_isImporting" CloseOnBackdrop="@(!_isImporting)">
    <p class="modal-hint">
        把「导出」得到的 JSON 内容粘贴到下面。浏览器出于安全限制不允许页面直接读取剪贴板，
        请手动粘贴（⌘/Ctrl + V）。
    </p>
    <textarea class="import-json" rows="10" aria-label="模板 JSON 内容"
              placeholder="在此粘贴包含 templates 数组的 JSON"
              @bind="_importJson" @bind:event="oninput"></textarea>

    <label class="switch import-switch">
        <input type="checkbox" @bind="_importAsSystem" />
        导入为系统模板
    </label>
    @if (_importAsSystem)
    {
        <div class="ffui-alert ffui-alert-warning" role="alert">
            <span aria-hidden="true">⚠️</span>
            <span>
                导入为系统模板后，这些模板会被标记成系统预设，并可能在后续的系统预设同步或重置时
                被内置预设覆盖、删除。只在明确知道用途时启用。
            </span>
        </div>
    }

    <div class="ffui-modal-footer">
        <button type="button" class="ffui-btn" disabled="@_isImporting" @onclick="CloseImport">取消</button>
        <button type="button" class="ffui-btn ffui-btn-primary" disabled="@_isImporting" @onclick="ImportAsync">
            @if (_isImporting)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            导入
        </button>
    </div>
</Modal>

<ConfirmDialog IsOpen="_deleteOpen"
               IsOpenChanged="OnDeleteOpenChanged"
               Danger="true"
               Title="@_deleteTitle"
               Message="@_deleteMessage"
               Detail="@_deleteDetail"
               ConfirmText="删除"
               IsBusy="_deleteBusy"
               OnConfirm="ConfirmDeleteAsync" />

<ConfirmDialog IsOpen="_resetOpen"
               IsOpenChanged="OnResetOpenChanged"
               Danger="true"
               Title="重置系统预设模板"
               Message="确定要删除所有系统预设模板并重新写入内置预设吗？"
               Detail="用户自己创建的模板会被保留；对系统预设模板做过的所有手工修改都会丢失，且无法撤销。"
               ConfirmText="确认重置"
               IsBusy="_resetBusy"
               OnConfirm="ConfirmResetAsync" />

<style>
    .page-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--spacing-3);
        margin-bottom: var(--spacing-4);
    }

    .page-head h1 {
        margin: 0;
    }

    .page-sub {
        margin: 0.25rem 0 0;
