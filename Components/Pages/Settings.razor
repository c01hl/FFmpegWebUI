            Toast.Success($"已清空 {removed} 条历史记录");
        }
        catch (Exception ex)
        {
            Toast.Error($"清空历史失败：{ex.Message}");
        }
        finally
        {
            _isClearingHistory = false;
        }

        await RefreshAsync();
    }

