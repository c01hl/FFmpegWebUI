@code {
    /// <summary>
    /// 可编辑的设置副本。用 record 是为了直接拿到「值相等」，
    /// 从而在不改动服务里那份 AppSettings 实例的前提下判断是否有未保存的更改。
    /// Id 不用复制：SaveSettingsAsync 会沿用数据库里已有记录的 Id。
    /// </summary>
    private sealed record SettingsForm
    {
        public string FFmpegPath { get; set; } = string.Empty;
        public string FFprobePath { get; set; } = string.Empty;
        public string DefaultOutputDirectory { get; set; } = string.Empty;
        public OutputNamingRule OutputNaming { get; set; } = OutputNamingRule.Suffix;
        public string OutputSuffix { get; set; } = "_converted";
        public FileExistsAction ExistingFileAction { get; set; } = FileExistsAction.Ask;
        public bool PreferHardwareAcceleration { get; set; } = true;
        public bool PreferHardwareDecoding { get; set; }
        public string PreferredHardwareEncoder { get; set; } = string.Empty;
        public bool AutoFallbackToSoftware { get; set; } = true;
        public int MaxConcurrentTasks { get; set; } = 1;
        public int MaxLogLines { get; set; } = 500;
        public int TaskHistoryRetentionDays { get; set; } = 30;
        public string Theme { get; set; } = "System";
        public string GlobalFFmpegArguments { get; set; } = string.Empty;
        public bool NotifyOnCompletion { get; set; } = true;
        public int ListenPort { get; set; } = 5265;

        public static SettingsForm From(AppSettings settings) => new()
        {
            FFmpegPath = settings.FFmpegPath ?? string.Empty,
            FFprobePath = settings.FFprobePath ?? string.Empty,
            DefaultOutputDirectory = settings.DefaultOutputDirectory ?? string.Empty,
            OutputNaming = settings.OutputNaming,
            OutputSuffix = settings.OutputSuffix ?? string.Empty,
            ExistingFileAction = settings.FileExistsAction,
            PreferHardwareAcceleration = settings.PreferHardwareAcceleration,
            PreferHardwareDecoding = settings.PreferHardwareDecoding,
            PreferredHardwareEncoder = settings.PreferredHardwareEncoder ?? string.Empty,
            AutoFallbackToSoftware = settings.AutoFallbackToSoftware,
            MaxConcurrentTasks = settings.MaxConcurrentTasks,
            MaxLogLines = settings.MaxLogLines,
            TaskHistoryRetentionDays = settings.TaskHistoryRetentionDays,
            Theme = settings.Theme ?? "System",
            GlobalFFmpegArguments = settings.GlobalFFmpegArguments ?? string.Empty,
            NotifyOnCompletion = settings.NotifyOnCompletion,
            ListenPort = settings.ListenPort
        };

        public AppSettings ToAppSettings() => new()
        {
            FFmpegPath = FFmpegPath ?? string.Empty,
            FFprobePath = FFprobePath ?? string.Empty,
            DefaultOutputDirectory = DefaultOutputDirectory ?? string.Empty,
            OutputNaming = OutputNaming,
            OutputSuffix = OutputSuffix ?? string.Empty,
            FileExistsAction = ExistingFileAction,
            PreferHardwareAcceleration = PreferHardwareAcceleration,
            PreferHardwareDecoding = PreferHardwareDecoding,
            PreferredHardwareEncoder = PreferredHardwareEncoder ?? string.Empty,
            AutoFallbackToSoftware = AutoFallbackToSoftware,
            MaxConcurrentTasks = MaxConcurrentTasks,
            MaxLogLines = MaxLogLines,
            TaskHistoryRetentionDays = TaskHistoryRetentionDays,
            Theme = Theme,
            GlobalFFmpegArguments = GlobalFFmpegArguments ?? string.Empty,
            NotifyOnCompletion = NotifyOnCompletion,
            ListenPort = ListenPort
        };
    }

    /// <summary>路径测试结果</summary>
    private sealed record PathTestResult(bool Success, string Message);

    /// <summary>按厂商分组的编码器，供界面渲染</summary>
    private sealed record EncoderGroupView(string Key, string Label, List<HardwareEncoder> Encoders, int AvailableCount);

    private static readonly char[] InvalidFileNameChars = Path.GetInvalidFileNameChars();

    /// <summary>首选编码器下拉框中两个固定选项的 @key（@key 的值必须是唯一的）</summary>
    private const string AutoEncoderOptionKey = "auto-encoder-option";
    private const string SavedEncoderOptionKey = "saved-encoder-option";

    private SettingsForm _form = new();
    private SettingsForm _original = new();

    private AppStatus? _status;
    private HardwareDetectionReport? _report;
    private bool _dataDirectoryWritable;

    private bool _isReady;
    private bool _loadFailed;
    private bool _isChecking;
    private bool _isScanning;
    private TimeSpan _scanElapsed;
    private bool _isSaving;
    private bool _isResetting;
    private bool _isCleaningHistory;
    private bool _isClearingHistory;
    private bool _isTestingFFmpeg;
    private bool _isTestingFFprobe;

    private PathTestResult? _ffmpegTest;
    private PathTestResult? _ffprobeTest;

    /// <summary>上次测试时使用的路径；输入框被改动后结果即视为过期，不再显示</summary>
    private string _ffmpegTestPath = string.Empty;
    private string _ffprobeTestPath = string.Empty;

    private string? _historyMessage;

    private bool _resetConfirmOpen;
    private bool _clearConfirmOpen;

    private string _checkedDirectory = string.Empty;
    private string? _directoryError;

    /// <summary>电路断开后只提示一次，避免刷屏</summary>
    private bool _renderFailed;

    private bool _disposed;

    /// <summary>设置变更后是否需要强制重新检测环境（仅路径可能变化时需要）</summary>
    private bool _forceStatusRefresh;

    // ── 生命周期 ────────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        SettingsService.SettingsChanged += OnSettingsChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 预渲染阶段不会走到这里，所以这两次较慢的检测只会在真实的交互式连接上执行一次
        await LoadStatusAsync(forceRefresh: false, notify: false);
        await LoadHardwareAsync(forceRefresh: false);
    }

    public void Dispose()
    {
        _disposed = true;
        SettingsService.SettingsChanged -= OnSettingsChanged;
    }

    private void OnSettingsChanged(object? sender, EventArgs e)
    {
        // 事件可能由其它页面的线程触发，必须回到本组件的渲染上下文再更新界面；
        // 组件已释放时直接退出，避免把异常抛回给触发方（SaveSettingsAsync）。
        if (_disposed) return;

        // 路径可能变了才强制重新探测（强制刷新会真实试跑硬件编码器，耗时几秒）；
        // 改主题之类的设置用 10 秒缓存刷新即可，避免每次保存都扫一遍编码器。
        _forceStatusRefresh = PathsMayHaveChanged();
        _ = InvokeAsync(RefreshStatusAfterSettingsChangeAsync);
    }

    private async Task RefreshStatusAfterSettingsChangeAsync()
    {
        await LoadStatusAsync(forceRefresh: _forceStatusRefresh, notify: false);
    }

    /// <summary>当前设置的 FFmpeg/ffprobe 路径是否与已解析到的不同（不同就需要强制重扫）</summary>
    private bool PathsMayHaveChanged()
    {
        if (_status is null) return true;

        var typedFFmpeg = NormalizePathText(_form.FFmpegPath);
        var typedProbe = NormalizePathText(_form.FFprobePath);

        // 两个都留空：正常情况下就是「自动探测」，不需要强制重扫；
        // 但如果之前是用设置里的路径解析的，说明用户刚把路径清空，需要重新探测。
        if (typedFFmpeg.Length == 0 && typedProbe.Length == 0) return !_status.AutoDetected;

        return !string.Equals(typedFFmpeg, NormalizePathText(_status.FFmpegPath), StringComparison.Ordinal)
            || !string.Equals(typedProbe, NormalizePathText(_status.FFprobePath), StringComparison.Ordinal);
    }

    // ── 加载 ────────────────────────────────────────────────────────────

    private async Task LoadSettingsAsync()
    {
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            _original = SettingsForm.From(settings);
            _form = SettingsForm.From(settings);
            _loadFailed = false;
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            Toast.Error($"读取设置失败：{ex.Message}");
        }
        finally
        {
            _isReady = true;
        }
    }

    private async Task RetryLoadAsync()
    {
        await LoadSettingsAsync();
        if (!_loadFailed) Toast.Success("设置已重新读取");
    }

    private async Task LoadStatusAsync(bool forceRefresh, bool notify)
    {
        _isChecking = true;
        try
        {
            var status = await AppStatusService.GetStatusAsync(forceRefresh);
            _status = status;
            _dataDirectoryWritable = AppStatusService.IsDataDirectoryWritable;

            // 强制刷新时 AppStatusService 已经重新检测过硬件，这里同步取用它的结果，避免重复扫描
            if (HardwareDetection.LastReport is { } latest) _report = latest;

            if (notify) Toast.Success("环境信息已重新检测");
        }
        catch (Exception ex)
        {
            Toast.Error($"环境检测失败：{ex.Message}");
        }
        finally
        {
            _isChecking = false;
        }

        await RefreshAsync();
    }

    private async Task RecheckAsync()
    {
        await LoadStatusAsync(forceRefresh: true, notify: true);
    }

    private async Task LoadHardwareAsync(bool forceRefresh)
    {
        _isScanning = true;
        _scanElapsed = TimeSpan.Zero;
        var watch = Stopwatch.StartNew();

        try
        {
            var scan = HardwareDetection.DetectAsync(forceRefresh);

            // 用户主动扫描可能持续十几秒，这里每 0.4 秒刷新一次已用时长，让等待有反馈
            while (!scan.IsCompleted)
            {
                await Task.WhenAny(scan, Task.Delay(400));
                _scanElapsed = watch.Elapsed;
                await RefreshAsync();
            }

            var report = await scan;
            _report = report;
            _scanElapsed = watch.Elapsed;

            if (forceRefresh)
            {
                var seconds = _scanElapsed.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture);
                Toast.Success($"硬件检测完成：{report.AvailableHardwareEncoders.Count} 个可用硬件编码器（耗时 {seconds} 秒）");

                if (report.AvailableHardwareEncoders.Count == 0)
                {
                    Toast.Warning("本机没有检测到可用的硬件编码器，转换会使用 CPU 软件编码。");
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"硬件编码器检测失败：{ex.Message}");
        }
        finally
        {
            watch.Stop();
            _isScanning = false;
        }

        await RefreshAsync();
    }

    private async Task ScanHardwareAsync()
    {
        await LoadHardwareAsync(forceRefresh: true);
    }

    // ── 校验 ────────────────────────────────────────────────────────────

    private bool HasChanges => _form != _original;

    private bool HasAvailableHardware => AvailableEncoders.Count > 0;

    private List<HardwareEncoder> AvailableEncoders =>
        _report is null
            ? new List<HardwareEncoder>()
            : _report.AvailableHardwareEncoders
                .OrderBy(e => FamilyOrder(e.Family))
                .ThenBy(e => e.DisplayName, StringComparer.CurrentCulture)
                .ToList();

    private bool PreferredEncoderUnavailable =>
        !string.IsNullOrWhiteSpace(_form.PreferredHardwareEncoder) &&
        !AvailableEncoders.Any(e => string.Equals(e.Name, _form.PreferredHardwareEncoder, StringComparison.OrdinalIgnoreCase));

    private string? DirectoryWritabilityError =>
        string.Equals((_form.DefaultOutputDirectory ?? string.Empty).Trim(), _checkedDirectory, StringComparison.Ordinal)
            ? _directoryError
            : null;

    private string? SuffixInvalidChars
    {
        get
        {
            var suffix = _form.OutputSuffix ?? string.Empty;
            if (suffix.Length == 0) return null;
            var index = suffix.IndexOfAny(InvalidFileNameChars);
            if (index < 0) return null;
            var invalid = suffix[index];
            return invalid == '\0' ? "（空字符）" : invalid.ToString();
        }
    }

    private List<string> ValidationErrors
    {
        get
        {
            var errors = new List<string>();

            if (_form.OutputNaming == OutputNamingRule.Suffix && string.IsNullOrWhiteSpace(_form.OutputSuffix))
                errors.Add("输出文件后缀：选择「添加后缀」时不能为空。");
            else if (SuffixInvalidChars is { } bad)
                errors.Add($"输出文件后缀：包含文件名不允许的字符「{bad}」。");

            if (_form.MaxConcurrentTasks is < 1 or > 8)
                errors.Add("同时执行的转换任务数：必须在 1 ~ 8 之间。");
            if (_form.MaxLogLines is < 50 or > 20000)
                errors.Add("单个任务保留的日志行数：必须在 50 ~ 20000 之间。");
            if (_form.TaskHistoryRetentionDays is < 0 or > 3650)
                errors.Add("任务历史保留天数：必须在 0 ~ 3650 之间。");
            if (_form.ListenPort is < 0 or > 65535)
                errors.Add("监听端口：必须在 0 ~ 65535 之间（0 表示自动选择空闲端口）。");
            if (_form.Theme is not ("System" or "Light" or "Dark"))
                errors.Add("主题：取值无效，请重新选择。");

            if (DirectoryWritabilityError is { } directoryError)
                errors.Add($"默认输出目录：{directoryError}");

            return errors;
        }
    }

    private bool CanSave => _isReady && !_loadFailed && !_isSaving && ValidationErrors.Count == 0;

    // ── 保存 / 恢复默认 ─────────────────────────────────────────────────

    private async Task SaveAsync()
    {
        if (!CanSave) return;

        _isSaving = true;
        try
        {
            var toSave = _form.ToAppSettings();

            // 目录可写性放在保存时检查：IsDirectoryWritable 会尝试创建目录并写测试文件，
            // 不适合在每次输入时调用。
            var directory = (toSave.DefaultOutputDirectory ?? string.Empty).Trim();
            if (directory.Length > 0 && !FileService.IsDirectoryWritable(directory))
            {
                _checkedDirectory = directory;
                _directoryError = $"不可写或无法创建：{directory}。请换一个目录，或先创建它并授予写权限。";
                Toast.Error("默认输出目录不可写，设置未保存。");
                return;
            }
            _checkedDirectory = directory;
            _directoryError = null;

            await SettingsService.SaveSettingsAsync(toSave);

            // SaveSettingsAsync 会调用 Normalize()，可能修正取值（例如空后缀）。
            // 以保存后的实际设置为准重新同步，避免界面与实际不一致。
            var saved = await SettingsService.GetSettingsAsync();
            _original = SettingsForm.From(saved);
            _form = SettingsForm.From(saved);

            Toast.Success("设置已保存");
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败：{ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }

        await RefreshAsync();
    }

