    private string SuffixPreview
    {
        get
        {
            const string sample = "video.mp4";
            if (_form.OutputNaming == OutputNamingRule.Original)
                return $"{sample} → {sample}（保持原名）";

            var suffix = _form.OutputSuffix ?? string.Empty;
            return $"{sample} → video{suffix}.mp4";
        }
    }

    private IReadOnlyList<EncoderGroupView> EncoderGroups
    {
        get
        {
            if (_report is null) return Array.Empty<EncoderGroupView>();

            return _report.Encoders
                .GroupBy(e => string.IsNullOrWhiteSpace(e.Family) ? "other" : e.Family.ToLowerInvariant())
                .Select(group => new EncoderGroupView(
                    group.Key,
                    group.Key == "other" ? "其他编码器" : EncoderCatalog.FamilyDisplayName(group.Key),
                    group.OrderByDescending(e => e.IsAvailable).ThenBy(e => e.DisplayName, StringComparer.CurrentCulture).ToList(),
                    group.Count(e => e.IsAvailable)))
                .OrderByDescending(group => group.AvailableCount > 0)
                .ThenBy(group => FamilyOrder(group.Key))
                .ThenBy(group => group.Label, StringComparer.CurrentCulture)
                .ToList();
        }
    }

    private static int FamilyOrder(string? family) => (family ?? string.Empty).ToLowerInvariant() switch
    {
        "nvenc" => 0,
        "qsv" => 1,
        "amf" => 2,
        "videotoolbox" => 3,
        "vaapi" => 4,
        "vulkan" => 5,
        "mf" => 6,
        "software" => 7,
        _ => 8
    };

    private void ClearPreferredEncoder() => _form.PreferredHardwareEncoder = string.Empty;

    private static string FormatLocalTime(DateTime value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);

    /// <summary>请求一次渲染；页面已关闭（电路断开）时只提示一次，不再抛出</summary>
    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (_renderFailed) return;
            _renderFailed = true;
            Toast.Warning($"界面刷新失败（页面可能已关闭）：{ex.Message}");
        }
    }
