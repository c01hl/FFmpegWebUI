@page "/settings"
@using System.Diagnostics
@using FFmpegWebUI.Models
@using FFmpegWebUI.Services
@using FFmpegWebUI.Components.Shared
@implements IDisposable
@inject ISettingsService SettingsService
@inject IAppStatusService AppStatusService
@inject IHardwareDetectionService HardwareDetection
@inject IFileService FileService
@inject ITaskService TaskService
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>设置 - FFmpeg Web UI</PageTitle>

<div class="ffui-container settings-page">
    <h1>⚙️ 设置</h1>
    <p class="page-intro">
        所有设置都保存在本机数据目录的数据库里，不会上传；修改后需要点击页面底部的「保存设置」才会写入。
    </p>

    @if (!_isReady)
    {
        <div class="ffui-loading-row"><span class="spinner" aria-hidden="true"></span> 正在读取设置…</div>
    }
    else
    {
        @* ── 1 · 环境信息（只读诊断）───────────────────────────────────── *@
        <section class="ffui-panel">
            <h2 class="ffui-panel-title panel-head">
                🩺 环境信息
                @if (_isChecking)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
            </h2>

            <div class="toolbar">
                <button type="button" class="ffui-btn" @onclick="RecheckAsync" disabled="@_isChecking">
                    @if (_isChecking)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    @(_isChecking ? "检测中…" : "重新检测")
                </button>
                <span class="field-help">重新读取 FFmpeg、ffprobe、硬件解码能力与数据目录状态（可能需要几秒）。</span>
            </div>

            @if (_status is null)
            {
                <div class="ffui-loading-row"><span class="spinner" aria-hidden="true"></span> 正在检测环境…</div>
            }
            else
            {
                <div class="kv-grid">
                    <span class="kv-key">应用版本</span>
                    <span class="kv-value">v@(_status.AppVersion)</span>

                    <span class="kv-key">平台</span>
                    <span class="kv-value">@_status.Platform</span>

                    <span class="kv-key">.NET 版本</span>
                    <span class="kv-value">@_status.Runtime</span>

                    <span class="kv-key">数据目录</span>
                    <span class="kv-value">
                        <span class="code-path">@_status.DataDirectory</span>
                        @if (_dataDirectoryWritable)
                        {
                            <span class="ffui-badge ffui-badge-success">可写</span>
                        }
                        else
                        {
                            <span class="ffui-badge ffui-badge-danger">不可写</span>
                        }
                        @if (!_dataDirectoryWritable)
                        {
                            <span class="muted">设置与任务历史可能无法保存，请检查目录权限（可用环境变量 FFMPEGWEBUI_DATA_DIR 换一个位置）。</span>
                        }
                    </span>

                    <span class="kv-key">FFmpeg</span>
                    <span class="kv-value">
                        @if (_status.FFmpegAvailable)
                        {
                            <span class="ffui-badge ffui-badge-success">可用</span>
                            <span>@_status.FFmpegVersion</span>
                        }
                        else
                        {
                            <span class="ffui-badge ffui-badge-danger">未找到</span>
                            <span class="muted">转换功能不可用，请先安装 FFmpeg（见下方指引）。</span>
                        }
                    </span>

                    <span class="kv-key">FFmpeg 路径</span>
                    <span class="kv-value">
                        <span class="code-path">@ResolvedFFmpegPath</span>
                        <span class="ffui-badge @(_status.AutoDetected ? "" : "ffui-badge-info")">
                            @(_status.AutoDetected ? "自动探测" : "来自设置")
                        </span>
                    </span>

                    <span class="kv-key">ffprobe 路径</span>
                    <span class="kv-value">
                        <span class="code-path">@ResolvedFFprobePath</span>
                        @if (!_status.FFmpegAvailable)
                        {
                            <span class="muted">FFmpeg 不可用时无法确认是否真的存在。</span>
                        }
                    </span>

                    <span class="kv-key">硬件解码方式</span>
                    <span class="kv-value">
                        @if (_status.Hwaccels.Count == 0)
                        {
                            <span class="muted">当前 FFmpeg 未报告可用的硬件解码方式。</span>
                        }
                        else
                        {
                            @foreach (var hwaccel in _status.Hwaccels)
                            {
                                <span class="ffui-badge ffui-badge-info" @key="hwaccel">@hwaccel</span>
                            }
                        }
                    </span>
                </div>

                @if (_status.Notices.Count == 0)
                {
                    <div class="notices">
                        <div class="ffui-alert ffui-alert-success" role="status">
                            <span aria-hidden="true">✅</span>
                            <span>一切正常：FFmpeg 可用，未发现需要注意的问题。</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="notices">
                        @for (var i = 0; i < _status.Notices.Count; i++)
                        {
                            <div class="ffui-alert @(_status.FFmpegAvailable ? "ffui-alert-warning" : "ffui-alert-danger")"
                                 role="status" @key="i">
                                <span aria-hidden="true">@(_status.FFmpegAvailable ? "⚠️" : "⛔")</span>
                                <span>@_status.Notices[i]</span>
                            </div>
                        }
                    </div>
                }

                @if (!_status.FFmpegAvailable)
                {
                    <div class="ffui-alert ffui-alert-warning install-guide" role="status">
                        <div>
                            <strong>安装 FFmpeg（@_status.Platform）</strong>
                            @if (IsWindows)
                            {
                                <ol>
                                    <li>下载 FFmpeg 完整构建包（如 gyan.dev 或 BtbN 的 release），解压到 <span class="code-path">C:\ffmpeg</span>。</li>
                                    <li>把 <span class="code-path">C:\ffmpeg\bin</span> 加入系统 PATH，或直接在下面的「FFmpeg 可执行文件」里填写 <span class="code-path">ffmpeg.exe</span> 的完整路径。</li>
                                    <li>也可以用包管理器：<span class="code-path">winget install Gyan.FFmpeg</span> / <span class="code-path">choco install ffmpeg</span> / <span class="code-path">scoop install ffmpeg</span>。</li>
                                    <li>改完 PATH 需要重启本应用，再点上面的「重新检测」。</li>
                                </ol>
                            }
                            else if (IsMacOS)
                            {
                                <ol>
                                    <li>推荐 Homebrew：<span class="code-path">brew install ffmpeg</span>（会自动带上 ffprobe）。</li>
                                    <li>Apple 芯片装到 <span class="code-path">/opt/homebrew/bin</span>，Intel 机器装到 <span class="code-path">/usr/local/bin</span>。</li>
                                    <li>装完点上面的「重新检测」；若仍未找到，可在下面直接指定完整路径。</li>
                                </ol>
                            }
                            else
                            {
                                <ol>
                                    <li>Debian/Ubuntu：<span class="code-path">sudo apt install ffmpeg</span></li>
                                    <li>Fedora/RHEL：<span class="code-path">sudo dnf install ffmpeg</span></li>
                                    <li>Arch：<span class="code-path">sudo pacman -S ffmpeg</span></li>
                                    <li>装完点上面的「重新检测」；若用 Docker，请确认容器镜像里也装了 FFmpeg。</li>
                                </ol>
                            }

                            <div class="install-paths">
                                <span>会按顺序在这些位置查找：</span>
                                <ul>
                                    <li>设置里填写的路径（优先）</li>
                                    <li>应用所在目录下的内置副本：<span class="code-path">ffmpeg@(ExeSuffix)</span>、<span class="code-path">ffmpeg/ffmpeg@(ExeSuffix)</span>、<span class="code-path">tools/ffmpeg/ffmpeg@(ExeSuffix)</span></li>
                                    @if (IsWindows)
                                    {
                                        <li>系统 PATH</li>
                                        <li><span class="code-path">C:\ffmpeg\bin\ffmpeg.exe</span>、<span class="code-path">C:\ProgramData\chocolatey\bin\ffmpeg.exe</span></li>
                                        <li><span class="code-path">%LOCALAPPDATA%\Microsoft\WinGet\Links\ffmpeg.exe</span>、<span class="code-path">%USERPROFILE%\scoop\shims\ffmpeg.exe</span></li>
                                    }
                                    else if (IsMacOS)
                                    {
                                        <li>系统 PATH</li>
                                        <li><span class="code-path">/opt/homebrew/bin/ffmpeg</span>（Apple 芯片 Homebrew）</li>
                                        <li><span class="code-path">/usr/local/bin/ffmpeg</span>、<span class="code-path">/opt/local/bin/ffmpeg</span>（Intel Homebrew / MacPorts）</li>
                                    }
                                    else
                                    {
                                        <li>系统 PATH</li>
                                        <li><span class="code-path">/usr/bin/ffmpeg</span>、<span class="code-path">/usr/local/bin/ffmpeg</span></li>
                                        <li><span class="code-path">/usr/lib/jellyfin-ffmpeg/ffmpeg</span>（对 QSV/VAAPI 支持更完整）</li>
                                        <li><span class="code-path">/snap/bin/ffmpeg</span>、<span class="code-path">/var/lib/flatpak/exports/bin/ffmpeg</span></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            }
        </section>

        @* ── 2 · 硬件加速能力 ──────────────────────────────────────────── *@
        <section class="ffui-panel">
            <h2 class="ffui-panel-title panel-head">
                🚀 硬件加速能力
                @if (_report is not null && !_isScanning)
                {
                    <span class="ffui-badge @(_report.HasHardwareAcceleration ? "ffui-badge-success" : "ffui-badge-warning")">
                        @_report.AvailableHardwareEncoders.Count 个可用硬件编码器
                    </span>
                }
            </h2>

            <div class="toolbar">
                <button type="button" class="ffui-btn ffui-btn-primary" @onclick="ScanHardwareAsync" disabled="@_isScanning">
                    @if (_isScanning)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    @(_isScanning ? "检测中…" : "重新检测硬件编码器")
                </button>
                @if (_isScanning)
                {
                    <span class="muted">
                        已用时 @ElapsedSeconds 秒，请勿刷新页面…
                    </span>
                }
                else if (_report is not null)
                {
                    <span class="muted">上次检测：@FormatLocalTime(_report.DetectedAt)</span>
                }
            </div>
            <span class="field-help">
                检测会逐个真实试跑本机的硬件编码器（每个约 1~3 秒），通常需要几秒到十几秒，期间可以继续操作其它设置。
            </span>

            @if (_report is null)
            {
                <div class="ffui-loading-row"><span class="spinner" aria-hidden="true"></span> 正在读取硬件编码器列表…</div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(_report.Summary))
                {
                    <div class="ffui-alert ffui-alert-info report-summary" role="status">
                        <span aria-hidden="true">ℹ️</span>
                        <span>
                            @_report.Summary
                            <br />
                            <span class="muted">
                                检测时间 @FormatLocalTime(_report.DetectedAt)
                                @if (!string.IsNullOrEmpty(_report.FFmpegVersion))
                                {
                                    @:· FFmpeg @_report.FFmpegVersion
                                }
                            </span>
                        </span>
                    </div>
                }

                <div class="field">
                    <label for="preferred-encoder">首选硬件编码器</label>
                    <select id="preferred-encoder"
                            @bind="_form.PreferredHardwareEncoder"
                            disabled="@(!HasAvailableHardware)">
                        <option value="" @key="AutoEncoderOptionKey">自动（按编码格式选择，推荐）</option>
                        @foreach (var encoder in AvailableEncoders)
                        {
                            <option value="@encoder.Name" @key="encoder.Name">
                                @encoder.DisplayName（@encoder.Name）
                            </option>
                        }
                        @if (PreferredEncoderUnavailable)
                        {
                            <option value="@_form.PreferredHardwareEncoder" @key="SavedEncoderOptionKey">
                                @_form.PreferredHardwareEncoder（当前不可用）
                            </option>
                        }
                    </select>
                    <span class="field-help">
                        @if (HasAvailableHardware)
                        {
                            <span>只影响「优先使用硬件编码」的模板；留空时由应用按 h264/hevc/av1 等编码格式自动挑选。</span>
                        }
                        else
                        {
                            <span>本机没有可用的硬件编码器（或检测尚未完成），因此暂不能指定。转换会使用 CPU 软件编码。</span>
                        }
                    </span>

                    @if (PreferredEncoderUnavailable)
                    {
                        <span class="field-error" role="alert">
                            ⚠ 已保存的首选编码器「@_form.PreferredHardwareEncoder」当前不可用（可能驱动未安装或 FFmpeg 未编译该编码器）。
                        </span>
                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="ClearPreferredEncoder">改为「自动」</button>
                    }
                </div>

            }

            @* 下面三项是设置本身，与硬件检测是否完成无关，因此始终显示。 *@
            <h3 class="ffui-section-title">硬件加速开关</h3>
            <div class="check-field">
                <input id="prefer-hardware" type="checkbox" @bind="_form.PreferHardwareAcceleration" />
                <div>
                    <label for="prefer-hardware">优先使用硬件编码（GPU 编码）</label>
                    <span class="field-help">
                        模板没有指定编码器时，自动选择本机可用的硬件编码器（NVENC / QSV / AMF / VideoToolbox / VA-API 等），速度更快、CPU 占用更低。
                    </span>
                </div>
            </div>

            <div class="check-field">
                <input id="prefer-hwdecode" type="checkbox" @bind="_form.PreferHardwareDecoding" />
                <div>
                    <label for="prefer-hwdecode">优先使用硬件解码（输入侧）</label>
                    <span class="field-help">
                        硬件解码可以减轻 CPU 负担，但个别老驱动可能不稳定；如果转换出现花屏、卡住或崩溃，请关闭此项。
                    </span>
                </div>
            </div>

            <div class="check-field">
                <input id="auto-fallback" type="checkbox" @bind="_form.AutoFallbackToSoftware" />
                <div>
                    <label for="auto-fallback">硬件编码失败时自动改用软件编码重试</label>
                    <span class="field-help">
                        硬件编码失败时自动改用软件编码重试，避免任务直接失败。只有在 FFmpeg 还没有写出有效数据时才会回退，因此不会产出损坏的文件。
                    </span>
                </div>
            </div>


        @if (_report is not null)
        {
            @if (!HasAvailableHardware && _report.Encoders.Count > 0)
            {
                <div class="ffui-alert ffui-alert-warning" role="status">
                    <span aria-hidden="true">⚠️</span>
                    <span>未检测到可用的硬件编码器，转换会使用 CPU 软件编码（较慢但兼容性最好）。</span>
                </div>
            }

            <div class="encoder-groups">
                @foreach (var group in EncoderGroups)
                {
                    <div class="encoder-group" @key="group.Key">
                        <h3 class="encoder-group-title">
                            @group.Label
                            <span class="ffui-badge @(group.AvailableCount > 0 ? "ffui-badge-success" : "")">
                                @group.AvailableCount / @group.Encoders.Count 可用
                            </span>
                        </h3>
                        <div class="encoder-grid">
                            @foreach (var encoder in group.Encoders)
                            {
                                <EncoderCard Encoder="encoder" @key="encoder.Name" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
        </section>

        @* ── 3 · 路径设置 ─────────────────────────────────────────────── *@
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">📁 FFmpeg 路径</h2>

            <FileSelector Label="FFmpeg 可执行文件"
                          @bind-Value="_form.FFmpegPath"
                          Placeholder="留空则自动探测（系统 PATH / 常见安装位置 / 内置副本）"
                          ValidateExists="false"
                          ShowFileInfo="true" />

            <div class="resolved-row">
                <span class="resolved-label">当前实际使用：</span>
                <span class="code-path">@ResolvedFFmpegPath</span>
                <span class="muted">（保存或「重新检测」后更新）</span>
            </div>

            <div class="toolbar">
                <button type="button" class="ffui-btn" @onclick="TestFFmpegAsync" disabled="@_isTestingFFmpeg">
                    @if (_isTestingFFmpeg)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    @(_isTestingFFmpeg ? "测试中…" : "测试 FFmpeg")
                </button>
                @if (FFmpegTestShown is { } ffmpegTest)
                {
                    <span class="test-result @(ffmpegTest.Success ? "ok" : "bad")" role="status">@ffmpegTest.Message</span>
                }
            </div>
            <span class="field-help">
                示例：<span class="code-path">C:\ffmpeg\bin\ffmpeg.exe</span> 或 <span class="code-path">/opt/homebrew/bin/ffmpeg</span>。
                留空时会测试系统 PATH 中的 ffmpeg。
            </span>

            <div class="field-divider"></div>

            <FileSelector Label="ffprobe 可执行文件"
                          @bind-Value="_form.FFprobePath"
                          Placeholder="留空则自动探测（通常与 ffmpeg 同目录）"
                          ValidateExists="false"
                          ShowFileInfo="true" />

            <div class="resolved-row">
                <span class="resolved-label">当前实际使用：</span>
                <span class="code-path">@ResolvedFFprobePath</span>
                <span class="muted">（保存或「重新检测」后更新）</span>
            </div>

            <div class="toolbar">
                <button type="button" class="ffui-btn" @onclick="TestFFprobeAsync" disabled="@_isTestingFFprobe">
                    @if (_isTestingFFprobe)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    @(_isTestingFFprobe ? "检查中…" : "测试 ffprobe")
                </button>
                @if (FFprobeTestShown is { } ffprobeTest)
                {
                    <span class="test-result @(ffprobeTest.Success ? "ok" : "bad")" role="status">@ffprobeTest.Message</span>
                }
            </div>
            <span class="field-help">
                读取输入文件的时长、分辨率等媒体信息需要 ffprobe（用 ffmpeg 本身无法可靠地拿到）。
                这里只能检查「文件是否存在且可读 / 是否在 PATH 中」，不会真的执行 ffprobe —— 如需确认真实可用，请用上面的「测试 FFmpeg」确认版本信息能正常解析。
            </span>
        </section>

        @* ── 4 · 输出设置 ─────────────────────────────────────────────── *@
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">📂 输出设置</h2>

            <FileSelector Label="默认输出目录"
                          @bind-Value="_form.DefaultOutputDirectory"
                          Placeholder="例如 /Users/you/Videos 或 D:\Output"
                          IsDirectory="true"
                          ValidateExists="false" />
            <span class="field-help">
                新建转换/批量任务时预填的输出目录；留空时转换页面会要求你手动选择。
                保存时会检查这个目录能否创建并写入，不可写则拒绝保存。
            </span>
            @if (DirectoryWritabilityError is not null)
            {
                <span class="field-error" role="alert">✗ @DirectoryWritabilityError</span>
            }

            <div class="field">
                <label for="output-naming">输出文件命名规则</label>
                <select id="output-naming" @bind="_form.OutputNaming">
                    <option value="@OutputNamingRule.Original">保持原名</option>
                    <option value="@OutputNamingRule.Suffix">添加后缀</option>
                </select>
                <span class="field-help">示例：@SuffixPreview</span>
            </div>

            @if (_form.OutputNaming == OutputNamingRule.Suffix)
            {
                <div class="field">
                    <label for="output-suffix">输出文件后缀</label>
                    <input id="output-suffix" type="text" @bind="_form.OutputSuffix" @bind:event="oninput"
                           placeholder="_converted" />
                    <span class="field-help">
                        常用值：<span class="code-path">_converted</span>、<span class="code-path">_out</span>、<span class="code-path">-1080p</span>。
                        预览：@SuffixPreview
                    </span>
                    @if (string.IsNullOrWhiteSpace(_form.OutputSuffix))
                    {
                        <span class="field-error" role="alert">✗ 选择「添加后缀」时后缀不能为空，否则输出文件会与原文件同名。</span>
                    }
                    else if (SuffixInvalidChars is not null)
                    {
                        <span class="field-error" role="alert">
                            ✗ 后缀包含文件名不允许的字符：@SuffixInvalidChars（不能包含 / \ : * ? &quot; &lt; &gt; | 等）
                        </span>
                    }
                </div>
            }

            <div class="field">
                <label for="exists-action">文件已存在时的处理方式</label>
                <select id="exists-action" @bind="_form.ExistingFileAction">
                    <option value="@FileExistsAction.Ask">询问用户</option>
                    <option value="@FileExistsAction.Overwrite">覆盖</option>
                    <option value="@FileExistsAction.Skip">跳过</option>
                    <option value="@FileExistsAction.Rename">重命名</option>
                </select>
                <span class="field-help">@FileExistsActionHelp</span>
            </div>
        </section>

        @* ── 5 · 性能与数据 ───────────────────────────────────────────── *@
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">⚡ 性能与数据</h2>

            <div class="field">
                <label for="max-concurrent">同时执行的转换任务数</label>
                <select id="max-concurrent" @bind="_form.MaxConcurrentTasks">
                    @for (var i = 1; i <= 8; i++)
                    {
                        <option value="@i" @key="i">@i</option>
                    }
                </select>
                <span class="field-help">
                    默认 1（串行）。大于 1 会同时跑多个 FFmpeg 进程：显卡/CPU 的编码器通常无法真正并行，
                    多个任务容易互相抢占资源，反而每个都变慢；只有在批量处理大量小文件时可能略快。
                </span>
            </div>

            <div class="field">
                <label for="max-log-lines">单个任务保留的日志行数</label>
                <input id="max-log-lines" type="number" min="50" max="20000" step="50" @bind="_form.MaxLogLines" />
                <span class="field-help">允许范围 50 ~ 20000；超出后丢弃最早的行，数值越大占用内存越多。</span>
            </div>

            <div class="field">
                <label for="history-retention">任务历史保留天数</label>
                <input id="history-retention" type="number" min="0" max="3650" @bind="_form.TaskHistoryRetentionDays" />
                <span class="field-help">应用每次启动时按这个天数清理一次历史记录（0 表示启动时不自动清理）。</span>
            </div>

            <div class="toolbar">
                <button type="button" class="ffui-btn" @onclick="CleanupHistoryAsync"
                        disabled="@(_isCleaningHistory || _form.TaskHistoryRetentionDays <= 0)">
                    @if (_isCleaningHistory)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    @(_isCleaningHistory ? "清理中…" : "立即清理历史")
                </button>
                <button type="button" class="ffui-btn ffui-btn-danger" @onclick="OpenClearConfirm"
                        disabled="@_isClearingHistory">
                    清空全部历史
                </button>
                @if (_form.TaskHistoryRetentionDays <= 0)
                {
                    <span class="muted">保留天数填的是 0（不按天数清理），要清空请用「清空全部历史」。</span>
                }
            </div>
            <span class="field-help">「立即清理历史」按上面填写的天数执行一次（使用当前输入值，不需要先保存设置）。</span>

            @if (!string.IsNullOrEmpty(_historyMessage))
            {
                <div class="ffui-alert ffui-alert-info history-message" role="status">@_historyMessage</div>
            }

            <details class="advanced">
                <summary>全局 FFmpeg 参数（高级）</summary>
                <div class="field">
                    <label for="global-args">附加到每条 FFmpeg 命令的参数</label>
                    <input id="global-args" type="text" @bind="_form.GlobalFFmpegArguments" placeholder="-threads 4" />
                    <span class="field-help">留空表示不追加。参数会被插入到输出文件之前，对每一次转换都生效。</span>
                </div>
                <div class="ffui-alert ffui-alert-warning" role="status">
                    <span aria-hidden="true">⚠️</span>
                    <span>
                        这些参数会附加到每一条命令，写错会让所有转换都失败；请先确认语法。
                        不要在这里写 <span class="code-path">-y</span> / <span class="code-path">-n</span>，覆盖策略由「文件已存在时的处理方式」自动处理。
                    </span>
                </div>
            </details>
        </section>

        @* ── 6 · 界面与通知 ───────────────────────────────────────────── *@
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">🎨 界面与通知</h2>

            <div class="field">
                <label for="theme-select">主题</label>
                <select id="theme-select" @bind="_form.Theme" @bind:after="OnThemeChangedAsync">
                    <option value="System">跟随系统</option>
                    <option value="Light">浅色</option>
                    <option value="Dark">深色</option>
                </select>
                <span class="field-help">切换后立即生效并自动记住，下次打开时保持（不需要点「保存设置」，也不需要刷新页面）。</span>
            </div>

            <div class="check-field">
                <input id="notify-completion" type="checkbox" @bind="_form.NotifyOnCompletion" @bind:after="OnNotifyChangedAsync" />
                <div>
                    <label for="notify-completion">任务完成后发送浏览器通知</label>
                    <span class="field-help">
                        勾选时浏览器会弹出权限请求；如果权限被拒绝或在设置里被关闭，通知不会出现（可在浏览器地址栏的站点设置里重新允许）。
                    </span>
                </div>
            </div>

            <div class="field">
                <label for="listen-port">监听端口</label>
                <input id="listen-port" type="number" min="0" max="65535" @bind="_form.ListenPort" />
                <span class="field-help">
                    修改后需要<b>重启应用</b>才会生效；0 表示自动挑选一个空闲端口。
                    实际端口的优先级为：命令行 <span class="code-path">--port</span> &gt;
                    环境变量 <span class="code-path">FFMPEGWEBUI_PORT</span> &gt;
                    <span class="code-path">appsettings.json</span> 的 <span class="code-path">FFmpegWebUI:ListenPort</span> &gt;
                    这里保存的值。只要上面几项都没有显式设置，这里改的就是实际使用的端口。
                </span>
            </div>
        </section>

        @* ── 7 · 保存 / 恢复默认 ──────────────────────────────────────── *@
        <div class="action-bar" role="group" aria-label="设置操作">
            @if (_loadFailed)
            {
                <div class="ffui-alert ffui-alert-danger bar-errors" role="alert">
                    <span aria-hidden="true">⛔</span>
                    <span>设置读取失败，为避免覆盖已有配置，保存已禁用。请先点击「重新读取设置」。</span>
                </div>
            }
            else if (ValidationErrors.Count > 0)
            {
                <div class="ffui-alert ffui-alert-danger bar-errors" role="alert">
                    <span aria-hidden="true">⚠️</span>
                    <div>
                        <strong>有 @ValidationErrors.Count 项需要修正，保存已禁用：</strong>
                        <ul>
                            @for (var i = 0; i < ValidationErrors.Count; i++)
                            {
                                <li @key="i">@ValidationErrors[i]</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="action-bar-row">
                <button type="button" class="ffui-btn ffui-btn-primary ffui-btn-lg" @onclick="SaveAsync" disabled="@(!CanSave)">
                    @if (_isSaving)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    @(_isSaving ? "保存中…" : "💾 保存设置")
                </button>
                <button type="button" class="ffui-btn ffui-btn-lg" @onclick="OpenResetConfirm"
                        disabled="@(_isSaving || _isResetting)">
                    @if (_isResetting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                    }
                    🔄 恢复默认
                </button>
                @if (_loadFailed)
                {
                    <button type="button" class="ffui-btn" @onclick="RetryLoadAsync">重新读取设置</button>
                }

                @if (!_loadFailed)
                {
                    @if (HasChanges)
                    {
                        <span class="ffui-badge ffui-badge-warning">● 有未保存的更改</span>
                    }
                    else
                    {
                        <span class="ffui-badge ffui-badge-success">✓ 已保存</span>
                    }
                }

                <span class="muted">设置只写在本机数据目录，不会上传。</span>
            </div>
        </div>
    }
</div>

<ConfirmDialog IsOpen="@_resetConfirmOpen"
               IsOpenChanged="OnResetConfirmChanged"
               Title="恢复默认设置"
               Message="确定把全部设置恢复为默认值吗？"
               Detail="FFmpeg 路径、输出规则、硬件加速、性能与界面设置都会被覆盖；任务历史不受影响。"
