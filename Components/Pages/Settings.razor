    // ── 路径测试 ────────────────────────────────────────────────────────

    /// <summary>只有当前输入与上次测试的路径一致时才展示测试结果（路径一改，旧结论就作废）</summary>
    private PathTestResult? FFmpegTestShown =>
        _ffmpegTest is not null && string.Equals(NormalizePathText(_form.FFmpegPath), _ffmpegTestPath, StringComparison.Ordinal)
            ? _ffmpegTest
            : null;

    private PathTestResult? FFprobeTestShown =>
        _ffprobeTest is not null && string.Equals(NormalizePathText(_form.FFprobePath), _ffprobeTestPath, StringComparison.Ordinal)
            ? _ffprobeTest
            : null;

    private static string NormalizePathText(string? value) => (value ?? string.Empty).Trim().Trim('"');

    private async Task TestFFmpegAsync()
    {
        _isTestingFFmpeg = true;
        _ffmpegTest = null;

        try
        {
            var typed = NormalizePathText(_form.FFmpegPath);
            var source = typed.Length > 0 ? $"路径「{typed}」" : "系统 PATH";
            _ffmpegTestPath = typed;

            var version = await SettingsService.GetFFmpegVersionAsync(typed);
            if (!string.IsNullOrWhiteSpace(version))
            {
                _ffmpegTest = new PathTestResult(true, $"✓ 可用（{source}）：{version}");
                Toast.Success("FFmpeg 可用");
            }
            else
            {
                var valid = await SettingsService.ValidateFFmpegPathAsync(typed);
                var message = valid
                    ? $"✗ 能执行但读不到版本信息（{source}）：ffmpeg -version 没有返回可识别的内容，请确认它真的是 FFmpeg。"
                    : typed.Length > 0
                        ? $"✗ 不可用：无法执行「{typed}」（文件不存在、没有执行权限，或不是 FFmpeg 可执行文件）。"
                        : "✗ 不可用：系统 PATH 中没有找到可执行的 ffmpeg，请在上面填写完整路径。";
                _ffmpegTest = new PathTestResult(false, message);
                Toast.Error("FFmpeg 测试未通过");
            }
        }
        catch (Exception ex)
        {
            _ffmpegTest = new PathTestResult(false, $"✗ 测试出错：{ex.Message}");
            Toast.Error($"测试 FFmpeg 出错：{ex.Message}");
        }
        finally
        {
            _isTestingFFmpeg = false;
        }

        await RefreshAsync();
    }

    private async Task TestFFprobeAsync()
    {
        _isTestingFFprobe = true;
        _ffprobeTest = null;

        try
        {
            await Task.Yield();

            var typed = NormalizePathText(_form.FFprobePath);
            var resolved = _status?.FFprobePath ?? string.Empty;
            var target = typed.Length > 0 ? typed : resolved;
            _ffprobeTestPath = typed;

            if (target.Length > 0 && FileService.IsFileAccessible(target))
            {
                _ffprobeTest = new PathTestResult(true,
                    $"✓ 文件存在且可读：{target}（只检查了文件是否可访问，没有真的执行 ffprobe）");
            }
            else
            {
                // 只写了名字（没有路径分隔符）时由系统 PATH 解析，这里按 PATH 目录查找同名可执行文件
                var lookupName = typed.Length > 0 && !HasDirectorySeparator(typed) ? typed : "ffprobe";
                var onPath = FindOnPath(lookupName);

                if (onPath is not null)
                {
                    _ffprobeTest = new PathTestResult(true,
                        $"✓ 在系统 PATH 中找到：{onPath}（只检查了文件是否存在，没有真的执行 ffprobe）");
                }
                else
                {
                    var targetNote = target.Length > 0
                        ? $"「{target}」不是可读取的文件"
                        : "输入框为空，应用也还没有解析出 ffprobe 路径";
                    _ffprobeTest = new PathTestResult(false,
                        $"✗ 未找到可用的 ffprobe：{targetNote}，系统 PATH 中也没有 {lookupName}。" +
                        $"（本次只做了文件检查，没有执行 ffprobe；ffprobe 通常与 ffmpeg 一起安装，可填写 ffmpeg 同目录下的 ffprobe{(AppPaths.IsWindows ? ".exe" : string.Empty)}）");
                }
            }
        }
        catch (Exception ex)
        {
            _ffprobeTest = new PathTestResult(false, $"✗ 检查出错：{ex.Message}");
            Toast.Error($"测试 ffprobe 出错：{ex.Message}");
        }
        finally
        {
            _isTestingFFprobe = false;
        }

        await RefreshAsync();
    }

    private static bool HasDirectorySeparator(string value) =>
        value.Contains('/') || value.Contains('\\');

    /// <summary>在系统 PATH 中查找同名可执行文件（只判断文件存在，不执行它）</summary>
    private static string? FindOnPath(string name)
    {
        var pathVariable = Environment.GetEnvironmentVariable("PATH");
        if (string.IsNullOrWhiteSpace(pathVariable)) return null;

        foreach (var entry in pathVariable.Split(Path.PathSeparator, StringSplitOptions.RemoveEmptyEntries))
        {
            var directory = entry.Trim().Trim('"');
            if (directory.Length == 0) continue;

            var candidate = Path.Combine(directory, name + AppPaths.ExeSuffix);
            if (File.Exists(candidate)) return candidate;
        }

        return null;
    }

    // ── 主题 / 通知 ─────────────────────────────────────────────────────

    /// <summary>
    /// 主题切换：立即生效，并且立即记住。
    ///
    /// 主题是显示偏好，用户预期「选了就生效、下次打开还是它」。
    /// 之前只调用 applyTheme，不写数据库，于是 MainLayout 在下次加载时
    /// 会用「已保存的设置」把主题和 Cookie 一起覆盖回去 —— 表现就是
    /// 选了深色、刷新一下又变回浅色。
    ///
    /// 这里只单独保存 Theme 字段，不用整份表单去保存，
    /// 避免把用户尚未保存的其它改动一起写进去。
    /// </summary>
    private async Task OnThemeChangedAsync()
    {
        await ApplyThemeAsync(_form.Theme);

        try
        {
            var stored = await SettingsService.GetSettingsAsync();
            if (!string.Equals(stored.Theme, _form.Theme, StringComparison.Ordinal))
            {
                stored.Theme = _form.Theme;
                await SettingsService.SaveSettingsAsync(stored);
            }

            // 同步「已保存」快照，否则会一直显示「有未保存的更改」
            _original = _original with { Theme = _form.Theme };
        }
        catch (Exception ex)
        {
            Toast.Warning($"主题已在本页生效，但没能记住（保存设置时会一起写入）：{ex.Message}");
        }
    }

    private async Task ApplyThemeAsync(string theme)
    {
        try
        {
            await JS.InvokeVoidAsync("ffui.applyTheme", theme);

            // 与服务端首屏保持一致：把主题写进 Cookie（与 MainLayout 相同的做法）
            await JS.InvokeVoidAsync("ffui.setThemeCookie",
                string.IsNullOrWhiteSpace(theme) ? "System" : theme);
        }
        catch (Exception ex)
        {
            Toast.Warning($"主题已记录，但本页预览失败（浏览器连接不可用）：{ex.Message}");
        }
    }

    private async Task OnNotifyChangedAsync()
    {
        if (!_form.NotifyOnCompletion) return;

        try
        {
            var granted = await JS.InvokeAsync<bool>("ffui.requestNotificationPermission");
            if (granted)
            {
                Toast.Success("浏览器已允许通知：任务完成后会弹出提醒。");
            }
            else
            {
                Toast.Warning("浏览器没有授予通知权限：勾选会保留，但转换完成时不会弹出系统通知。可在浏览器地址栏的站点设置里重新允许。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"请求通知权限失败：{ex.Message}");
        }
    }

    // ── 历史数据 ────────────────────────────────────────────────────────

    private async Task CleanupHistoryAsync()
    {
        var days = _form.TaskHistoryRetentionDays;
        if (days <= 0)
        {
            Toast.Warning("保留天数为 0，没有可清理的时间范围；请先填写天数，或使用「清空全部历史」。");
            return;
        }

        _isCleaningHistory = true;
        try
        {
            var threshold = DateTime.UtcNow.AddDays(-days);
            var removed = await TaskService.CleanupHistoryAsync(threshold);

            _historyMessage =
                $"已清理 {FormatLocalTime(threshold)} 之前的记录：删除 {removed} 条（保留天数 {days} 天）。";
            Toast.Success(removed > 0 ? $"已清理 {removed} 条历史记录" : "没有需要清理的历史记录");
        }
        catch (Exception ex)
        {
            _historyMessage = null;
            Toast.Error($"清理历史失败：{ex.Message}");
        }
        finally
        {
            _isCleaningHistory = false;
        }

        await RefreshAsync();
    }

