@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>出错了 - @AppInfo.Name</PageTitle>

<div class="ffui-container">
    <div class="ffui-panel error-page">
        <h1>😵 应用遇到了一个错误</h1>
        <p>这次请求没有正常完成。多数情况下重新加载页面即可恢复；如果反复出现，请把下面的信息反馈给开发者。</p>

        @if (ShowRequestId)
        {
            <p class="request-id">
                请求 ID：<code>@RequestId</code>
            </p>
        }

        <details class="details">
            <summary>排查建议</summary>
            <ul>
                <li>确认「设置」里的 FFmpeg 路径指向真实可执行文件（可用「测试 FFmpeg」按钮验证）。</li>
                <li>确认输出目录存在且可写。</li>
                <li>数据目录（<code>@AppPaths.DataDirectory</code>）需要有读写权限；如果被占用或损坏，可删除其中的 <code>data.db</code> 重新初始化。</li>
                <li>查看运行此应用的终端窗口，那里有更详细的错误日志。</li>
            </ul>
        </details>

        <div class="actions">
            <a class="ffui-btn ffui-btn-primary" href="">返回首页</a>
            <a class="ffui-btn" href="settings">打开设置</a>
        </div>
    </div>
</div>

<style>
    .error-page { padding: 2rem 1.5rem; }
    .error-page h1 { margin-top: 0; }
    .request-id { color: var(--text-secondary); font-size: 0.9rem; }
    .details { margin: 1rem 0; color: var(--text-secondary); font-size: 0.9rem; }
    .details ul { margin: 0.6rem 0 0; padding-left: 1.2rem; }
    .details li { margin-bottom: 0.3rem; }
    .actions { display: flex; gap: 0.6rem; margin-top: 1.25rem; }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
