    // ── 命令预览 ────────────────────────────────────────────────────

    private async Task RebuildPreviewAsync()
    {
        _previewWarnings = [];
        _templateUnrunnable = false;
        _encoderProfile = null;
        _previewCommand = string.Empty;
        _conflictNotice = string.Empty;
        _resolvedOutputPath = null;

        if (_selectedTemplate == null || string.IsNullOrWhiteSpace(_inputPath) || string.IsNullOrWhiteSpace(_outputDirectory))
        {
            return;
        }

        try
        {
            var requested = GetRequestedOutputPath();
            if (string.IsNullOrEmpty(requested))
            {
                return;
            }

            var settings = await SettingsService.GetSettingsAsync();
            var action = _forceOverwrite ? FileExistsAction.Overwrite : settings.FileExistsAction;
            var existed = File.Exists(requested);
            // 传入输入路径，让「输出 == 输入」这种会破坏源文件的情况在预览阶段就显示出来
            var resolution = OutputPathResolver.Resolve(requested, action, _inputPath);

            if (existed && !_forceOverwrite)
            {
                _conflictNotice = resolution.Skip
                    ? "输出文件已存在：按当前设置将跳过本次转换，不会覆盖原文件。"
                    : resolution.Renamed
                        ? "输出文件已存在，将自动改名后保存，避免覆盖原文件。"
                        : "输出文件已存在，将按设置覆盖。";
            }

            // 「输出 == 输入」会被上一行当成普通的「文件已存在」，这里要给出更准确的说明
            if (OutputPathResolver.PathsEqual(requested, _inputPath))
            {
                _conflictNotice = "输出路径与输入文件相同：已自动改名，避免把源文件覆盖掉。" +
                                  "（把输出目录换成别的目录、或让输出文件名带上后缀，可以避免改名。）";
            }

            _resolvedOutputPath = resolution.OutputPath;

            var context = new CommandContext
            {
                InputPath = _inputPath,
                OutputPath = resolution.OutputPath,
                Parameters = _parameterValues,
                Media = _mediaInfo,
                AudioEncoder = ResolveAudioEncoder(_selectedTemplate)
            };

            // 需要自动选择编码器时才去解析硬件信息
            var usesEncoder = _selectedTemplate.CommandArgs.Contains("{encoder}", StringComparison.OrdinalIgnoreCase)
                              || _selectedTemplate.HardwareMode != HardwareAccelerationMode.None;

            if (usesEncoder)
            {
                var codec = DetermineCodec(_selectedTemplate);
                var strict = _selectedTemplate.HardwareMode == HardwareAccelerationMode.Required;
                var name = await HardwareDetection.GetRecommendedEncoderAsync(codec, _selectedTemplate.RequiredEncoder, strict);

                if (name is null)
                {
                    // 严格模式下拿不到编码器 = 本机缺少该厂商硬件，模板会被执行层拒绝
                    var family = EncoderCatalog.FamilyDisplayName(
                        EncoderCatalog.Find(_selectedTemplate.RequiredEncoder ?? "")?.Family
                        ?? _selectedTemplate.RequiredEncoder ?? "");
                    _templateUnrunnable = true;
                    _previewWarnings.Add(
                        $"❌ 该模板要求使用 {family} 硬件编码，但本机没有可用的对应编码器，" +
                        "无法执行。建议改用「推荐」分类下会自动挑选编码器的模板。");
                }

                _encoderProfile = EncoderCatalog.Find(name ?? string.Empty) ?? EncoderCatalog.SoftwareFallback(codec);
            }

            context.Encoder = _encoderProfile;

            var built = FFmpegService.BuildCommand(_selectedTemplate, context);
            _previewCommand = built.CommandLine;
            _previewWarnings.AddRange(built.Warnings);
        }
        catch (Exception ex)
        {
            _previewWarnings = [$"生成命令预览失败：{ex.Message}"];
        }
    }

    private static string DetermineCodec(CommandTemplate template)
    {
        if (!string.IsNullOrWhiteSpace(template.TargetCodec))
        {
            return HardwareDetectionService.NormalizeCodec(template.TargetCodec);
        }
        if (!string.IsNullOrWhiteSpace(template.RequiredEncoder))
        {
            var profile = EncoderCatalog.Find(template.RequiredEncoder);
            if (profile != null) return profile.Codec;
            var family = EncoderCatalog.ByFamily(template.RequiredEncoder).FirstOrDefault();
            if (family != null) return family.Codec;
        }
        var fromExtension = HardwareDetectionService.NormalizeCodec(template.OutputExtension);
        if (fromExtension is "h264" or "hevc" or "av1" or "vp9") return fromExtension;
        return "h264";
    }

    private static string ResolveAudioEncoder(CommandTemplate template)
    {
        foreach (var candidate in new[] { "libopus", "libmp3lame", "flac", "aac" })
        {
            if (template.CommandArgs.Contains(candidate, StringComparison.OrdinalIgnoreCase)) return candidate;
        }
        return template.OutputExtension.ToLowerInvariant() switch
        {
            "webm" => "libopus",
            "mp3" => "libmp3lame",
            "flac" => "flac",
            "ogg" => "libopus",
            _ => "aac"
        };
    }

    private string GetRequestedOutputPath()
    {
        if (_selectedTemplate == null || string.IsNullOrWhiteSpace(_inputPath)) return string.Empty;

        var extension = string.IsNullOrWhiteSpace(_selectedTemplate.OutputExtension)
            ? "mp4"
            : _selectedTemplate.OutputExtension.TrimStart('.');

        string fileName;
        if (!string.IsNullOrWhiteSpace(_outputFileName))
        {
            fileName = FileService.FormatFileName(_outputFileName, _inputPath, extension);
        }
        else
        {
            fileName = Path.GetFileNameWithoutExtension(_inputPath);
            if (_namingRule == OutputNamingRule.Suffix && !string.IsNullOrEmpty(_namingSuffix))
            {
                fileName += _namingSuffix;
            }
        }

        return Path.Combine(_outputDirectory, $"{fileName}.{extension}");
    }

    private async Task UseOverwriteAsync()
    {
        _forceOverwrite = true;
        await RebuildPreviewAsync();
    }

    private async Task UseNewNameAsync()
    {
        _forceOverwrite = false;
        await RebuildPreviewAsync();
    }

    private void OnParameterValuesChanged(Dictionary<string, string> values)
    {
        _parameterValues = values;
        _ = RebuildPreviewAsync();
    }

    private void ResetParameters()
    {
        if (_selectedTemplate == null) return;
        _parameterValues = TemplateService.CreateDefaultParameterValues(_selectedTemplate);
        _testResult = null;
        _ = RebuildPreviewAsync();
    }

    private async Task CopyCommandAsync()
    {
        var text = "ffmpeg " + _previewCommand;
        var ok = await JS.InvokeAsync<bool>("ffui.copyText", text);

        if (ok)
        {
            _commandCopied = true;
            Toast.Success("命令已复制到剪贴板");
            _ = ResetCopiedFlagAsync();
        }
        else
        {
            Toast.Error("复制失败：浏览器不允许访问剪贴板。请手动选中命令文本后复制。");
        }

        await Task.CompletedTask;
    }

    private async Task ResetCopiedFlagAsync()
    {
        await Task.Delay(2000);
        _commandCopied = false;
        try { await InvokeAsync(StateHasChanged); } catch { /* 组件已销毁 */ }
    }

    // ── 执行 ────────────────────────────────────────────────────────

    private async Task StartConversionAsync()
    {
        if (!CanStart || _selectedTemplate == null) return;

        _isStarting = true;
        try
        {
            var outputPath = _resolvedOutputPath ?? GetRequestedOutputPath();
            if (string.IsNullOrWhiteSpace(outputPath))
            {
                Toast.Error("无法确定输出路径，请检查输出目录设置。");
                return;
            }

            var directory = Path.GetDirectoryName(outputPath);
            if (!string.IsNullOrEmpty(directory) && !Directory.Exists(directory))
            {
                Directory.CreateDirectory(directory);
            }

            if (!OutputPathResolver.IsOutputPathWritable(outputPath))
            {
                Toast.Error($"输出目录不可写：{directory}。请换一个目录或检查文件权限。");
                return;
            }

            var overwrite = _forceOverwrite || !File.Exists(outputPath);
            var task = await TaskService.CreateTaskAsync(
                _inputPath, outputPath, _selectedTemplate.Id, _parameterValues, overwrite);

            if (await TaskService.StartTaskAsync(task.Id))
            {
                Toast.Success($"已开始转换：{Path.GetFileName(task.InputPath)}");
                _expandedTaskId = task.Id;
            }
            else
            {
                Toast.Warning("任务已创建但未能立即调度，请到「任务列表」查看。");
            }

            await RefreshActiveAsync();
            await LoadRecentAsync();
        }
        catch (FileNotFoundException ex)
        {
            Toast.Error(ex.Message);
        }
        catch (ArgumentException ex)
        {
            Toast.Error(ex.Message);
        }
        catch (Exception ex)
        {
            Toast.Error($"创建任务失败：{ex.Message}");
        }
        finally
        {
            _isStarting = false;
        }
    }

    private async Task TestTemplateAsync()
    {
        if (_selectedTemplate == null) return;

        _isTesting = true;
        _testResult = null;
        try
        {
            _testResult = await TemplateService.TestTemplateAsync(_selectedTemplate, _parameterValues);
            if (_testResult.Success) Toast.Success("模板试运行成功，该模板在本机可用");
            else Toast.Error("模板试运行失败，请看下方详情");
        }
        catch (Exception ex)
        {
            _testResult = new TemplateTestResult(false, $"试运行出错：{ex.Message}", string.Empty, string.Empty, TimeSpan.Zero);
            Toast.Error($"试运行出错：{ex.Message}");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task GracefulStopAsync(ObjectId taskId)
    {
        if (await TaskService.CancelTaskAsync(taskId, graceful: true))
        {
            Toast.Warning("已发送优雅停止指令，FFmpeg 会写完文件尾再退出。");
        }
        else
        {
            Toast.Warning("该任务已经不在运行中。");
        }
    }

    private async Task ForceCancelAsync(ObjectId taskId)
    {
        if (await TaskService.CancelTaskAsync(taskId, graceful: false))
        {
            Toast.Warning("已取消任务，未完成的输出文件会被清理。");
            await RefreshActiveAsync();
        }
        else
        {
            Toast.Warning("该任务已经结束。");
        }
    }

    private async Task RetryAsync(ObjectId taskId)
    {
        try
        {
            var retry = await TaskService.RetryTaskAsync(taskId);
            if (retry == null)
            {
                Toast.Error("找不到原任务，无法重试。");
                return;
            }
            Toast.Success("已重新加入队列");
            await RefreshActiveAsync();
            await LoadRecentAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"重试失败：{ex.Message}");
        }
    }

    private async Task OpenOutputFolderAsync(ConversionTask task)
    {
        var directory = Path.GetDirectoryName(task.OutputPath);
        if (string.IsNullOrEmpty(directory) || !Directory.Exists(directory))
        {
            Toast.Warning("输出目录不存在，可能已被移动或删除。");
            return;
        }

        try
        {
            if (AppPaths.IsWindows)
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", $"\"{directory}\"") { UseShellExecute = true });
            }
            else if (AppPaths.IsMacOS)
            {
                System.Diagnostics.Process.Start("open", [directory]);
            }
            else
            {
                System.Diagnostics.Process.Start("xdg-open", [directory]);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"无法打开目录：{ex.Message}");
        }

        await Task.CompletedTask;
    }

    // ── 任务列表与事件 ──────────────────────────────────────────────

    private async Task RefreshActiveAsync()
    {
        try
        {
            var running = await TaskService.GetRunningTasksAsync();
            var pending = await TaskService.GetPendingTasksAsync();
            _activeTasks = running.Concat(pending).OrderByDescending(t => t.CreatedAt).ToList();
        }
        catch (Exception ex)
        {
            Toast.Error($"读取任务列表失败：{ex.Message}");
        }
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            _recentTasks = await TaskService.GetTaskHistoryAsync(8);
        }
        catch
        {
            _recentTasks = [];
        }
    }

    private void OnProgressChanged(object? sender, TaskProgressEventArgs e)
    {
        var task = _activeTasks.FirstOrDefault(t => t.Id == e.TaskId);
        if (task == null) return;

        task.Progress = e.Progress;
        task.ProcessingSpeed = e.Speed;
        task.EstimatedTimeRemaining = e.Eta;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnStatusChanged(object? sender, TaskStatusEventArgs e)
    {
        _ = HandleStatusChangedAsync(e);
    }

    private async Task HandleStatusChangedAsync(TaskStatusEventArgs e)
    {
        try
        {
            var task = await TaskService.GetTaskByIdAsync(e.TaskId);
            var name = task == null ? "任务" : Path.GetFileName(task.InputPath);

            if (e.NewStatus is TaskStatus.Completed or TaskStatus.Failed or TaskStatus.Cancelled or TaskStatus.Skipped)
            {
                switch (e.NewStatus)
                {
                    case TaskStatus.Completed:
                        Toast.Success($"✅ 转换完成：{name}");
                        break;
                    case TaskStatus.Failed:
                        Toast.Error($"❌ 转换失败：{name} — {e.ErrorMessage}");
                        break;
                    case TaskStatus.Cancelled:
                        Toast.Warning($"已取消：{name}");
                        break;
                    case TaskStatus.Skipped:
                        Toast.Warning($"已跳过：{name}（输出文件已存在）");
                        break;
                }
            }

            await RefreshActiveAsync();
            await LoadRecentAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // 事件回调中的异常不应影响其它订阅者
        }
    }

    private void OnLogAppended(object? sender, TaskLogEventArgs e)
    {
        var key = e.TaskId.ToString();
        var existing = _liveLogs.TryGetValue(key, out var log) ? log : string.Empty;

        // 内存里只保留最近 800 行，长任务不会把浏览器拖垮
        var lines = existing.Length == 0 ? 0 : existing.Count(c => c == '\n');
        if (lines > 800)
        {
            var index = existing.IndexOf('\n');
            existing = index >= 0 ? existing[(index + 1)..] : string.Empty;
        }

        _liveLogs[key] = existing + e.Line + Environment.NewLine;

        if (_expandedTaskId == e.TaskId)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private string GetLiveLog(ObjectId taskId) =>
        _liveLogs.TryGetValue(taskId.ToString(), out var log) ? log : string.Empty;

    private async Task ToggleLogAsync(ObjectId taskId)
    {
        _expandedTaskId = _expandedTaskId == taskId ? null : taskId;

        if (_expandedTaskId != null && !_liveLogs.ContainsKey(taskId.ToString()))
        {
            var task = await TaskService.GetTaskByIdAsync(taskId);
            if (task != null && !string.IsNullOrEmpty(task.LogOutput))
            {
                _liveLogs[taskId.ToString()] = task.LogOutput;
            }
        }
    }

    // ── 展示辅助 ────────────────────────────────────────────────────

    private static string StatusText(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "已完成",
        TaskStatus.Failed => "失败",
        TaskStatus.Running => "运行中",
        TaskStatus.Cancelled => "已取消",
        TaskStatus.Skipped => "已跳过",
        _ => "等待中"
    };

    private static string StatusBadgeClass(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "ffui-badge-success",
        TaskStatus.Failed => "ffui-badge-danger",
        TaskStatus.Running => "ffui-badge-info",
        TaskStatus.Cancelled => "ffui-badge-warning",
        TaskStatus.Skipped => "ffui-badge-warning",
        _ => string.Empty
    };

    private static string FormatDuration(double? seconds)
    {
        if (seconds is not > 0) return "-";
        var span = TimeSpan.FromSeconds(seconds.Value);
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:D2}:{span.Seconds:D2}"
            : $"{span.Minutes:D2}:{span.Seconds:D2}";
    }

    public void Dispose()
    {
        TaskService.TaskProgressChanged -= OnProgressChanged;
        TaskService.TaskStatusChanged -= OnStatusChanged;
        TaskService.TaskLogAppended -= OnLogAppended;
    }
