@page "/convert"
@using LiteDB
@inject ITaskService TaskService
@inject ITemplateService TemplateService
@inject IFileService FileService
@inject ISettingsService SettingsService
@inject IFFmpegService FFmpegService
@inject IHardwareDetectionService HardwareDetection
@inject IAppStatusService AppStatusService
@inject IToastService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>转换 - @AppInfo.Name</PageTitle>

<div class="ffui-container">
    <div class="page-head">
        <h1>🔄 媒体转换</h1>
        @if (_status is { FFmpegAvailable: false })
        {
            <span class="ffui-badge ffui-badge-danger">FFmpeg 不可用</span>
        }
        else if (_status is { FFmpegAvailable: true })
        {
            <span class="ffui-badge ffui-badge-success">FFmpeg @_status.FFmpegVersion</span>
            @if (_status.AvailableHardwareEncoderCount > 0)
            {
                <span class="ffui-badge ffui-badge-info">🚀 @_status.AvailableHardwareEncoderCount 个硬件编码器可用</span>
            }
            else
            {
                <span class="ffui-badge">🧮 使用软件编码</span>
            }
        }
    </div>

    @if (_status is { FFmpegAvailable: false })
    {
        <div class="ffui-alert ffui-alert-danger" role="alert">
            <span aria-hidden="true">⚠️</span>
            <div>
                <strong>未找到可用的 FFmpeg，无法开始转换。</strong>
                <div>当前使用的路径：<code>@_status.FFmpegPath</code></div>
                <div class="alert-actions">
                    <a class="ffui-btn ffui-btn-sm ffui-btn-primary" href="settings">前往设置指定 FFmpeg 路径</a>
                    <button type="button" class="ffui-btn ffui-btn-sm" @onclick="RecheckAsync" disabled="@_isChecking">
                        @if (_isChecking)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                        }
                        重新检测
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="convert-layout">
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">1 · 输入与输出</h2>

            <FileSelector Label="输入文件"
                          @bind-Value="_inputPath"
                          Placeholder="输入视频或音频文件的完整路径"
                          ValidateExists="true"
                          ShowFileInfo="true" />

            @if (_isProbingMedia)
            {
                <div class="ffui-loading-row"><span class="spinner"></span> 正在读取媒体信息…</div>
            }
            else if (_mediaInfo != null)
            {
                <div class="media-info">
                    <span class="ffui-badge ffui-badge-info">@_mediaInfo.FormatDisplay</span>
                    <span class="ffui-badge">时长 @_mediaInfo.DurationDisplay</span>
                    @if (_mediaInfo.HasVideo)
                    {
                        <span class="ffui-badge">@_mediaInfo.Width×@_mediaInfo.Height</span>
                        <span class="ffui-badge">@_mediaInfo.FrameRate.ToString("0.##", CultureInfo.InvariantCulture) fps</span>
                        <span class="ffui-badge">@(_mediaInfo.VideoCodec ?? "未知")</span>
                    }
                    @if (_mediaInfo.HasAudio)
                    {
                        <span class="ffui-badge">@(_mediaInfo.AudioCodec ?? "未知") · @_mediaInfo.AudioChannels 声道</span>
                    }
                    else
                    {
                        <span class="ffui-badge ffui-badge-warning">无音轨</span>
                    }
                    @if (_mediaInfo.SubtitleStreamCount > 0)
                    {
                        <span class="ffui-badge">@_mediaInfo.SubtitleStreamCount 条字幕</span>
                    }
                </div>
            }

            <FileSelector Label="输出目录"
                          @bind-Value="_outputDirectory"
                          Placeholder="转换结果的保存目录"
                          IsDirectory="true"
                          ValidateExists="false" />

            <div class="field">
                <label for="output-name">输出文件名</label>
                <input id="output-name" type="text" @bind="_outputFileName" @bind:event="oninput"
                       placeholder="@_autoOutputHint" />
                <span class="field-help">
                    留空则按「设置 → 输出文件命名规则」自动生成。支持
                    <code>{filename}</code> <code>{date}</code> <code>{now:yyMMdd_HHmm}</code> <code>{random:6}</code>。
                    <button type="button" class="link-btn" @onclick="() => _showFormatHelp = !_showFormatHelp">
                        @(_showFormatHelp ? "收起全部占位符" : "查看全部占位符")
                    </button>
                </span>

                @if (_showFormatHelp)
                {
                    <div class="format-help" role="note">
                        <span><code>{filename}</code> 原文件名（不含扩展名）</span>
                        <span><code>{ext}</code> 原扩展名</span>
                        <span><code>{outputext}</code> 输出扩展名</span>
                        <span><code>{dir}</code> 原文件所在文件夹名</span>
                        <span><code>{date}</code> 日期 yyyyMMdd</span>
                        <span><code>{time}</code> 时间 HHmmss</span>
                        <span><code>{datetime}</code> yyyyMMdd_HHmmss</span>
                        <span><code>{year}</code> <code>{month}</code> <code>{day}</code> <code>{hour}</code> <code>{minute}</code> <code>{second}</code></span>
                        <span><code>{now:格式}</code> 自定义日期格式，如 <code>{now:yyMMdd_HHmm}</code></span>
                        <span><code>{random}</code> 8 位随机串</span>
                        <span><code>{random:N}</code> N 位随机串，如 <code>{random:6}</code></span>
                    </div>
                }
            </div>
        </section>

        <section class="ffui-panel">
            <h2 class="ffui-panel-title">2 · 选择转换模板</h2>
            <TemplateSelector @bind-SelectedTemplate="_selectedTemplate" InputPath="_inputPath" />
        </section>
    </div>

    @if (_selectedTemplate != null)
    {
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">
                3 · 模板参数
                <span class="ffui-badge">@_selectedTemplate.Name</span>
            </h2>

            @if (ValidationErrors.Count > 0)
            {
                <div class="ffui-alert ffui-alert-danger" role="alert">
                    <span aria-hidden="true">⛔</span>
                    <div>
                        <strong>该模板存在问题，无法执行：</strong>
                        <ul>
                            @foreach (var issue in ValidationErrors)
                            {
                                <li>@issue.Message</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (_selectedTemplate.Parameters.Count == 0)
            {
                <p class="muted">该模板没有可调参数，将直接使用模板预设值。</p>
            }
            else
            {
                <TemplateParameterEditor Template="_selectedTemplate"
                                         Values="_parameterValues"
                                         ValuesChanged="OnParameterValuesChanged"
                                         Disabled="_isStarting" />
            }
        </section>
    }

    @if (!string.IsNullOrEmpty(_inputPath) && _selectedTemplate != null)
    {
        <section class="ffui-panel">
            <h2 class="ffui-panel-title">4 · 确认并开始</h2>

            <div class="preview-grid">
                <div class="preview-row">
                    <span class="preview-label">输入</span>
                    <span class="preview-value mono" title="@_inputPath">@_inputPath</span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">输出</span>
                    <span class="preview-value mono" title="@ResolvedOutputPath">@(ResolvedOutputPath ?? "尚未确定")</span>
                </div>
                <div class="preview-row">
                    <span class="preview-label">编码器</span>
                    <span class="preview-value">
                        @if (_encoderProfile == null)
                        {
                            <span class="muted">由模板内部指定</span>
                        }
                        else
                        {
                            <span class="ffui-badge @(_encoderProfile.IsHardware ? "ffui-badge-success" : "")">
                                @(_encoderProfile.IsHardware ? "🚀 硬件加速" : "🧮 软件编码") · @_encoderProfile.Name
                            </span>
                            <span class="muted"> @EncoderCatalog.FamilyDisplayName(_encoderProfile.Family)</span>
                        }
                    </span>
                </div>
            </div>

            @if (_conflictNotice != null)
            {
                <div class="ffui-alert ffui-alert-warning" role="status">
                    <span aria-hidden="true">📄</span>
                    <div>
                        <div>@_conflictNotice</div>
                        <div class="alert-actions">
                            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="UseOverwriteAsync">覆盖已有文件</button>
                            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="UseNewNameAsync">保留两者（自动改名）</button>
                        </div>
                    </div>
                </div>
            }

            @foreach (var warning in _previewWarnings)
            {
                <div class="ffui-alert ffui-alert-warning" role="status">
                    <span aria-hidden="true">💡</span>
                    <div>@warning</div>
                </div>
            }

            <div class="command-box">
                <div class="command-head">
                    <span>完整命令（可直接复制到终端执行）</span>
                    <div class="command-actions">
                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="CopyCommandAsync">
                            @(_commandCopied ? "✓ 已复制" : "📋 复制")
                        </button>
                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => _commandWrap = !_commandWrap">
                            @(_commandWrap ? "不换行" : "自动换行")
                        </button>
                    </div>
                </div>
                <pre class="command-code @(_commandWrap ? "wrap" : "")">ffmpeg @_previewCommand</pre>
            </div>

            <div class="action-bar">
                <button type="button" class="ffui-btn ffui-btn-primary ffui-btn-lg" @onclick="StartConversionAsync"
                        disabled="@(!CanStart)">
                    @if (_isStarting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>正在启动…</span>
                    }
                    else
                    {
                        <span>🚀 开始转换</span>
                    }
                </button>

                <button type="button" class="ffui-btn" @onclick="TestTemplateAsync" disabled="@_isTesting">
                    @if (_isTesting)
                    {
                        <span class="spinner" aria-hidden="true"></span>
                        <span>试运行中…</span>
                    }
                    else
                    {
                        <span>🧪 试运行模板</span>
                    }
                </button>

                @if (_selectedTemplate.Parameters.Count > 0)
                {
                    <button type="button" class="ffui-btn" @onclick="ResetParameters" disabled="@_isStarting">重置参数</button>
                }

                @if (!CanStart && !_isStarting && !string.IsNullOrEmpty(CannotStartReason))
                {
                    <span class="muted">@CannotStartReason</span>
                }
            </div>

            @if (_testResult != null)
            {
                <div class="ffui-alert @(_testResult.Success ? "ffui-alert-success" : "ffui-alert-danger")" role="status">
                    <span aria-hidden="true">@(_testResult.Success ? "✅" : "❌")</span>
                    <div class="test-result">
                        <div>@_testResult.Message</div>
                        @if (!_testResult.Success && !string.IsNullOrEmpty(_testResult.Output))
                        {
                            <details>
                                <summary>查看 FFmpeg 输出</summary>
                                <pre class="test-output">@_testResult.Output</pre>
                            </details>
                        }
                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => _testResult = null">关闭</button>
                    </div>
                </div>
            }
        </section>
    }

    @if (_activeTasks.Count > 0)
    {
        <section class="ffui-panel">
            <h2 class="ffui-section-title">
                <span>⏱️ 进行中的转换</span>
                <span class="ffui-badge">@_activeTasks.Count</span>
                <button type="button" class="ffui-btn ffui-btn-sm" @onclick="RefreshActiveAsync">刷新</button>
            </h2>

            @foreach (var task in _activeTasks)
            {
                <div class="active-task" @key="task.Id">
                    <div class="active-task-head">
                        <span class="task-name" title="@task.InputPath">@Path.GetFileName(task.InputPath)</span>
                        <span class="ffui-badge @StatusBadgeClass(task.Status)">@StatusText(task.Status)</span>
                        @if (!string.IsNullOrEmpty(task.TemplateName))
                        {
                            <span class="muted">@task.TemplateName</span>
                        }
                    </div>

                    <ProgressBar Progress="task.Progress"
                                 Speed="task.ProcessingSpeed"
                                 Eta="task.EstimatedTimeRemaining"
                                 CurrentTime="task.CurrentTime"
                                 TotalDuration="task.TotalDuration"
                                 Status="task.Status" />

                    <div class="active-task-actions">
                        @if (task.Status == TaskStatus.Running)
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm"
                                    title="发送 q 让 FFmpeg 写完文件尾再退出，已产出的文件仍然可用"
                                    @onclick="() => GracefulStopAsync(task.Id)">
                                ⏏️ 优雅停止
                            </button>
                            <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger"
                                    @onclick="() => ForceCancelAsync(task.Id)">
                                ❌ 强制终止
                            </button>
                        }
                        else
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger"
                                    @onclick="() => ForceCancelAsync(task.Id)">
                                取消排队
                            </button>
                        }
                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => ToggleLogAsync(task.Id)">
                            @(_expandedTaskId == task.Id ? "▲ 收起日志" : "▼ 查看日志")
                        </button>
                    </div>

                    @if (_expandedTaskId == task.Id)
                    {
                        <div class="active-task-log">
                            <LogViewer LogText="@GetLiveLog(task.Id)" MaxHeight="260px" />
                        </div>
                    }
                </div>
            }
        </section>
    }

    @if (_recentTasks.Count > 0)
    {
        <section class="ffui-panel">
            <h2 class="ffui-section-title">
                <span>📜 最近任务</span>
                <a class="ffui-btn ffui-btn-sm" href="tasks">查看全部</a>
            </h2>

            <div class="table-scroll">
                <table class="task-table">
                    <thead>
                        <tr>
                            <th scope="col">输入文件</th>
                            <th scope="col">状态</th>
                            <th scope="col">耗时</th>
                            <th scope="col">创建时间</th>
                            <th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in _recentTasks)
                        {
                            <tr @key="task.Id">
                                <td class="ellipsis" title="@task.InputPath">@Path.GetFileName(task.InputPath)</td>
                                <td><span class="ffui-badge @StatusBadgeClass(task.Status)">@StatusText(task.Status)</span></td>
                                <td>@FormatDuration(task.DurationSeconds)</td>
                                <td>@task.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                <td class="row-actions">
                                    <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => RetryAsync(task.Id)">重试</button>
                                    @if (task.Status == TaskStatus.Completed)
                                    {
                                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => OpenOutputFolderAsync(task)">打开目录</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<style>
    .page-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .page-head h1 { margin: 0; }

    .alert-actions { display: flex; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap; }

    .convert-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        align-items: start;
    }

    section.ffui-panel { margin-bottom: 1.25rem; }

    .media-info { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.25rem 0 0.9rem; }

    .field { margin-top: 0.9rem; }
    .field label { display: block; font-weight: 500; margin-bottom: 0.35rem; font-size: 0.92rem; }
    .field-help { display: block; font-size: 0.8rem; color: var(--text-muted); margin-top: 0.35rem; }

    .link-btn {
        background: none;
        border: none;
        color: var(--primary-color);
        padding: 0 0.2rem;
        font-size: 0.8rem;
        cursor: pointer;
        text-decoration: underline;
    }

    .format-help {
        display: flex;
        flex-direction: column;
        gap: 0.28rem;
        margin-top: 0.5rem;
        padding: 0.7rem 0.85rem;
        background: var(--surface-3);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        font-size: 0.78rem;
        color: var(--text-secondary);
    }

    .muted { color: var(--text-muted); font-size: 0.85rem; }
    .mono { font-family: var(--font-mono); }

    .preview-grid { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
    .preview-row { display: flex; gap: 0.75rem; align-items: baseline; }
    .preview-label { flex: 0 0 56px; color: var(--text-muted); font-size: 0.85rem; }
    .preview-value { flex: 1; min-width: 0; word-break: break-all; font-size: 0.88rem; }

    .command-box {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .command-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.75rem;
        background: var(--surface-3);
        border-bottom: 1px solid var(--border-color);
        font-size: 0.82rem;
        color: var(--text-secondary);
        flex-wrap: wrap;
    }

    .command-actions { display: flex; gap: 0.4rem; }

    .command-code {
        margin: 0;
        padding: 0.8rem;
        background: var(--code-bg);
        color: var(--text-primary);
        font-family: var(--font-mono);
        font-size: 0.82rem;
        line-height: 1.55;
        white-space: pre;
        overflow-x: auto;
    }

    .command-code.wrap { white-space: pre-wrap; word-break: break-all; overflow-x: hidden; }

    .action-bar { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }

    .test-result { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }

    .test-output {
        margin: 0.5rem 0 0;
        max-height: 220px;
        overflow: auto;
        font-size: 0.78rem;
        background: var(--code-bg);
        padding: 0.6rem;
    }

    .active-task {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        padding: 0.85rem;
        margin-bottom: 0.75rem;
        background: var(--surface-3);
    }

    .active-task-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
    .task-name { font-weight: 600; word-break: break-all; }
    .active-task-actions { display: flex; gap: 0.5rem; margin-top: 0.7rem; flex-wrap: wrap; }
    .active-task-log { margin-top: 0.7rem; }

    .table-scroll { overflow-x: auto; }
    .task-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; min-width: 620px; }
    .task-table th, .task-table td { padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid var(--border-color); }
    .task-table th { color: var(--text-secondary); font-weight: 600; font-size: 0.82rem; }
    .ellipsis { max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .row-actions { display: flex; gap: 0.35rem; }

    @@media (max-width: 1000px) {
        .convert-layout { grid-template-columns: 1fr; }
    }
</style>

@code {
    private string _inputPath = string.Empty;
    private string _outputDirectory = string.Empty;
    private string _outputFileName = string.Empty;
    private CommandTemplate? _selectedTemplate;
    private Dictionary<string, string> _parameterValues = new(StringComparer.OrdinalIgnoreCase);

    private MediaInfo? _mediaInfo;
    private bool _isProbingMedia;
    private string _lastProbedPath = string.Empty;

    private AppStatus? _status;
    private bool _isChecking;

    private EncoderProfile? _encoderProfile;
    private string _previewCommand = string.Empty;
    private List<string> _previewWarnings = [];

    /// <summary>模板要求的硬件在本机不存在 —— 明确禁用「开始转换」，而不是让用户点了才失败</summary>
    private bool _templateUnrunnable;
    private bool _commandCopied;
    private bool _commandWrap = true;
    private bool _showFormatHelp;

    private string _conflictNotice = string.Empty;
    private bool _forceOverwrite;
    private string? _resolvedOutputPath;

    private bool _isStarting;
    private bool _isTesting;
    private TemplateTestResult? _testResult;

    private List<ConversionTask> _activeTasks = [];
    private List<ConversionTask> _recentTasks = [];
    private ObjectId? _expandedTaskId;
    private readonly Dictionary<string, string> _liveLogs = [];

    private OutputNamingRule _namingRule = OutputNamingRule.Suffix;
    private string _namingSuffix = "_converted";

    private List<TemplateIssue> _validationErrors = [];
    private ObjectId? _validatedTemplateId;

    /// <summary>从模板页面跳转过来时预选的模板 ID（/convert?template=&lt;id&gt;）</summary>
    [SupplyParameterFromQuery(Name = "template")]
    public string? TemplateIdFromQuery { get; set; }

    private string? _appliedQueryTemplate;

    private List<TemplateIssue> ValidationErrors => _validationErrors;

    private string _autoOutputHint = "自动生成";

    private bool CanStart => !_isStarting
                             && _status is not { FFmpegAvailable: false }
                             && !string.IsNullOrWhiteSpace(_inputPath)
                             && !string.IsNullOrWhiteSpace(_outputDirectory)
                             && _selectedTemplate != null
                             && _validationErrors.Count == 0
                             && !_templateUnrunnable;

    private string CannotStartReason
    {
        get
        {
            if (_status is { FFmpegAvailable: false }) return "FFmpeg 不可用，请先到设置里指定路径";
            if (string.IsNullOrWhiteSpace(_inputPath)) return "请选择输入文件";
            if (_selectedTemplate == null) return "请选择转换模板";
            if (string.IsNullOrWhiteSpace(_outputDirectory)) return "请选择输出目录";
            if (_validationErrors.Count > 0) return "当前模板存在问题，请改用其他模板";
            if (_templateUnrunnable) return "当前模板要求的硬件编码器在本机不可用，请改用「推荐」分类下的模板";
            return string.Empty;
        }
    }

    private string? ResolvedOutputPath => _resolvedOutputPath;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await SettingsService.GetSettingsAsync();
            _outputDirectory = settings.DefaultOutputDirectory;
            _namingRule = settings.OutputNaming;
            _namingSuffix = settings.OutputSuffix;
        }
        catch (Exception ex)
        {
            Toast.Error($"读取设置失败：{ex.Message}");
        }

        await RefreshActiveAsync();
        await LoadRecentAsync();

        TaskService.TaskProgressChanged += OnProgressChanged;
        TaskService.TaskStatusChanged += OnStatusChanged;
        TaskService.TaskLogAppended += OnLogAppended;

        _ = LoadStatusAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // 支持从「模板」页跳转时带上 ?template=<id> 预选模板
        if (!string.IsNullOrEmpty(TemplateIdFromQuery) &&
            !string.Equals(_appliedQueryTemplate, TemplateIdFromQuery, StringComparison.Ordinal))
        {
            _appliedQueryTemplate = TemplateIdFromQuery;

            ObjectId? queryId = null;
            try
            {
                // LiteDB 5 的 ObjectId 没有 TryParse，构造失败会抛异常
                queryId = new ObjectId(TemplateIdFromQuery);
            }
            catch
            {
                queryId = null;
            }

            if (queryId == null)
            {
                Toast.Warning("链接中的模板标识无效。");
            }
            else
            {
                try
                {
                    var preselected = await TemplateService.GetTemplateByIdAsync(queryId);
                    if (preselected != null)
                    {
                        _selectedTemplate = preselected;
                        Toast.Success($"已预选模板：{preselected.Name}");
                    }
                    else
                    {
                        Toast.Warning("链接中的模板不存在或已被删除。");
                    }
                }
                catch (Exception ex)
                {
                    Toast.Error($"读取预选模板失败：{ex.Message}");
                }
            }
        }

        var templateChanged = _selectedTemplate != null && _validatedTemplateId != _selectedTemplate.Id;

        if (templateChanged)
        {
            _validatedTemplateId = _selectedTemplate!.Id;
            _validationErrors = TemplateService.Validate(_selectedTemplate)
                .Where(i => i.Severity == TemplateIssueSeverity.Error)
                .ToList();
            _parameterValues = TemplateService.CreateDefaultParameterValues(_selectedTemplate);
            _testResult = null;

            var extension = string.IsNullOrWhiteSpace(_selectedTemplate.OutputExtension)
                ? "mp4"
                : _selectedTemplate.OutputExtension.TrimStart('.');
            _autoOutputHint = BuildAutoNamePreview(extension);
        }
        else if (_selectedTemplate == null && _validatedTemplateId != null)
        {
            _validatedTemplateId = null;
            _validationErrors = [];
            _parameterValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }

        if (!string.Equals(_inputPath, _lastProbedPath, StringComparison.Ordinal))
        {
            _lastProbedPath = _inputPath;
            await ProbeMediaAsync();
        }

        await RebuildPreviewAsync();
    }

    private string BuildAutoNamePreview(string extension)
    {
        var baseName = string.IsNullOrWhiteSpace(_inputPath)
            ? "输入文件名"
            : Path.GetFileNameWithoutExtension(_inputPath);

        return _namingRule == OutputNamingRule.Suffix
            ? $"{baseName}{_namingSuffix}.{extension}"
            : $"{baseName}.{extension}";
    }

