@page "/templates"
@using LiteDB
@inject ITemplateService TemplateService
@inject IHardwareDetectionService HardwareDetection
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>模板管理 - @AppInfo.Name</PageTitle>

<div class="ffui-container">
    <div class="page-head">
        <div class="page-head-text">
            <h1>📋 模板管理</h1>
            <p class="page-sub">浏览、筛选并预览模板；点「选择」会带着该模板打开转换页面。</p>
        </div>
        <div class="head-counts">
            <span class="ffui-badge">全部 @_templates.Count</span>
            <span class="ffui-badge ffui-badge-info">系统预设 @_systemCount</span>
            <span class="ffui-badge ffui-badge-primary">我的模板 @_userCount</span>
        </div>
    </div>

    <div class="alert-stack">
        @if (!string.IsNullOrEmpty(_syncSummary))
        {
            <div class="ffui-alert @(_syncChanged ? "ffui-alert-success" : "ffui-alert-info")" role="status">
                <span aria-hidden="true">@(_syncChanged ? "✅" : "ℹ️")</span>
                <span>@_syncSummary（每次打开本页都会自动同步一次系统预设）</span>
            </div>
        }

        <div class="ffui-alert @(_capabilityWarning ? "ffui-alert-warning" : "ffui-alert-info")" role="status">
            <span aria-hidden="true">@(_capabilityWarning ? "⚠️" : "🚀")</span>
            <span>@_capabilityText</span>
        </div>
    </div>

    <div class="head-actions">
        <button type="button" class="ffui-btn ffui-btn-primary" @onclick="OpenCreateEditor">
            ➕ 创建模板
        </button>
        <button type="button" class="ffui-btn" @onclick="ExportAsync" disabled="@(_isExporting || _templates.Count == 0)">
            ⬇️ 导出全部
        </button>
        <button type="button" class="ffui-btn" @onclick="ExportFilteredAsync"
                disabled="@(_isExporting || _cards.Count == 0)">
            ⬇️ 导出当前筛选结果（@_cards.Count）
        </button>
        <button type="button" class="ffui-btn" @onclick="OpenImport">
            📥 导入
        </button>
    </div>

    <div class="ffui-panel toolbar">
        <div class="toolbar-row">
            <label class="field search-field">
                <span class="field-label">搜索</span>
                <input type="search" placeholder="搜索名称、描述、分类、标签…"
                       aria-label="搜索模板" value="@_searchInput" @oninput="OnSearchInputAsync" />
            </label>

            <label class="field">
                <span class="field-label">分类</span>
                <select aria-label="按分类筛选" @bind="_selectedCategory" @bind:after="RebuildView">
                    <option value="">全部分类</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>

            <label class="field">
                <span class="field-label">排序</span>
                <select aria-label="排序方式" @bind="_sortMode" @bind:after="RebuildView">
                    <option value="recommended">推荐优先</option>
                    <option value="name">名称</option>
                    <option value="updated">最近修改</option>
                </select>
            </label>

            <label class="switch">
                <input type="checkbox" @bind="_onlyAvailable" @bind:after="RebuildView" />
                只看本机可用的模板
            </label>

            <div class="seg" role="group" aria-label="视图切换">
                <button type="button" class="ffui-btn ffui-btn-sm @(_layout == "flat" ? "ffui-btn-primary" : "")"
                        aria-pressed='@(_layout == "flat")' aria-label="平铺显示" title="平铺显示"
                        @onclick='() => SetLayout("flat")'>
                    ▦ 平铺
                </button>
                <button type="button" class="ffui-btn ffui-btn-sm @(_layout == "group" ? "ffui-btn-primary" : "")"
                        aria-pressed='@(_layout == "group")' aria-label="按分类分组显示" title="按分类分组显示"
                        @onclick='() => SetLayout("group")'>
                    ☰ 分组
                </button>
            </div>
        </div>

        <p class="result-count" aria-live="polite">
            @if (_isLoading)
            {
                <span>正在加载模板…</span>
            }
            else
            {
                <span>@_cards.Count 个模板符合当前条件（共 @_templates.Count 个）</span>
            }
        </p>
    </div>

    @if (_isLoading)
    {
        <div class="ffui-loading-row" aria-busy="true">
            <span class="spinner" aria-hidden="true"></span>
            <span>正在加载模板…</span>
        </div>
    }
    else if (_cards.Count == 0)
    {
        <div class="ffui-panel ffui-empty-state">
            @if (_templates.Count == 0)
            {
                <p>还没有任何模板，先创建一个吧。</p>
                <button type="button" class="ffui-btn ffui-btn-primary" @onclick="OpenCreateEditor">创建第一个模板</button>
            }
            else
            {
                <p>没有找到匹配的模板。</p>
                <button type="button" class="ffui-btn" @onclick="ResetFilters">清除筛选条件</button>
            }
        </div>
    }
    else if (_layout == "group")
    {
        @foreach (var group in _groups)
        {
            <section class="group" @key="group.Category">
                <h2 class="ffui-section-title">
                    @group.Category
                    <span class="ffui-badge">@group.Templates.Count</span>
                </h2>
                <div class="template-grid">
                    @foreach (var card in group.Templates)
                    {
                        <TemplateCard @key="card.Template.Id"
                                      Template="card.Template"
                                      IsSelected="@(_selectedId == card.Template.Id)"
                                      IsAvailable="card.IsAvailable"
                                      UnavailableReason="card.UnavailableReason"
                                      SelectedEncoderName="card.SelectedEncoderName"
                                      ShowSystemBadges="true"
                                      OnSelect="SelectTemplateAsync"
                                      OnEdit="OpenEditEditor"
                                      OnDelete="RequestDelete"
                                      OnView="OpenViewer"
                                      OnCopy="CopyTemplateAsync" />
                    }
                </div>
            </section>
        }
    }
    else
    {
        <div class="template-grid">
            @foreach (var card in _cards)
            {
                <TemplateCard @key="card.Template.Id"
                              Template="card.Template"
                              IsSelected="@(_selectedId == card.Template.Id)"
                              IsAvailable="card.IsAvailable"
                              UnavailableReason="card.UnavailableReason"
                              SelectedEncoderName="card.SelectedEncoderName"
                              ShowSystemBadges="true"
                              OnSelect="SelectTemplateAsync"
                              OnEdit="OpenEditEditor"
                              OnDelete="RequestDelete"
                              OnView="OpenViewer"
                              OnCopy="CopyTemplateAsync" />
            }
        </div>
    }
</div>

<TemplateDetailViewer Template="_viewing"
                      IsOpen="_viewerOpen"
                      IsOpenChanged="OnViewerOpenChanged"
                      OnCopy="CopyTemplateAsync"
                      OnEdit="OpenEditEditor"
                      OnUse="SelectTemplateAsync" />

<TemplateEditor Template="_editorTemplate"
                IsOpen="_editorOpen"
                IsOpenChanged="OnEditorOpenChanged"
                IsSystem="_editorIsSystem"
                OnSaved="OnTemplateSaved" />

<Modal IsOpen="_importOpen" IsOpenChanged="OnImportOpenChanged" Title="导入模板" Size="lg"
       DisableClose="@_isImporting" CloseOnBackdrop="@(!_isImporting)">
    <p class="modal-hint">
        把「导出」得到的 JSON 内容粘贴到下面。浏览器出于安全限制不允许页面直接读取剪贴板，
        请手动粘贴（⌘/Ctrl + V）。
    </p>
    <textarea class="import-json" rows="10" aria-label="模板 JSON 内容"
              placeholder="在此粘贴包含 templates 数组的 JSON"
              @bind="_importJson" @bind:event="oninput"></textarea>

    <label class="switch import-switch">
        <input type="checkbox" @bind="_importAsSystem" />
        导入为系统模板（高级选项）
    </label>
    @if (_importAsSystem)
    {
        <div class="ffui-alert ffui-alert-warning" role="alert">
            <span aria-hidden="true">⚠️</span>
            <span>
                导入为系统模板后，这些模板会进入「系统预设」分组，并可能在后续的系统预设同步或重置时
                被内置预设覆盖、删除。只在明确知道用途时启用。
            </span>
        </div>
    }

    <div class="ffui-modal-footer">
        <button type="button" class="ffui-btn" disabled="@_isImporting" @onclick="CloseImport">取消</button>
        <button type="button" class="ffui-btn ffui-btn-primary" disabled="@_isImporting" @onclick="ImportAsync">
            @if (_isImporting)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            导入
        </button>
    </div>
</Modal>

<ConfirmDialog IsOpen="_deleteOpen"
               IsOpenChanged="OnDeleteOpenChanged"
               Danger="true"
               Title="@_deleteTitle"
               Message="@_deleteMessage"
               Detail="@_deleteDetail"
               ConfirmText="@_deleteConfirmText"
               OnConfirm="ConfirmDeleteAsync" />

<style>
    .page-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--spacing-3);
        margin-bottom: var(--spacing-4);
    }

    .page-head h1 {
        margin: 0;
    }

    .page-sub {
        margin: 0.25rem 0 0;
        color: var(--text-muted);
        font-size: 0.88rem;
    }

    .head-counts {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-2);
    }

    .alert-stack {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-2);
        margin-bottom: var(--spacing-4);
    }

    .head-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-2);
        margin-bottom: var(--spacing-4);
    }

    .toolbar {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3);
        margin-bottom: var(--spacing-4);
    }

    .toolbar-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--spacing-3);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 170px;
    }

    .field-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
    }

    .search-field {
        flex: 1 1 260px;
    }

    .switch {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
