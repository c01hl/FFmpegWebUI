        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: var(--spacing-3);
    }

    .group {
        margin-bottom: var(--spacing-5);
    }

    .modal-hint {
        margin: 0 0 var(--spacing-3);
        color: var(--text-secondary);
        font-size: 0.88rem;
    }

    .import-json {
        font-family: var(--font-mono);
        font-size: 0.85rem;
    }

    .import-switch {
        margin-top: var(--spacing-3);
        padding-bottom: 0;
    }
</style>

@code {
    private sealed record CardState(
        CommandTemplate Template,
        bool? IsAvailable,
        string? UnavailableReason,
        string? SelectedEncoderName);

    private sealed class TemplateGroup(string category)
    {
        public string Category { get; } = category;
        public List<CardState> Templates { get; } = [];
    }

    private List<CommandTemplate> _templates = [];
    private List<string> _categories = [];
    private List<CardState> _cards = [];
    private List<TemplateGroup> _groups = [];

    private HardwareDetectionReport? _report;
    private bool _hardwareDetected;
    private HashSet<string> _availableEncoders = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<(string Codec, string Required), string?> _encoderCache = new();
    private bool _encoderCacheWarned;

    private string _syncSummary = string.Empty;
    private bool _syncChanged;
    private string _capabilityText = "正在检测本机可用的硬件编码器…";
    private bool _capabilityWarning;

    private string _searchInput = string.Empty;
    private string _searchText = string.Empty;
    private CancellationTokenSource? _searchDebounce;
    private string _selectedCategory = string.Empty;
    private string _sortMode = "recommended";
    private string _layout = "flat";
    private bool _onlyAvailable;
    private bool _isLoading = true;
    private bool _isExporting;
    private bool _isImporting;

    private CommandTemplate? _editorTemplate;
    private bool _editorOpen;
    private bool _editorIsSystem;

    private CommandTemplate? _viewing;
    private bool _viewerOpen;

    private CommandTemplate? _deleteTarget;
    private bool _deleteOpen;

    private bool _importOpen;
    private string _importJson = string.Empty;
    private bool _importAsSystem;

    private ObjectId? _selectedId;

    private int _systemCount => _templates.Count(t => t.Type == TemplateType.System);
    private int _userCount => _templates.Count(t => t.Type == TemplateType.User);

    private bool DeleteTargetIsSystem => _deleteTarget?.Type == TemplateType.System;

    private string _deleteTitle => DeleteTargetIsSystem ? "删除系统预设模板" : "删除模板";

    private string _deleteMessage => _deleteTarget is null
        ? string.Empty
        : DeleteTargetIsSystem
            ? $"「{_deleteTarget.Name}」是系统预设模板，无法在这里删除。"
            : $"确定要删除模板「{_deleteTarget.Name}」吗？此操作不可撤销。";

    private string? _deleteDetail => _deleteTarget is null
        ? null
        : DeleteTargetIsSystem
            ? "删除系统预设请前往「预设模板管理」页面；即使在那里删除，只要它仍然存在于内置预设列表中，" +
              "下次系统预设同步（应用升级或重置）时它还会重新出现。"
            : "删除只影响模板本身，已经用它执行过的任务记录不会受影响。";

    private string _deleteConfirmText => DeleteTargetIsSystem ? "前往管理页面" : "删除";

    // ────────────────────────────────────────────────────────────────
    // 初始化
    // ────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sync = await TemplateService.InitializeSystemTemplatesAsync();
            _syncSummary = sync?.Summary ?? $"系统模板已是最新（预设 v{TemplateService.PresetVersion}）";
            _syncChanged = sync?.Changed == true;
        }
        catch (Exception ex)
        {
            _syncSummary = string.Empty;
            Toast.Error($"同步系统预设模板失败：{ex.Message}");
        }

        await DetectHardwareAsync();
        await LoadTemplatesAsync();
    }

    public void Dispose()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = null;
    }

    private async Task DetectHardwareAsync()
    {
        try
        {
            _report = await HardwareDetection.DetectAsync();
            _availableEncoders = _report.Encoders
                .Where(e => e.IsAvailable)
                .Select(e => e.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _hardwareDetected = true;

            _capabilityText = string.IsNullOrWhiteSpace(_report.Summary)
                ? (_report.HasHardwareAcceleration
                    ? $"检测到 {_report.AvailableHardwareEncoders.Count} 个可用的硬件编码器。"
                    : "本机未检测到可用的硬件编码器，仅软件编码可用。")
                : _report.Summary;
            _capabilityWarning = !_report.HasHardwareAcceleration;

            if (!string.IsNullOrWhiteSpace(_report.FFmpegVersion))
            {
                _capabilityText += $"（检测于 FFmpeg {_report.FFmpegVersion}）";
            }
        }
        catch (Exception ex)
        {
            _report = null;
            _hardwareDetected = false;
            _availableEncoders.Clear();
            _capabilityText = $"硬件检测失败，暂时无法判断哪些模板可在本机运行：{ex.Message}";
            _capabilityWarning = true;
            Toast.Warning($"硬件检测失败，模板可用性将显示为「未知」：{ex.Message}");
        }
    }

    private async Task LoadTemplatesAsync()
    {
        _isLoading = true;
        try
        {
            _templates = await TemplateService.GetAllTemplatesAsync();
            _categories = await TemplateService.GetCategoriesAsync();
            await EnsureEncoderCacheAsync();
        }
        catch (Exception ex)
        {
            _templates = [];
            _categories = [];
            Toast.Error($"加载模板失败：{ex.Message}");
        }
        finally
        {
            _isLoading = false;
            RebuildView();
        }
    }

    /// <summary>
    /// 硬件检测完成后一次性算好「自动模式实际会用到的编码器」，
    /// 渲染每张卡片时只查字典，不再逐行调用服务。
    /// </summary>
    private async Task EnsureEncoderCacheAsync()
    {
        if (!_hardwareDetected) return;

        foreach (var template in _templates)
        {
            if (template.HardwareMode != HardwareAccelerationMode.Auto) continue;
            if (!UsesEncoderPlaceholder(template)) continue;

            var codec = ResolveCodec(template);
            var key = (Codec: codec, Required: template.RequiredEncoder ?? string.Empty);
            if (_encoderCache.ContainsKey(key)) continue;

            try
            {
                _encoderCache[key] = await HardwareDetection.GetRecommendedEncoderAsync(codec, template.RequiredEncoder);
            }
            catch (Exception ex)
            {
                _encoderCache[key] = null;
                if (!_encoderCacheWarned)
                {
                    _encoderCacheWarned = true;
                    Toast.Warning($"无法推算模板实际使用的编码器：{ex.Message}");
                }
            }
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 列表：筛选 / 排序 / 分组
    // ────────────────────────────────────────────────────────────────

    private void RebuildView()
    {
        IEnumerable<CommandTemplate> query = _templates;

        var search = _searchText.Trim();
        if (search.Length > 0)
        {
            query = query.Where(t => Matches(t, search));
        }

        if (!string.IsNullOrWhiteSpace(_selectedCategory))
        {
            query = query.Where(t => string.Equals(t.Category, _selectedCategory, StringComparison.CurrentCulture));
        }

        var cards = query.Select(BuildCardState).ToList();

        // 「只看本机可用」只保留已经确认可用的模板（未知状态不算可用）
        if (_onlyAvailable)
        {
            cards = cards.Where(c => c.IsAvailable == true).ToList();
        }

        _cards = _sortMode switch
        {
            "name" => cards
                .OrderBy(c => c.Template.Name, StringComparer.CurrentCulture)
                .ToList(),
            "updated" => cards
                .OrderByDescending(c => c.Template.UpdatedAt)
                .ThenBy(c => c.Template.Name, StringComparer.CurrentCulture)
                .ToList(),
            _ => cards
                .OrderByDescending(c => c.Template.IsRecommended)
                .ThenBy(c => c.Template.SortOrder)
                .ThenBy(c => c.Template.Name, StringComparer.CurrentCulture)
                .ToList()
        };

        var groups = new List<TemplateGroup>();
        foreach (var card in _cards)
        {
            var category = string.IsNullOrWhiteSpace(card.Template.Category) ? "未分类" : card.Template.Category;
            var group = groups.FirstOrDefault(g => string.Equals(g.Category, category, StringComparison.CurrentCulture));
            if (group is null)
            {
                group = new TemplateGroup(category);
                groups.Add(group);
            }
            group.Templates.Add(card);
        }
        _groups = groups;
    }

    private CardState BuildCardState(CommandTemplate template)
    {
        // 必须使用硬件加速：只有本机确实存在该族编码器时才算可用
        if (template.HardwareMode == HardwareAccelerationMode.Required)
        {
            var required = template.RequiredEncoder;
            if (string.IsNullOrWhiteSpace(required))
            {
                return new CardState(template, false,
                    "该模板要求硬件加速，但没有指定编码器族，无法在本机使用。", null);
            }

            if (!_hardwareDetected)
            {
                return new CardState(template, null,
                    "硬件检测未完成，无法确认该模板是否可以在本机运行。", null);
            }

            if (IsEncoderSatisfied(required))
            {
                var member = EncoderCatalog.ExpandFamily(required)
                    .FirstOrDefault(name => _availableEncoders.Contains(name));
                return new CardState(template, true, null, DisplayEncoderName(member));
            }

            var family = EncoderCatalog.Find(required)?.Family ?? required;
            return new CardState(template, false,
                $"未检测到可用的 {EncoderCatalog.FamilyDisplayName(family)} 编码器，本机无法使用该模板。", null);
        }

        // 自动模式：硬件不可用时自动回退到软件编码，所以始终可用
        if (template.HardwareMode == HardwareAccelerationMode.Auto)
        {
            string? selected = null;
            if (_hardwareDetected && UsesEncoderPlaceholder(template))
            {
                var key = (Codec: ResolveCodec(template), Required: template.RequiredEncoder ?? string.Empty);
                if (_encoderCache.TryGetValue(key, out var name) && !string.IsNullOrEmpty(name))
                {
                    selected = DisplayEncoderName(name);
                }
            }
            return new CardState(template, true, null, selected);
        }

        return new CardState(template, true, null, null);
    }

    private static bool Matches(CommandTemplate template, string search)
    {
        if (Contains(template.Name, search)) return true;
        if (Contains(template.Description, search)) return true;
        if (Contains(template.Category, search)) return true;
        if (Contains(template.OutputExtension, search)) return true;
        if (Contains(template.RequiredEncoder, search)) return true;
        return template.Tags.Any(tag => Contains(tag, search));
    }

    private static bool Contains(string? source, string search) =>
        !string.IsNullOrEmpty(source) && source.Contains(search, StringComparison.OrdinalIgnoreCase);

    private static bool UsesEncoderPlaceholder(CommandTemplate template)
    {
        var args = template.CommandArgs ?? string.Empty;
        return args.Contains("{encoder}", StringComparison.OrdinalIgnoreCase)
            || args.Contains("{quality_args}", StringComparison.OrdinalIgnoreCase)
            || args.Contains("{preset_args}", StringComparison.OrdinalIgnoreCase)
            || args.Contains("{hwupload_args}", StringComparison.OrdinalIgnoreCase);
    }

    private static string ResolveCodec(CommandTemplate template)
    {
        var codec = string.IsNullOrWhiteSpace(template.TargetCodec) ? template.OutputExtension : template.TargetCodec;
        return HardwareDetectionService.NormalizeCodec(codec);
    }

    private bool IsEncoderSatisfied(string required) =>
        EncoderCatalog.ExpandFamily(required).Any(name => _availableEncoders.Contains(name));

    private static string? DisplayEncoderName(string? encoderName) =>
        string.IsNullOrEmpty(encoderName) ? null : EncoderCatalog.Find(encoderName)?.DisplayName ?? encoderName;

    // ────────────────────────────────────────────────────────────────
    // 交互
    // ────────────────────────────────────────────────────────────────

    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        _searchInput = args.Value?.ToString() ?? string.Empty;

        var previous = _searchDebounce;
        previous?.Cancel();
        previous?.Dispose();

        var cts = new CancellationTokenSource();
        _searchDebounce = cts;

        try
        {
            await Task.Delay(250, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested) return;

        _searchText = _searchInput;
        RebuildView();
        await InvokeAsync(StateHasChanged);
    }

    private void ResetFilters()
    {
        _searchInput = string.Empty;
        _searchText = string.Empty;
        _selectedCategory = string.Empty;
        _onlyAvailable = false;
        RebuildView();
    }

    private void SetLayout(string layout)
    {
        _layout = layout;
        RebuildView();
    }

    private void OpenCreateEditor()
    {
        _editorTemplate = new CommandTemplate();
        _editorIsSystem = false;
        _editorOpen = true;
    }

    private void OpenEditEditor(CommandTemplate template)
    {
        if (template is null) return;
        _editorTemplate = CloneTemplate(template);
        _editorIsSystem = template.Type == TemplateType.System;
        _editorOpen = true;
    }

    private void OnEditorOpenChanged(bool open)
    {
        _editorOpen = open;
    }

    private async Task OnTemplateSaved(CommandTemplate template)
    {
        _editorOpen = false;
        Toast.Success($"模板「{template?.Name}」已保存");
        await LoadTemplatesAsync();
    }

    private void OpenViewer(CommandTemplate template)
    {
        if (template is null) return;
        _viewing = template;
        _viewerOpen = true;
    }

    private void OnViewerOpenChanged(bool open)
    {
        _viewerOpen = open;
    }

    /// <summary>TPL-1：带着模板跳转到转换页面（/convert?template=&lt;id&gt;）。</summary>
    private async Task SelectTemplateAsync(CommandTemplate template)
    {
        if (template is null) return;

        _selectedId = template.Id;
        Toast.Success($"已打开转换页面，模板已预选：{template.Name}");

        try
        {
            Navigation.NavigateTo($"/convert?template={template.Id}");
        }
        catch (Exception ex)
        {
            Toast.Error($"打开转换页面失败：{ex.Message}");
        }

        await Task.CompletedTask;
    }

    private async Task CopyTemplateAsync(CommandTemplate template)
    {
        if (template is null) return;
        try
        {
            var copy = await TemplateService.CopyTemplateAsync(template.Id);
            Toast.Success($"已复制为「{copy.Name}」");
            await LoadTemplatesAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"复制模板失败：{ex.Message}");
        }
    }

    private void RequestDelete(CommandTemplate template)
    {
        if (template is null) return;
        _deleteTarget = template;
        _deleteOpen = true;
    }

    private void OnDeleteOpenChanged(bool open)
    {
        _deleteOpen = open;
        if (!open) _deleteTarget = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var target = _deleteTarget;
        _deleteOpen = false;
        _deleteTarget = null;

        if (target is null) return;

        if (target.Type == TemplateType.System)
        {
            Toast.Warning("系统预设模板不能在这里删除，已跳转到「预设模板管理」页面。");
            try
            {
                Navigation.NavigateTo("/templates-admin");
            }
            catch (Exception ex)
            {
                Toast.Error($"跳转失败，请手动打开 /templates-admin：{ex.Message}");
            }
            return;
        }

        try
        {
            var deleted = await TemplateService.DeleteTemplateAsync(target.Id);
            if (deleted)
            {
                Toast.Success($"模板「{target.Name}」已删除");
                await LoadTemplatesAsync();
            }
            else
            {
                Toast.Error($"删除失败：服务没有删除「{target.Name}」，它可能已经被删除，或它是系统预设模板。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"删除模板失败：{ex.Message}");
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 导入 / 导出
    // ────────────────────────────────────────────────────────────────

    private Task ExportAsync() => ExportCoreAsync(_templates, filtered: false);

    private Task ExportFilteredAsync() => ExportCoreAsync(_cards.Select(c => c.Template).ToList(), filtered: true);

    private async Task ExportCoreAsync(List<CommandTemplate> templates, bool filtered)
    {
        if (_isExporting) return;

        if (templates.Count == 0)
        {
            Toast.Warning("没有可导出的模板。");
            return;
        }

        _isExporting = true;
        try
        {
            var json = TemplateService.ExportToJson(templates);
            var fileName = $"ffmpegwebui-templates-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            var saved = await JS.InvokeAsync<bool>("ffui.saveTextFile", fileName, json, "application/json");

            if (saved)
            {
                var scopeText = filtered ? "当前筛选结果" : "全部模板";
                Toast.Success($"已导出{scopeText} {templates.Count} 个到 {fileName}");
            }
            else
            {
                Toast.Error("导出失败：浏览器没有触发下载，请检查浏览器的下载权限或拦截设置。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"导出失败：{ex.Message}");
        }
        finally
        {
            _isExporting = false;
        }
    }

    private void OpenImport()
    {
        _importJson = string.Empty;
        _importAsSystem = false;
        _importOpen = true;
    }

    private void CloseImport()
    {
        _importOpen = false;
    }

    private void OnImportOpenChanged(bool open)
    {
        _importOpen = open;
    }

    private async Task ImportAsync()
    {
        if (_isImporting) return;

        var json = (_importJson ?? string.Empty).Trim();
        if (json.Length == 0)
        {
            Toast.Warning("请先粘贴模板 JSON 内容。");
            return;
        }

        _isImporting = true;
        try
        {
            var imported = await TemplateService.ImportFromJsonAsync(json, _importAsSystem);
            if (imported > 0)
            {
                Toast.Success(_importAsSystem
                    ? $"已导入 {imported} 个模板（作为系统预设）"
                    : $"已导入 {imported} 个模板");
                _importOpen = false;
                _importJson = string.Empty;
                await LoadTemplatesAsync();
            }
            else
            {
                Toast.Warning("没有导入任何模板：JSON 里没有含 name 与 commandArgs 的模板条目。");
            }
        }
        catch (InvalidOperationException ex)
        {
            Toast.Error($"导入失败：{ex.Message}");
        }
        catch (Exception ex)
        {
            Toast.Error($"导入失败：{ex.Message}");
        }
        finally
        {
            _isImporting = false;
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 工具
    // ────────────────────────────────────────────────────────────────

    private static CommandTemplate CloneTemplate(CommandTemplate source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Description = source.Description,
        CommandArgs = source.CommandArgs,
        Type = source.Type,
        Category = source.Category,
        SupportedInputFormats = [.. source.SupportedInputFormats],
        OutputExtension = source.OutputExtension,
        TargetCodec = source.TargetCodec,
        RequiresHardwareAcceleration = source.RequiresHardwareAcceleration,
        HardwareMode = source.HardwareMode,
        RequiredEncoder = source.RequiredEncoder,
        Parameters = source.Parameters.Select(p => new TemplateParameter
        {
            Name = p.Name,
            Label = p.Label,
            Description = p.Description,
            Kind = p.Kind,
            DefaultValue = p.DefaultValue,
            Options = p.Options.Select(o => new TemplateParameterOption(o.Value, o.Label, o.Description)).ToList(),
            Min = p.Min,
            Max = p.Max,
            TrueValue = p.TrueValue,
            FalseValue = p.FalseValue
        }).ToList(),
        Tags = [.. source.Tags],
        IsRecommended = source.IsRecommended,
        PresetVersion = source.PresetVersion,
        CreatedAt = source.CreatedAt,
        UpdatedAt = source.UpdatedAt,
        SortOrder = source.SortOrder
    };
}
