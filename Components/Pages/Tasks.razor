    }

    private static string StartedAtText(ConversionTask task) =>
        task.StartedAt.HasValue ? task.StartedAt.Value.ToLocalTime().ToString("HH:mm:ss") : "-";

    private static string RunningElapsed(ConversionTask task) =>
        task.StartedAt.HasValue ? FormatSeconds((DateTime.UtcNow - task.StartedAt.Value).TotalSeconds) : "-";

    private static string FormatDuration(ConversionTask task) =>
        task.DurationSeconds is double seconds ? FormatSeconds(seconds) : "-";

    private static string FormatSeconds(double seconds)
    {
        if (seconds <= 0) return "-";
        var span = TimeSpan.FromSeconds(seconds);
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:D2}:{span.Seconds:D2}"
            : $"{span.Minutes:D2}:{span.Seconds:D2}";
    }

    /// <summary>单条任务的实时日志缓冲：最多保留 800 行，超出后整块重建，避免字符串无限增长</summary>
    private sealed class LogBuffer
    {
        private const int MaxLines = 800;

        private readonly List<string> _lines = new(MaxLines + 32);

        public string Text { get; private set; } = string.Empty;

        public void Append(string? line)
        {
            if (string.IsNullOrEmpty(line)) return;

            _lines.Add(line);
            if (_lines.Count > MaxLines)
            {
                // 超出上限：丢掉最旧的部分并整块重建
                _lines.RemoveRange(0, _lines.Count - MaxLines);
                Text = string.Join(Environment.NewLine, _lines);
            }
            else
            {
                Text = Text.Length == 0 ? line : Text + Environment.NewLine + line;
            }
        }

        public void Replace(string? text)
        {
            _lines.Clear();
            Text = string.Empty;
            if (string.IsNullOrWhiteSpace(text)) return;

            foreach (var part in text.Replace("\r\n", "\n").Split('\n'))
            {
                if (part.Length > 0) _lines.Add(part);
            }

            if (_lines.Count > MaxLines) _lines.RemoveRange(0, _lines.Count - MaxLines);
            Text = string.Join(Environment.NewLine, _lines);
        }
    }
