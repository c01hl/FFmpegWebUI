@page "/tasks"
@using LiteDB
@inject ITaskService TaskService
@inject IFileService FileService
@inject IToastService Toast
@inject IJSRuntime JS
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>任务列表 - @AppInfo.Name</PageTitle>

<div class="ffui-container tasks">
    <header class="page-head">
        <h1>🗂️ 任务列表</h1>
        <span class="ffui-badge">运行中 @TaskService.ActiveCount · 排队 @TaskService.QueuedCount</span>
        <span class="spacer"></span>
        <button type="button" class="ffui-btn ffui-btn-sm" disabled="@_isRefreshing" @onclick="() => RefreshAsync(true)">
            @if (_isRefreshing)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            🔄 刷新
        </button>
    </header>

    <!-- ── 进行中 ─────────────────────────────────────────────── -->
    <section class="ffui-panel">
        <h2 class="ffui-section-title">
            <span>🚀 进行中</span>
            <span class="ffui-badge">@_runningTasks.Count</span>
        </h2>

        @if (_runningTasks.Count == 0)
        {
            <div class="ffui-empty-state">
                当前没有正在执行的转换。
                <div class="empty-actions">
                    <a class="ffui-btn ffui-btn-primary ffui-btn-sm" href="convert">开始转换</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var task in _runningTasks)
            {
                <article class="task-card" @key="task.Id">
                    <div class="task-head">
                        <span class="task-name ellipsis" title="@task.InputPath">@Path.GetFileName(task.InputPath)</span>
                        <span class="arrow" aria-hidden="true">➜</span>
                        <span class="task-output ellipsis" title="@task.OutputPath">@Path.GetFileName(task.OutputPath)</span>
                        <span class="ffui-badge ffui-badge-info">运行中</span>
                        @if (!string.IsNullOrWhiteSpace(task.TemplateName))
                        {
                            <span class="muted">@task.TemplateName</span>
                        }
                    </div>

                    <ProgressBar Progress="task.Progress"
                                 Speed="task.ProcessingSpeed"
                                 Eta="task.EstimatedTimeRemaining"
                                 CurrentTime="task.CurrentTime"
                                 TotalDuration="task.TotalDuration"
                                 Status="task.Status"
                                 Label="转换进度" />

                    <div class="meta-row">
                        <span class="muted">开始于 @StartedAtText(task)</span>
                        <span class="muted">已运行 @RunningElapsed(task)</span>
                        <span class="muted">输入 @FileService.FormatFileSize(task.InputFileSize)</span>
                    </div>

                    <div class="row-actions">
                        <button type="button" class="ffui-btn ffui-btn-sm"
                                title="发送 q 让 FFmpeg 写完文件尾再退出，已产出的文件仍然可用"
                                @onclick="() => GracefulStopAsync(task.Id)">
                            ⏏️ 优雅停止
                        </button>
                        <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger"
                                title="立即结束 FFmpeg 进程，未完成的输出文件会被清理"
                                @onclick="() => ForceStopAsync(task.Id)">
                            ❌ 强制终止
                        </button>
                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => ToggleLogAsync(task)">
                            @(IsExpanded(task.Id) ? "▲ 收起日志" : "▼ 查看日志")
                        </button>
                    </div>

                    @if (IsExpanded(task.Id))
                    {
                        <div class="log-wrap">
                            @if (HasLog(task.Id))
                            {
                                <LogViewer LogText="@GetLogText(task.Id)" MaxHeight="320px" />
                            }
                            else
                            {
                                <p class="muted">还没有日志输出。</p>
                            }
                        </div>
                    }
                </article>
            }
        }
    </section>

    <!-- ── 等待中 ─────────────────────────────────────────────── -->
    <section class="ffui-panel">
        <h2 class="ffui-section-title">
            <span>⏳ 等待中</span>
            <span class="ffui-badge">@_pendingTasks.Count</span>
        </h2>

        @if (_pendingTasks.Count == 0)
        {
            <div class="ffui-empty-state">队列里没有等待中的任务。</div>
        }
        else
        {
            <ul class="pending-list">
                @foreach (var task in _pendingTasks)
                {
                    <li class="pending-item" @key="task.Id">
                        <div class="pending-info">
                            <span class="ellipsis" title="@task.InputPath">@Path.GetFileName(task.InputPath)</span>
                            <span class="muted">创建于 @task.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                        </div>
                        <div class="row-actions">
                            <span class="ffui-badge">等待中</span>
                            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => CancelPendingAsync(task.Id)">取消排队</button>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <!-- ── 历史记录 ───────────────────────────────────────────── -->
    <section class="ffui-panel">
        <h2 class="ffui-section-title">
            <span>📜 历史记录</span>
            <span class="ffui-badge" aria-live="polite">@HistoryCountText()</span>
        </h2>

        <div class="filters">
            <label class="filter-field">
                <span class="filter-label">状态</span>
                <select class="filter-control" @bind="_statusFilter" @bind:after="OnFilterChangedAsync">
                    <option value="">全部</option>
                    <option value="Running">运行中</option>
                    <option value="Pending">等待中</option>
                    <option value="Completed">已完成</option>
                    <option value="Failed">失败</option>
                    <option value="Cancelled">已取消</option>
                    <option value="Skipped">已跳过</option>
                </select>
            </label>

            <label class="filter-field grow">
                <span class="filter-label">文件名</span>
                <input type="search" class="filter-control" placeholder="按文件名筛选"
                       @bind="_filenameFilter" @bind:event="oninput" @bind:after="OnFilterChanged" />
            </label>

            <label class="filter-field">
                <span class="filter-label">显示条数</span>
                <select class="filter-control" @bind="_limit" @bind:after="OnFilterChangedAsync">
                    <option value="50">50</option>
                    <option value="100">100</option>
                    <option value="500">500</option>
                </select>
            </label>

            <label class="filter-field">
                <span class="filter-label">排序</span>
                <select class="filter-control" @bind="_sortOrder" @bind:after="OnFilterChanged">
                    <option value="newest">最新优先</option>
                    <option value="oldest">最早优先</option>
                </select>
            </label>

            <button type="button" class="ffui-btn ffui-btn-sm" disabled="@_isRefreshing" @onclick="() => RefreshAsync(true)">🔄 刷新</button>
        </div>

        <div class="bulk-bar">
            <span class="muted">批量操作</span>
            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => AskBulk(BulkAction.RetryAllFailed)">
                ♻️ 重试全部失败任务
            </button>
            <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger" @onclick="() => AskBulk(BulkAction.ClearFailedAndCancelled)">
                🧹 清理失败与取消的任务
            </button>
            <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger" @onclick="() => AskBulk(BulkAction.ClearHistory)">
                🗑️ 清空历史
            </button>
        </div>

        @if (_visibleHistory.Count == 0)
        {
            <div class="ffui-empty-state">
                @HistoryEmptyText()
                @if (_historyTasks.Count == 0)
                {
                    <div class="empty-actions">
                        <a class="ffui-btn ffui-btn-primary ffui-btn-sm" href="convert">去「转换」页开始第一个</a>
                        <a class="ffui-btn ffui-btn-sm" href="batch">批量处理</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th scope="col">输入文件</th>
                            <th scope="col">输出文件</th>
                            <th scope="col">状态</th>
                            <th scope="col">耗时</th>
                            <th scope="col">创建时间</th>
                            <th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in _visibleHistory)
                        {
                            <tr class="@RowCss(task.Status)" @key="task.Id">
                                <td class="ellipsis" title="@task.InputPath">@Path.GetFileName(task.InputPath)</td>
                                <td class="ellipsis" title="@task.OutputPath">@Path.GetFileName(task.OutputPath)</td>
                                <td>
                                    <span class="ffui-badge @StatusBadgeClass(task.Status)">@StatusText(task.Status)</span>
                                </td>
                                <td>@FormatDuration(task)</td>
                                <td>@task.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                <td class="actions-cell">
                                    <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => ToggleLogAsync(task)">
                                        @(IsExpanded(task.Id) ? "收起" : "日志")
                                    </button>
                                    @if (IsFinished(task.Status))
                                    {
                                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => RetryAsync(task.Id)">重试</button>
                                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => OpenOutputFolderAsync(task)">打开输出目录</button>
                                    }
                                    <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => CopyCommandAsync(task)">复制命令</button>
                                    @if (task.Status == TaskStatus.Failed)
                                    {
                                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => CopyErrorAsync(task)">复制错误信息</button>
                                    }
                                </td>
                            </tr>

                            @if (IsExpanded(task.Id))
                            {
                                <tr class="detail-row" @key="DetailKey(task)">
                                    <td colspan="6">
                                        <div class="detail">
                                            <div class="detail-grid">
                                                <div class="detail-item">
                                                    <span class="label">输入路径</span>
                                                    <span class="value mono">@OrDash(task.InputPath)</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="label">输出路径</span>
                                                    <span class="value mono">@OrDash(task.OutputPath)</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="label">模板</span>
                                                    <span class="value">@OrDash(task.TemplateName)</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="label">输入 / 输出大小</span>
                                                    <span class="value">@SizeText(task)</span>
                                                </div>
                                                <div class="detail-item">
                                                    <span class="label">创建 / 完成时间</span>
                                                    <span class="value">@TimeRangeText(task)</span>
                                                </div>
                                                @if (task.Status == TaskStatus.Skipped)
                                                {
                                                    <div class="detail-item">
                                                        <span class="label">说明</span>
                                                        <span class="value">输出文件已存在，按「文件已存在时的处理方式」的设置跳过。</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(task.ErrorMessage))
                                                {
                                                    <div class="detail-item">
                                                        <span class="label">错误信息</span>
                                                        <span class="value error-text">@task.ErrorMessage</span>
                                                    </div>
                                                }
                                            </div>

                                            @if (HasLog(task.Id))
                                            {
                                                <LogViewer LogText="@GetLogText(task.Id)" MaxHeight="320px" />
                                            }
                                            else
                                            {
                                                <p class="muted">暂无日志输出。</p>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<ConfirmDialog IsOpen="_confirmOpen"
               IsOpenChanged="OnConfirmOpenChanged"
               Title="@BulkTitle"
               Message="@BulkMessage"
               Detail="@BulkDetailText"
               ConfirmText="@BulkConfirmText"
               Danger="@ConfirmDanger"
               IsBusy="@_bulkBusy"
               OnConfirm="ConfirmBulkAsync"
               OnCancel="CancelBulk" />

<style>
    .tasks {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .page-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .page-head h1 { margin: 0; }

    .spacer { flex: 1; }

    .ffui-panel { margin: 0; }

    /* 进行中 */
    .task-card {
        margin-bottom: 0.9rem;
        padding: 0.9rem 1rem;
        background: var(--surface-3);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
    }

    .task-card:last-child { margin-bottom: 0; }

    .task-head {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.6rem;
    }

    .task-name {
        max-width: 320px;
        font-weight: 600;
    }

    .task-output {
        max-width: 320px;
        color: var(--text-secondary);
    }

    .arrow { color: var(--text-muted); }

    .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 1.1rem;
        margin-top: 0.6rem;
        font-size: 0.85rem;
    }

    .row-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        align-items: center;
    }

    .task-card .row-actions { margin-top: 0.75rem; }

    .log-wrap { margin-top: 0.75rem; }

    /* 等待中 */
    .pending-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .pending-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 0.6rem 0.8rem;
        background: var(--surface-3);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
    }

    .pending-info {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }

    /* 筛选与批量操作 */
    .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: flex-end;
        margin-bottom: 0.85rem;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 140px;
    }

    .filter-field.grow { flex: 1 1 220px; }

    .filter-label {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .bulk-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 0.9rem;
        padding: 0.6rem 0.8rem;
        background: var(--surface-3);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
    }

    /* 历史表格 */
    .table-scroll { overflow-x: auto; }

    .history-table {
        width: 100%;
        border-collapse: collapse;
    }

    .history-table th,
    .history-table td {
        padding: 0.6rem 0.7rem;
        text-align: left;
        vertical-align: middle;
        font-size: 0.9rem;
        border-bottom: 1px solid var(--border-color);
    }

    .history-table th {
        background: var(--surface-3);
        color: var(--text-muted);
        font-size: 0.82rem;
        font-weight: 600;
    }

    .history-table tbody tr:hover:not(.detail-row) { background: var(--surface-3); }

    .actions-cell { white-space: nowrap; }

    .row-failed > td:first-child { box-shadow: inset 3px 0 0 var(--danger-color); }
    .row-cancelled > td:first-child { box-shadow: inset 3px 0 0 var(--warning-color); }
    .row-skipped > td:first-child { box-shadow: inset 3px 0 0 var(--warning-color); }

    .detail-row > td { background: var(--surface-3); }

    .detail {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 0.5rem 1rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }

    .detail-item .label {
        font-size: 0.76rem;
        color: var(--text-muted);
    }

    .detail-item .value {
        font-size: 0.86rem;
        color: var(--text-primary);
        word-break: break-all;
    }

    .detail-item .value.error-text { color: var(--danger-color); }

    .mono { font-family: var(--font-mono); }

    .ellipsis {
        display: inline-block;
        max-width: 240px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
    }

    .muted { color: var(--text-muted); }

    .empty-actions {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.7rem;
    }

    @@media (max-width: 768px) {
        .filter-field { min-width: 100%; }
        .ellipsis { max-width: 160px; }
    }
</style>

@code {
    private enum BulkAction
    {
        None,
        RetryAllFailed,
        ClearFailedAndCancelled,
        ClearHistory
    }

    /// <summary>「重试全部失败任务」一次最多扫描的记录数</summary>
    private const int RetryScanLimit = 1000;

    /// <summary>同时缓存的实时日志缓冲上限（避免翻很多条任务后内存一直涨）</summary>
    private const int MaxLogBuffers = 12;

    private static readonly TimeSpan RunningRefreshInterval = TimeSpan.FromSeconds(2);

    /// <summary>状态变化后合并刷新的等待时间</summary>
    private static readonly TimeSpan StatusRefreshDelay = TimeSpan.FromMilliseconds(200);

    private List<ConversionTask> _runningTasks = [];
    private List<ConversionTask> _pendingTasks = [];
    private List<ConversionTask> _historyTasks = [];
    private List<ConversionTask> _visibleHistory = [];

    private string _statusFilter = string.Empty;
    private string _filenameFilter = string.Empty;
    private string _sortOrder = "newest";
    private int _limit = 50;

    private string? _expandedTaskKey;
    private readonly Dictionary<string, LogBuffer> _logBuffers = new(StringComparer.Ordinal);
    private readonly Queue<string> _logBufferKeys = new();

    private bool _isRefreshing;
    private bool _bulkBusy;
    private bool _confirmOpen;
    private BulkAction _pendingBulk = BulkAction.None;
    private int _statusRefreshQueued;

    private CancellationTokenSource? _refreshCts;
    private Task? _refreshLoop;
    private volatile bool _disposed;

    // ── 生命周期 ────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        TaskService.TaskProgressChanged += OnTaskProgressChanged;
        TaskService.TaskStatusChanged += OnTaskStatusChanged;
        TaskService.TaskLogAppended += OnTaskLogAppended;

        await RefreshAsync(showBusy: false);

        // 低频兜底刷新：进度靠事件驱动，这里只补查「运行中」的任务。
        // 不用 System.Threading.Timer + async void（会在线程池线程上读组件状态并吞掉异常）。
        var cts = new CancellationTokenSource();
        _refreshCts = cts;
        _refreshLoop = RunRunningRefreshLoopAsync(cts.Token);
    }

    public void Dispose()
    {
        _disposed = true;

        TaskService.TaskProgressChanged -= OnTaskProgressChanged;
        TaskService.TaskStatusChanged -= OnTaskStatusChanged;
        TaskService.TaskLogAppended -= OnTaskLogAppended;

        var cts = _refreshCts;
        var loop = _refreshLoop;
        _refreshCts = null;
        _refreshLoop = null;

        if (cts != null)
        {
            cts.Cancel();
            cts.Dispose();
        }

        // 循环最多再等一个 tick（2 秒）就会看到取消/销毁标记并退出；
        // 这里保留引用是为了避免它成为「未观测的任务」，不阻塞 UI 线程去等待。
        _ = loop;
    }

    /// <summary>只刷新运行中任务的循环（一次 tick 处理完才等下一次，不会自我重叠）</summary>
    private async Task RunRunningRefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(RunningRefreshInterval);

        while (!token.IsCancellationRequested && !_disposed)
        {
            try
            {
                await timer.WaitForNextTickAsync();
            }
            catch (Exception ex)
            {
                if (!_disposed) Toast.Warning($"运行中任务的自动刷新已停止：{ex.Message}");
                return;
            }

            if (token.IsCancellationRequested || _disposed) return;

            try
            {
                await InvokeAsync(RefreshRunningCoreAsync);
            }
            catch (Exception ex)
            {
                // 组件已销毁就没有界面可提示；其它异常必须让用户看到
                if (!_disposed) Toast.Warning($"运行中任务自动刷新失败：{ex.Message}");
                return;
            }
        }
    }

    /// <summary>在 UI 线程上执行的运行中任务兜底刷新</summary>
    private async Task RefreshRunningCoreAsync()
    {
        if (_disposed || _isRefreshing) return;
        if (_runningTasks.Count == 0 && TaskService.ActiveCount == 0) return;

        var hadRunning = _runningTasks.Count > 0;
        _runningTasks = await TaskService.GetRunningTasksAsync();
        StateHasChanged();

        // 刚好全部跑完：历史记录与队列计数需要跟着更新一次
        if (hadRunning && _runningTasks.Count == 0) await RefreshAsync(showBusy: false);
    }

    // ── 查询 ────────────────────────────────────────────────────

    private async Task RefreshAsync(bool showBusy = true)
    {
        if (_disposed || _isRefreshing) return;

        _isRefreshing = true;
        if (showBusy) await RenderAsync();

        try
        {
            var running = await TaskService.GetRunningTasksAsync();
            var pending = await TaskService.GetPendingTasksAsync();
            var history = await TaskService.GetTaskHistoryAsync(
                Math.Clamp(_limit, 1, RetryScanLimit),
                ParseStatusFilter(_statusFilter));

            // 运行中/等待中的任务已经在上面的分区里显示，历史表格不再重复
            var liveKeys = running.Select(t => TaskKey(t.Id))
                .Concat(pending.Select(t => TaskKey(t.Id)))
                .ToHashSet(StringComparer.Ordinal);
            history = history.Where(t => !liveKeys.Contains(TaskKey(t.Id))).ToList();

            if (_disposed) return;

            _runningTasks = running;
            _pendingTasks = pending;
            _historyTasks = history;
            ApplyFilter();
        }
        catch (Exception ex)
        {
            if (!_disposed) Toast.Error($"读取任务列表失败：{ex.Message}");
        }
        finally
        {
            _isRefreshing = false;
            await RenderAsync();
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<ConversionTask> query = _historyTasks;

        var keyword = _filenameFilter.Trim();
        if (keyword.Length > 0)
        {
            query = query.Where(t =>
                (Path.GetFileName(t.InputPath) ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                (Path.GetFileName(t.OutputPath) ?? string.Empty).Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }

        query = string.Equals(_sortOrder, "oldest", StringComparison.Ordinal)
            ? query.OrderBy(t => t.CreatedAt)
            : query.OrderByDescending(t => t.CreatedAt);

        _visibleHistory = query.ToList();
    }

    /// <summary>文件名与排序只影响内存里的列表，不必查库</summary>
    private void OnFilterChanged() => ApplyFilter();

    /// <summary>状态与条数会改变查询条件，需要重新读库</summary>
    private Task OnFilterChangedAsync() => RefreshAsync(showBusy: false);

    // ── 事件：进度只改内存对象，状态变化才重新读库 ──────────────

    private void OnTaskProgressChanged(object? sender, TaskProgressEventArgs e) =>
        _ = RunOnUiThreadAsync(() => ApplyProgress(e), "更新任务进度失败");

    private void OnTaskStatusChanged(object? sender, TaskStatusEventArgs e) =>
        _ = RunOnUiThreadTaskAsync(async () =>
        {
            NotifyStatusChange(e);
            await RefreshAfterStatusChangeAsync();
        }, "处理任务状态变化失败");

    /// <summary>
    /// 状态变化后重新读库（进度事件不会查库）。批量任务结束时会有很多次状态变化，
    /// 短时间内的多次变化合并成一次查询，避免对 LiteDB 造成刷屏式查询。
    /// </summary>
    private async Task RefreshAfterStatusChangeAsync()
    {
        if (_disposed) return;
        if (Interlocked.Exchange(ref _statusRefreshQueued, 1) == 1) return;

        try
        {
            await Task.Delay(StatusRefreshDelay);

            // 上一次刷新可能还在跑，再等一个延迟周期，尽量让这次变化落到同一次查询里
            if (_isRefreshing && !_disposed) await Task.Delay(StatusRefreshDelay);
        }
        finally
        {
            Interlocked.Exchange(ref _statusRefreshQueued, 0);
        }

        if (_disposed) return;
        await RefreshAsync(showBusy: false);
    }

    private void OnTaskLogAppended(object? sender, TaskLogEventArgs e) =>
        _ = RunOnUiThreadAsync(() => AppendLog(e.TaskId, e.Line), "更新实时日志失败");

    private void ApplyProgress(TaskProgressEventArgs e)
    {
        var key = TaskKey(e.TaskId);
        var task = _runningTasks.FirstOrDefault(t => TaskKey(t.Id) == key);
        if (task == null) return;

        task.Progress = e.Progress;
        task.ProcessingSpeed = e.Speed;
        task.EstimatedTimeRemaining = e.Eta;
        StateHasChanged();
    }

    private void NotifyStatusChange(TaskStatusEventArgs e)
    {
        var name = FindTaskName(e.TaskId);

        switch (e.NewStatus)
        {
            case TaskStatus.Completed:
                Toast.Success($"✅ 转换完成：{name}");
                break;
            case TaskStatus.Failed:
                Toast.Error(string.IsNullOrWhiteSpace(e.ErrorMessage)
                    ? $"❌ 转换失败：{name}"
                    : $"❌ 转换失败：{name} — {e.ErrorMessage}");
                break;
            case TaskStatus.Cancelled:
                Toast.Warning($"已取消：{name}");
                break;
            case TaskStatus.Skipped:
                Toast.Warning($"已跳过：{name}（输出文件已存在）");
                break;
            default:
                // 等待中/运行中：不必打扰用户
                break;
        }
    }

    private string FindTaskName(ObjectId taskId)
    {
        var key = TaskKey(taskId);
        var task = _runningTasks.FirstOrDefault(t => TaskKey(t.Id) == key)
                   ?? _pendingTasks.FirstOrDefault(t => TaskKey(t.Id) == key)
                   ?? _historyTasks.FirstOrDefault(t => TaskKey(t.Id) == key);

        if (task == null) return "任务";
        var name = Path.GetFileName(task.InputPath);
        return string.IsNullOrWhiteSpace(name) ? "任务" : name;
    }

    private void AppendLog(ObjectId taskId, string line)
    {
        var key = TaskKey(taskId);

        // 只缓存用户正在看的那一条日志，避免为几十个任务常驻内存
        if (!string.Equals(_expandedTaskKey, key, StringComparison.Ordinal)) return;

        GetOrCreateBuffer(key).Append(line);
        StateHasChanged();
    }

    private LogBuffer GetOrCreateBuffer(string key)
    {
        if (_logBuffers.TryGetValue(key, out var existing)) return existing;

        var created = new LogBuffer();
        RegisterBuffer(key, created);
        return created;
    }

    private void RegisterBuffer(string key, LogBuffer buffer)
    {
        _logBuffers[key] = buffer;
        _logBufferKeys.Enqueue(key);
        TrimLogBuffers();
    }

    /// <summary>只保留最近若干条任务的日志缓冲（当前展开的那条不会被回收）</summary>
    private void TrimLogBuffers()
    {
        while (_logBuffers.Count > MaxLogBuffers && _logBufferKeys.Count > 0)
        {
            var oldest = _logBufferKeys.Dequeue();
            if (string.Equals(oldest, _expandedTaskKey, StringComparison.Ordinal)) continue;
            _logBuffers.Remove(oldest);
        }
    }

    /// <summary>记录被批量删除后，展开状态与日志缓冲一并清掉</summary>
    private void ResetLogState()
    {
        _expandedTaskKey = null;
        _logBuffers.Clear();
        _logBufferKeys.Clear();
    }

    // ── 单任务操作 ──────────────────────────────────────────────

    private Task GracefulStopAsync(ObjectId taskId) =>
        StopAsync(taskId, graceful: true, "已发送优雅停止（q），FFmpeg 会写完文件尾再退出。");

    private Task ForceStopAsync(ObjectId taskId) =>
        StopAsync(taskId, graceful: false, "已强制终止任务，未完成的输出文件会被清理。");

    private Task CancelPendingAsync(ObjectId taskId) =>
        StopAsync(taskId, graceful: false, "已取消排队，这个任务不会再开始执行。");

    private async Task StopAsync(ObjectId taskId, bool graceful, string successText)
    {
        try
        {
            var ok = await TaskService.CancelTaskAsync(taskId, graceful);
            if (ok)
            {
                Toast.Success(successText);
            }
            else
            {
                Toast.Warning("这个任务已经结束或无法取消，列表可能不是最新的，已为你刷新。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"停止任务失败：{ex.Message}");
        }

        await RefreshAsync(showBusy: false);
    }

    private async Task RetryAsync(ObjectId taskId)
    {
        try
        {
            var retry = await TaskService.RetryTaskAsync(taskId);
            if (retry == null)
            {
                Toast.Error("找不到原任务记录，无法重试。");
                return;
            }

            Toast.Success($"已重新加入队列：{Path.GetFileName(retry.InputPath)}");
        }
        catch (Exception ex)
        {
            Toast.Error($"重试失败：{ex.Message}");
        }

        await RefreshAsync(showBusy: false);
    }

    private async Task OpenOutputFolderAsync(ConversionTask task)
    {
        try
        {
            var directory = string.IsNullOrWhiteSpace(task.OutputPath) ? null : Path.GetDirectoryName(task.OutputPath);
            if (string.IsNullOrEmpty(directory) || !Directory.Exists(directory))
            {
                Toast.Warning("输出目录不存在，可能已被移动或删除。");
                return;
            }

            if (AppPaths.IsWindows)
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", $"\"{directory}\"") { UseShellExecute = true });
            }
            else if (AppPaths.IsMacOS)
            {
                System.Diagnostics.Process.Start("open", [directory]);
            }
            else
            {
                System.Diagnostics.Process.Start("xdg-open", [directory]);
            }

            Toast.Success("已在文件管理器中打开输出目录。");
        }
        catch (Exception ex)
        {
            Toast.Error($"无法打开输出目录：{ex.Message}");
        }

        await Task.CompletedTask;
    }

    private async Task CopyCommandAsync(ConversionTask task)
    {
        var command = task.ActualCommand?.Trim() ?? string.Empty;
        if (command.Length == 0)
        {
            Toast.Warning("这个任务还没有生成实际命令（可能尚未开始执行），暂时没有可复制的内容。");
            return;
        }

        await CopyToClipboardAsync("ffmpeg " + command, "命令已复制到剪贴板", "复制命令失败");
    }

    private async Task CopyErrorAsync(ConversionTask task)
    {
        var text = task.ErrorMessage?.Trim() ?? string.Empty;
        if (text.Length == 0)
        {
            Toast.Warning("这个任务没有记录错误信息。");
            return;
        }

        await CopyToClipboardAsync(text, "错误信息已复制到剪贴板", "复制错误信息失败");
    }

    private async Task CopyToClipboardAsync(string text, string successText, string failurePrefix)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("ffui.copyText", text);
            if (ok)
            {
                Toast.Success(successText);
            }
            else
            {
                Toast.Error("复制失败：浏览器不允许访问剪贴板，请在详情里手动选中文本。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"{failurePrefix}：{ex.Message}");
        }
    }

    private async Task ToggleLogAsync(ConversionTask task)
    {
        var key = TaskKey(task.Id);

        if (string.Equals(_expandedTaskKey, key, StringComparison.Ordinal))
        {
            _expandedTaskKey = null;
            return;
        }

        _expandedTaskKey = key;

        if (_logBuffers.ContainsKey(key)) return;

        // 首次展开：把已落库的日志读进来，之后的增量由 TaskLogAppended 追加
        var buffer = new LogBuffer();
        try
        {
            var fresh = await TaskService.GetTaskByIdAsync(task.Id);
            buffer.Replace(fresh?.LogOutput ?? task.LogOutput);
        }
        catch (Exception ex)
        {
            Toast.Error($"读取任务日志失败：{ex.Message}");
        }

        RegisterBuffer(key, buffer);
        await RenderAsync();
    }

    // ── 批量操作 ────────────────────────────────────────────────

    private void AskBulk(BulkAction action)
    {
        _pendingBulk = action;
        _confirmOpen = true;
    }

    private void CancelBulk() => _confirmOpen = false;

    private Task OnConfirmOpenChanged(bool value)
    {
        _confirmOpen = value;
        if (!value) _pendingBulk = BulkAction.None;
        return Task.CompletedTask;
    }

    private string BulkTitle => _pendingBulk switch
    {
        BulkAction.ClearFailedAndCancelled => "清理失败与取消的任务",
        BulkAction.ClearHistory => "清空历史记录",
        BulkAction.RetryAllFailed => "重试全部失败任务",
        _ => "确认操作"
    };

    private string BulkMessage => _pendingBulk switch
    {
        BulkAction.ClearFailedAndCancelled => "将删除全部「失败」和「已取消」的任务记录，运行中与等待中的任务不受影响。此操作不可撤销。",
        BulkAction.ClearHistory => "将删除全部已完成 / 失败 / 已取消 / 已跳过的历史记录，运行中与等待中的任务保留。此操作不可撤销。",
        BulkAction.RetryAllFailed => $"将扫描最近 {RetryScanLimit} 条失败的任务，逐个重新加入队列执行。",
        _ => string.Empty
    };

    private string? BulkDetailText => _pendingBulk switch
    {
        BulkAction.ClearFailedAndCancelled => "只删除记录，不会删除任何输出文件。",
        BulkAction.ClearHistory => "只删除任务记录，磁盘上的输出文件不会被删除。",
        BulkAction.RetryAllFailed => "会复用原来的输入文件、模板与参数。",
        _ => null
    };

    private string BulkConfirmText => _pendingBulk switch
    {
        BulkAction.RetryAllFailed => "重新排队",
        _ => "确认"
    };

    private bool ConfirmDanger => _pendingBulk is BulkAction.ClearFailedAndCancelled or BulkAction.ClearHistory;

    private async Task ConfirmBulkAsync()
    {
        var action = _pendingBulk;
        _bulkBusy = true;

        try
        {
            switch (action)
            {
                case BulkAction.ClearFailedAndCancelled:
                {
                    var failed = await TaskService.DeleteTasksByStatusAsync(TaskStatus.Failed);
                    var cancelled = await TaskService.DeleteTasksByStatusAsync(TaskStatus.Cancelled);
                    ResetLogState();
                    Toast.Success($"已清理 {failed + cancelled} 条记录（失败 {failed} 条、已取消 {cancelled} 条）。");
                    break;
                }

                case BulkAction.ClearHistory:
                {
                    var removed = await TaskService.ClearHistoryAsync();
                    ResetLogState();
                    Toast.Success($"已清空 {removed} 条历史记录（运行中与等待中的任务保留）。");
                    break;
                }

                case BulkAction.RetryAllFailed:
                    await RetryAllFailedAsync();
                    break;

                default:
                    Toast.Warning("没有选择任何批量操作。");
                    break;
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"批量操作失败：{ex.Message}");
        }
        finally
        {
            _bulkBusy = false;
            _confirmOpen = false;
            _pendingBulk = BulkAction.None;
            await RefreshAsync(showBusy: false);
        }
    }

    private async Task RetryAllFailedAsync()
    {
        List<ConversionTask> failedTasks;
        try
        {
            failedTasks = await TaskService.GetTaskHistoryAsync(RetryScanLimit, TaskStatus.Failed);
        }
        catch (Exception ex)
        {
            Toast.Error($"读取失败任务失败：{ex.Message}");
            return;
        }

        if (failedTasks.Count == 0)
        {
            Toast.Warning("没有失败的任务需要重试。");
            return;
        }

        var queued = 0;
        var skipped = 0;
        var errors = 0;
        string? firstError = null;

        foreach (var task in failedTasks)
        {
            try
            {
                var retry = await TaskService.RetryTaskAsync(task.Id);
                if (retry == null) skipped++;
                else queued++;
            }
            catch (Exception ex)
            {
                errors++;
                firstError ??= ex.Message;
            }
        }

        var text = $"失败任务重试完成：已重新排队 {queued} 个";
        if (skipped > 0) text += $"，跳过 {skipped} 个";
        if (errors > 0) text += $"，{errors} 个出错（{firstError}）";

        if (errors > 0) Toast.Warning(text);
        else Toast.Success(text);
    }

    // ── 线程与渲染辅助 ──────────────────────────────────────────

    /// <summary>把事件处理搬到 UI 线程；异常必须有可见反馈</summary>
    private async Task RunOnUiThreadAsync(Action work, string failureText)
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(work);
        }
        catch (Exception ex)
        {
            if (_disposed) return; // 组件已销毁，没有界面可以反馈
            Toast.Error($"{failureText}：{ex.Message}");
        }
    }

    /// <summary>把异步事件处理搬到 UI 线程（续体也会留在 UI 线程上）</summary>
    private async Task RunOnUiThreadTaskAsync(Func<Task> work, string failureText)
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(work);
        }
        catch (Exception ex)
        {
            if (_disposed) return; // 组件已销毁，没有界面可以反馈
            Toast.Error($"{failureText}：{ex.Message}");
        }
    }

    private async Task RenderAsync()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (!_disposed) Toast.Warning($"界面刷新失败：{ex.Message}");
        }
    }

