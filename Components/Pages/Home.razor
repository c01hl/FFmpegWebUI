@page "/"
@inject IAppStatusService AppStatusService
@inject IHardwareDetectionService HardwareDetectionService
@inject ITaskService TaskService
@inject IToastService Toast
@implements IDisposable

<PageTitle>首页 - @AppInfo.Name</PageTitle>

<div class="ffui-container home">
    <header class="hero">
        <div class="hero-text">
            <h1>🎬 @AppInfo.Name</h1>
            <p class="hero-sub">本地媒体文件转换工具 · v@(AppInfo.Version)</p>
        </div>
        <nav class="hero-actions" aria-label="快速开始">
            <a class="ffui-btn ffui-btn-primary ffui-btn-lg" href="convert">🔄 开始转换</a>
            <a class="ffui-btn ffui-btn-lg" href="batch">📁 批量处理</a>
            <a class="ffui-btn ffui-btn-lg" href="templates">📋 模板</a>
        </nav>
    </header>

    <!-- ── 环境状态 ────────────────────────────────────────────── -->
    <section class="ffui-panel">
        <h2 class="ffui-section-title">
            <span>📊 环境状态</span>
            @if (_statusLoaded)
            {
                <span class="ffui-badge @HealthBadgeClass()">@HealthBadgeText()</span>
            }
            <span class="spacer"></span>
            <button type="button" class="ffui-btn ffui-btn-sm" disabled="@_isLoadingStatus" @onclick="() => LoadAllAsync(forceRefresh: true)">
                @if (_isLoadingStatus)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
                🔄 刷新
            </button>
        </h2>

        @if (!_statusLoaded)
        {
            <div class="ffui-loading-row">
                <span class="spinner" aria-hidden="true"></span>
                <span>正在检测环境…首次检测需要试跑硬件编码器，可能需要几十秒。</span>
                @if (_elapsedSeconds > 0.05)
                {
                    <span class="ffui-badge">已用 @FormatElapsed(_elapsedSeconds)</span>
                }
            </div>
        }
        else
        {
            @if (!_status.FFmpegAvailable)
            {
                <div class="ffui-alert ffui-alert-danger">
                    <div>
                        <strong>未检测到可用的 FFmpeg</strong>
                        <p class="alert-text">@InstallHintText()</p>
                        <div class="alert-actions">
                            <a class="ffui-btn ffui-btn-sm ffui-btn-primary" href="settings">前往设置</a>
                            <a class="ffui-btn ffui-btn-sm" href="https://ffmpeg.org/download.html" target="_blank" rel="noreferrer">下载 FFmpeg</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="ffui-alert ffui-alert-success">
                    <div>
                        <strong>FFmpeg 已就绪 · @_status.FFmpegVersion</strong>
                        <p class="alert-text mono">@OrDash(_status.FFmpegPath)</p>
                    </div>
                </div>
            }

            <dl class="status-grid">
                <div class="status-item">
                    <dt>FFmpeg 版本</dt>
                    <dd>@OrDash(_status.FFmpegVersion)</dd>
                </div>
                <div class="status-item">
                    <dt>FFmpeg 路径</dt>
                    <dd class="mono ellipsis" title="@_status.FFmpegPath">@OrDash(_status.FFmpegPath)</dd>
                </div>
                <div class="status-item">
                    <dt>路径来源</dt>
                    <dd><span class="ffui-badge">@PathSourceText()</span></dd>
                </div>
                <div class="status-item">
                    <dt>平台</dt>
                    <dd>@OrDash(_status.Platform)</dd>
                </div>
                <div class="status-item">
                    <dt>.NET 版本</dt>
                    <dd>@OrDash(_status.Runtime)</dd>
                </div>
                <div class="status-item">
                    <dt>数据目录</dt>
                    <dd class="mono ellipsis" title="@_status.DataDirectory">@OrDash(_status.DataDirectory)</dd>
                    <dd><span class="ffui-badge @DataDirBadgeClass()">@DataDirBadgeText()</span></dd>
                </div>
                <div class="status-item">
                    <dt>硬件解码方式</dt>
                    <dd>
                        @if (_status.Hwaccels.Count == 0)
                        {
                            <span class="muted">未检测到（FFmpeg 未启用或不可用）</span>
                        }
                        else
                        {
                            <span class="chip-row">
                                @foreach (var hwaccel in _status.Hwaccels)
                                {
                                    <code class="chip" @key="hwaccel">@hwaccel</code>
                                }
                            </span>
                        }
                    </dd>
                </div>
                <div class="status-item">
                    <dt>模板数量</dt>
                    <dd>@_status.TemplateCount 个 · <a href="templates">管理模板</a></dd>
                </div>
                <div class="status-item">
                    <dt>任务队列</dt>
                    <dd>
                        运行中 @TaskService.ActiveCount 个 · 排队 @TaskService.QueuedCount 个 ·
                        <a href="tasks">查看任务</a>
                    </dd>
                </div>
            </dl>

            @if (_status.Notices.Count > 0)
            {
                <div class="notice-list">
                    @foreach (var notice in _status.Notices)
                    {
                        <div class="ffui-alert @NoticeAlertClass()" @key="notice">
                            <span>@notice</span>
                        </div>
                    }
                </div>
            }
        }
    </section>

    <!-- ── 硬件编码能力 ────────────────────────────────────────── -->
    <section class="ffui-panel">
        <h2 class="ffui-section-title">
            <span>🖥️ 硬件编码能力</span>
            @if (_reportLoaded)
            {
                <span class="ffui-badge @ReportBadgeClass()">@ReportBadgeText()</span>
            }
            <span class="spacer"></span>
            <button type="button" class="ffui-btn ffui-btn-sm" disabled="@_isDetecting" @onclick="DetectEncodersAsync">
                @if (_isDetecting)
                {
                    <span class="spinner" aria-hidden="true"></span>
                }
                @DetectButtonText()
            </button>
        </h2>

        @if (_isDetecting)
        {
            <div class="ffui-loading-row">
                <span class="spinner" aria-hidden="true"></span>
                <span>正在逐个试跑硬件编码器，<strong>可能需要数秒到一分钟</strong>，请不要关闭页面。</span>
                <span class="ffui-badge">已用 @FormatElapsed(_elapsedSeconds)</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_detectNote))
        {
            <div class="ffui-alert ffui-alert-warning"><span>@_detectNote</span></div>
        }

        @if (!_reportLoaded)
        {
            <div class="ffui-empty-state">
                还没有检测结果。点击「刷新检测（可能需要数秒）」扫描本机可用的硬件编码器。
            </div>
        }
        else
        {
            <p class="report-summary">@OrDash(_report.Summary)</p>

            <div class="report-meta">
                <span class="ffui-badge">FFmpeg @OrDash(_report.FFmpegVersion)</span>
                <span class="ffui-badge">检测时间 @_report.DetectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                <span class="ffui-badge">硬件解码 @_report.Hwaccels.Count 种</span>
                @if (_lastDetectSeconds > 0.05)
                {
                    <span class="ffui-badge">本轮用时 @FormatElapsed(_lastDetectSeconds)</span>
                }
            </div>

            <h3 class="sub-title">
                <span>硬件编码器</span>
                <span class="ffui-badge">@_hardwareAvailable.Count 个可用 / 共探测 @_hardwareTotal 个</span>
            </h3>

            @if (_hardwareAvailable.Count == 0)
            {
                <div class="ffui-empty-state">
                    没有可用的硬件编码器，转换会自动使用软件编码（CPU）：速度慢一些，但结果稳定。
                    如果本机确实有独立显卡或核显，请确认当前的 FFmpeg 构建启用了对应加速（NVENC / VideoToolbox / QSV / VA-API 等）。
                </div>
            }
            else
            {
                <div class="encoder-grid">
                    @foreach (var encoder in _hardwareAvailable)
                    {
                        <EncoderCard @key="encoder.Name" Encoder="encoder" />
                    }
                </div>
            }

            @if (_hardwareUnavailable.Count > 0)
            {
                <details class="encoder-details">
                    <summary>另有 @_hardwareUnavailable.Count 个硬件编码器不可用（点开查看原因）</summary>
                    <ul class="reason-list">
                        @foreach (var encoder in _hardwareUnavailable)
                        {
                            <li @key="encoder.Name">
                                <code>@encoder.Name</code>
                                <span class="reason">@UnavailableReason(encoder)</span>
                            </li>
                        }
                    </ul>
                </details>
            }

            <details class="encoder-details software">
                <summary>软件编码（CPU 兜底）· @_softwareAvailable.Count 个可用</summary>
                @if (_softwareAvailable.Count == 0)
                {
                    <p class="muted">当前 FFmpeg 构建里没有检测到软件编码器。</p>
                }
                else
                {
                    <div class="encoder-grid">
                        @foreach (var encoder in _softwareAvailable)
                        {
                            <EncoderCard @key="encoder.Name" Encoder="encoder" />
                        }
                    </div>
                }
                @if (_softwareUnavailable.Count > 0)
                {
                    <ul class="reason-list">
                        @foreach (var encoder in _softwareUnavailable)
                        {
                            <li @key="encoder.Name">
                                <code>@encoder.Name</code>
                                <span class="reason">@UnavailableReason(encoder)</span>
                            </li>
                        }
                    </ul>
                }
            </details>
        }
    </section>

    <!-- ── 最近任务 ────────────────────────────────────────────── -->
    <section class="ffui-panel">
        <h2 class="ffui-section-title">
            <span>🕒 最近任务</span>
            <span class="spacer"></span>
            <a class="ffui-btn ffui-btn-sm" href="tasks">查看全部任务</a>
        </h2>

        @if (_recentTasks.Count == 0)
        {
            <div class="ffui-empty-state">
                还没有任何任务，去「转换」页开始第一个吧。
                <div class="empty-actions">
                    <a class="ffui-btn ffui-btn-primary ffui-btn-sm" href="convert">开始转换</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="recent-table">
                    <thead>
                        <tr>
                            <th scope="col">文件</th>
                            <th scope="col">状态</th>
                            <th scope="col">耗时</th>
                            <th scope="col">创建时间</th>
                            <th scope="col">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in _recentTasks)
                        {
                            <tr @key="task.Id">
                                <td class="ellipsis" title="@task.InputPath">@Path.GetFileName(task.InputPath)</td>
                                <td>
                                    <span class="ffui-badge @StatusBadgeClass(task.Status)">@StatusText(task.Status)</span>
                                </td>
                                <td>@FormatDuration(task)</td>
                                <td>@task.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                <td>
                                    @if (task.Status == TaskStatus.Completed)
                                    {
                                        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => OpenOutputFolderAsync(task)">打开目录</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .home {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .hero {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
    }

    .hero-text h1 { margin: 0; }

    .hero-sub {
        margin: 0.25rem 0 0;
        color: var(--text-secondary);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .ffui-panel { margin: 0; }

    .spacer { flex: 1; }

    .alert-text {
        margin: 0.35rem 0 0;
        word-break: break-all;
    }

    .alert-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.6rem;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 0.85rem 1.25rem;
        margin: 1rem 0 0;
    }

    .status-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
    }

    .status-item dt {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .status-item dd {
        margin: 0;
        font-size: 0.92rem;
        color: var(--text-primary);
        min-width: 0;
    }

    .chip-row {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .chip { font-size: 0.78rem; }

    .mono { font-family: var(--font-mono); }

    .ellipsis {
        display: inline-block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
    }

    .muted { color: var(--text-muted); }

    .notice-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.9rem;
    }

    .report-summary {
        margin: 0.35rem 0 0.7rem;
        color: var(--text-secondary);
    }

    .report-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    .sub-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 1rem 0 0.6rem;
        font-size: 1rem;
        color: var(--text-primary);
    }

    .encoder-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.6rem;
    }

    .encoder-details {
        margin-top: 0.9rem;
        padding: 0.6rem 0.8rem;
        background: var(--surface-3);
        border: 1px solid var(--border-color);
