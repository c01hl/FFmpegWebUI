        margin-top: 0.7rem;
    }
</style>

@code {
    private AppStatus _status = new();
    private HardwareDetectionReport _report = new();
    private List<ConversionTask> _recentTasks = [];

    private List<HardwareEncoder> _hardwareAvailable = [];
    private List<HardwareEncoder> _hardwareUnavailable = [];
    private List<HardwareEncoder> _softwareAvailable = [];
    private List<HardwareEncoder> _softwareUnavailable = [];
    private int _hardwareTotal;

    private bool _statusLoaded;
    private bool _reportLoaded;
    private bool _isLoadingStatus;
    private bool _isDetecting;
    private bool _initialized;

    private double _elapsedSeconds;
    private double _lastDetectSeconds;
    private string _detectNote = string.Empty;
    private DateTime _scanStartedAt;

    private CancellationTokenSource? _tickerCts;
    private Task? _tickerLoop;
    private volatile bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 环境检测会真的去试跑编码器（可能几十秒），放在预渲染里会卡住整个首屏，
        // 所以等到交互式渲染后再加载，预渲染阶段先显示占位的加载提示。
        if (!firstRender || _initialized) return;
        _initialized = true;
        await LoadAllAsync(forceRefresh: false);
    }

    // ── 数据加载 ────────────────────────────────────────────────

    /// <summary>读取环境状态 + 硬件检测报告 + 最近任务</summary>
    private async Task LoadAllAsync(bool forceRefresh)
    {
        if (_isLoadingStatus || _isDetecting) return;

        _isLoadingStatus = true;
        _detectNote = string.Empty;
        StartTicker();

        try
        {
            var status = await AppStatusService.GetStatusAsync(forceRefresh);
            _status = status;
            _statusLoaded = true;

            if (status.FFmpegAvailable)
            {
                // GetStatusAsync 内部已经按 forceRefresh 跑过一次检测（并写入缓存），
                // 这里不再强制刷新，否则点一次「刷新」会先后试跑两遍编码器。
                _report = await HardwareDetectionService.DetectAsync();
                _reportLoaded = true;
                _lastDetectSeconds = _elapsedSeconds;
            }
            else if (HardwareDetectionService.LastReport is { } lastReport)
            {
                _report = lastReport;
                _reportLoaded = true;
            }

            RebuildEncoderGroups();
            _recentTasks = await TaskService.GetTaskHistoryAsync(5);

            if (forceRefresh) Toast.Success("环境状态已刷新。");
        }
        catch (Exception ex)
        {
            Toast.Error($"读取环境状态失败：{ex.Message}（可以稍后重试，或先到「设置」检查 FFmpeg 路径）");
        }
        finally
        {
            _isLoadingStatus = false;
            await StopTickerAsync();
            await RenderAsync();
        }
    }

    /// <summary>只重跑硬件检测（按钮路径：需要明确的忙碌反馈 + 耗时显示）</summary>
    private async Task DetectEncodersAsync()
    {
        if (_isDetecting || _isLoadingStatus) return;

        _isDetecting = true;
        _detectNote = string.Empty;
        StartTicker();

        try
        {
            _report = await HardwareDetectionService.DetectAsync(forceRefresh: true);
            _reportLoaded = true;
            _lastDetectSeconds = _elapsedSeconds;

            // 检测内存缓存已更新，这里再读一次状态不会重复扫描，只是让计数与提示跟着刷新
            _status = await AppStatusService.GetStatusAsync(forceRefresh: false);
            _statusLoaded = true;

            RebuildEncoderGroups();

            Toast.Success($"硬件检测完成，用时 {FormatElapsed(_lastDetectSeconds)}。");
        }
        catch (Exception ex)
        {
            Toast.Error($"硬件检测失败：{ex.Message}（可以稍后重试；转换会自动改用软件编码）");
        }
        finally
        {
            _isDetecting = false;
            await StopTickerAsync();
            await RenderAsync();
        }
    }

    private void RebuildEncoderGroups()
    {
        _hardwareTotal = _report.Encoders.Count(e => e.IsHardware);
        _hardwareAvailable = _report.Encoders.Where(e => e.IsHardware && e.IsAvailable).ToList();
        _hardwareUnavailable = _report.Encoders.Where(e => e.IsHardware && !e.IsAvailable).ToList();
        _softwareAvailable = _report.Encoders.Where(e => !e.IsHardware && e.IsAvailable).ToList();
        _softwareUnavailable = _report.Encoders.Where(e => !e.IsHardware && !e.IsAvailable).ToList();
    }

    // ── 扫描计时（检测可能很慢，必须有进度感）──────────────────

    private void StartTicker()
    {
        _scanStartedAt = DateTime.UtcNow;
        _elapsedSeconds = 0;

        var cts = new CancellationTokenSource();
        _tickerCts = cts;
        _tickerLoop = RunTickerAsync(cts.Token);
    }

    private async Task StopTickerAsync()
    {
        var cts = _tickerCts;
        var loop = _tickerLoop;
        _tickerCts = null;
        _tickerLoop = null;

        if (cts == null) return;

        cts.Cancel();
        if (loop != null)
        {
            try
            {
                await loop;
            }
            catch (Exception ex)
            {
                if (!_disposed) _detectNote = $"耗时显示异常：{ex.Message}";
            }
        }
        cts.Dispose();
    }

    private async Task RunTickerAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(200));

        while (!token.IsCancellationRequested && !_disposed)
        {
            await timer.WaitForNextTickAsync();
            if (token.IsCancellationRequested || _disposed) return;

            var elapsed = (DateTime.UtcNow - _scanStartedAt).TotalSeconds;
            try
            {
                await InvokeAsync(() =>
                {
                    _elapsedSeconds = elapsed;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                // 组件已销毁就没有界面可提示；其它异常要让用户看到计时已停
                if (!_disposed) _detectNote = $"耗时显示不可用：{ex.Message}";
                return;
            }
        }
    }

    private async Task RenderAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // 组件已销毁无需提示，其它异常必须让用户看到
            if (!_disposed) Toast.Warning($"界面刷新失败：{ex.Message}");
        }
    }

    // ── 动作 ────────────────────────────────────────────────────

    private async Task OpenOutputFolderAsync(ConversionTask task)
    {
        try
        {
            var directory = string.IsNullOrWhiteSpace(task.OutputPath) ? null : Path.GetDirectoryName(task.OutputPath);
            if (string.IsNullOrEmpty(directory) || !Directory.Exists(directory))
            {
                Toast.Warning("输出目录不存在，可能已被移动或删除。");
                return;
            }

            if (AppPaths.IsWindows)
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", $"\"{directory}\"") { UseShellExecute = true });
            }
            else if (AppPaths.IsMacOS)
            {
                System.Diagnostics.Process.Start("open", [directory]);
            }
            else
            {
                System.Diagnostics.Process.Start("xdg-open", [directory]);
            }

            Toast.Success("已在文件管理器中打开输出目录。");
        }
        catch (Exception ex)
        {
            Toast.Error($"无法打开目录：{ex.Message}");
        }

        await Task.CompletedTask;
    }

    // ── 展示辅助 ────────────────────────────────────────────────

    private string HealthBadgeClass() => _status.FFmpegAvailable ? "ffui-badge-success" : "ffui-badge-danger";

    private string HealthBadgeText() => _status.FFmpegAvailable ? "环境正常" : "FFmpeg 不可用";

    private string NoticeAlertClass() => _status.FFmpegAvailable ? "ffui-alert-warning" : "ffui-alert-danger";

    private string PathSourceText() => _status.AutoDetected ? "自动探测" : "设置中指定";

    private string DataDirBadgeClass() => AppStatusService.IsDataDirectoryWritable ? "ffui-badge-success" : "ffui-badge-warning";

    private string DataDirBadgeText() => AppStatusService.IsDataDirectoryWritable ? "可写" : "不可写（设置无法保存）";

    private string ReportBadgeClass() => _report.HasHardwareAcceleration ? "ffui-badge-success" : "ffui-badge-warning";

    private string ReportBadgeText() => _report.HasHardwareAcceleration
        ? $"{_hardwareAvailable.Count} 个硬件编码器可用"
        : "没有可用的硬件编码器";

    private string DetectButtonText() => _isDetecting ? "正在检测…" : "🔄 刷新检测（可能需要数秒）";

    private string InstallHintText() => AppPaths.IsWindows
        ? "请先安装 FFmpeg：从 ffmpeg.org 下载压缩包后解压，把 bin 目录加入 PATH（或执行 winget install Gyan.FFmpeg），也可以在「设置」里直接指定 ffmpeg.exe 的完整路径。"
