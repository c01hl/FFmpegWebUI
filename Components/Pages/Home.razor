            : "请先安装 FFmpeg：Debian/Ubuntu 用 apt install ffmpeg，Fedora 用 dnf install ffmpeg，也可以在「设置」里直接指定 ffmpeg 的完整路径。";

    private static string UnavailableReason(HardwareEncoder encoder) =>
        string.IsNullOrWhiteSpace(encoder.UnavailableReason) ? "未通过可用性试跑" : encoder.UnavailableReason!;

    private static string OrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FormatElapsed(double seconds)
    {
        if (seconds < 0) seconds = 0;
        if (seconds >= 60)
        {
            return TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");
        }
        return seconds.ToString("0.0", CultureInfo.InvariantCulture) + " 秒";
    }

    private static string FormatDuration(ConversionTask task) =>
        task.DurationSeconds is double seconds ? FormatSeconds(seconds) : "-";

    private static string FormatSeconds(double seconds)
    {
        if (seconds <= 0) return "-";
        var span = TimeSpan.FromSeconds(seconds);
        return span.TotalHours >= 1
            ? $"{(int)span.TotalHours}:{span.Minutes:D2}:{span.Seconds:D2}"
            : $"{span.Minutes:D2}:{span.Seconds:D2}";
    }

    private static string StatusText(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "已完成",
        TaskStatus.Failed => "失败",
        TaskStatus.Running => "运行中",
        TaskStatus.Cancelled => "已取消",
        TaskStatus.Skipped => "已跳过",
        _ => "等待中"
    };

    private static string StatusBadgeClass(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "ffui-badge-success",
        TaskStatus.Failed => "ffui-badge-danger",
        TaskStatus.Running => "ffui-badge-info",
        TaskStatus.Cancelled => "ffui-badge-warning",
        TaskStatus.Skipped => "ffui-badge-warning",
        _ => string.Empty
    };

    public void Dispose()
    {
        _disposed = true;

        var cts = _tickerCts;
        _tickerCts = null;
        _tickerLoop = null;

        if (cts == null) return;
        cts.Cancel();
        cts.Dispose();
    }
}
