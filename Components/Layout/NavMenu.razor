@using FFmpegWebUI.Services

<div class="brand">
    <span class="brand-icon" aria-hidden="true">🎬</span>
    <span class="brand-text">@AppInfo.Name</span>
</div>

<nav class="nav-menu" aria-label="主导航">
    @foreach (var item in MenuItems)
    {
        <NavLink class="nav-link" href="@item.Href"
                 Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">
            <span class="nav-icon" aria-hidden="true">@item.Icon</span>
            <span class="nav-text">@item.Label</span>
        </NavLink>
    }
</nav>

<div class="nav-footer">
    <div class="nav-footer-line">@AppPaths.PlatformDisplayName · .NET @Environment.Version.Major</div>
    <div class="nav-footer-line mono">v@(AppInfo.Version)</div>
</div>

@code {
    private sealed record MenuItem(string Href, string Label, string Icon, bool Exact = false);

    private static readonly MenuItem[] MenuItems =
    [
        new("", "首页", "🏠", Exact: true),
        new("convert", "转换", "🔄"),
        new("batch", "批量处理", "📁"),
        new("templates", "模板", "📋"),
        new("tasks", "任务列表", "🗂️"),
        new("settings", "设置", "⚙️"),
    ];
}
