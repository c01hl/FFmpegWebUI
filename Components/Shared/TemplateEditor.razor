    private static readonly string[] PlaceholderGroupOrder = ["路径类", "媒体信息类", "编码器类", "时间类", "其他"];

    private static readonly List<PlaceholderGroup> PlaceholderGroups = BuildPlaceholderGroups();

    private static List<PlaceholderGroup> BuildPlaceholderGroups()
    {
        var known = new HashSet<string>(PlaceholderDocs.Select(doc => doc.Name), StringComparer.OrdinalIgnoreCase);
        var groups = new List<PlaceholderGroup>();

        foreach (var title in PlaceholderGroupOrder)
        {
            var items = PlaceholderDocs
                .Where(doc => doc.Group == title && CommandLineBuilder.BuiltInPlaceholders.Contains(doc.Name))
                .Select(doc => new PlaceholderInfo(doc.Name, doc.Description))
                .DistinctBy(info => info.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (title == "其他")
            {
                // 兜底：BuiltInPlaceholders 里新增、而这里还没写说明的占位符也必须出现在调色板中
                items.AddRange(CommandLineBuilder.BuiltInPlaceholders
                    .Where(name => !known.Contains(name))
                    .OrderBy(name => name, StringComparer.Ordinal)
                    .Select(name => new PlaceholderInfo(name, "系统提供的占位符")));
            }

            if (items.Count > 0) groups.Add(new PlaceholderGroup(title, items));
        }

        return groups;
    }

    // ────────────────────────────────────────────────────────────────
    // 复制 / 试运行 / 保存
    // ────────────────────────────────────────────────────────────────

    private static string FormatDuration(TimeSpan value) =>
        value <= TimeSpan.Zero ? "—" : value.TotalSeconds.ToString("0.0", CultureInfo.InvariantCulture) + " 秒";

    private async Task CopyCommandAsync()
    {
        if (string.IsNullOrWhiteSpace(_previewCommand)) return;

        try
        {
            var ok = await JS.InvokeAsync<bool>("ffui.copyText", "ffmpeg " + _previewCommand);
            if (ok) Toast.Success("命令已复制到剪贴板");
            else Toast.Error("复制失败：浏览器不允许访问剪贴板，请手动选中命令文本后复制。");
        }
        catch (Exception ex)
        {
            Toast.Error($"复制失败：{ex.Message}");
        }
    }

    private async Task RunTestAsync()
    {
        if (_isTesting) return;

        NormalizeDraft();
        RefreshDerived();

        _isTesting = true;
        _testResult = null;

        try
        {
            _testResult = await TemplateService.TestTemplateAsync(_draft);
            if (_testResult.Success) Toast.Success("模板试运行成功，该模板在本机可以跑通");
            else Toast.Error("模板试运行失败，请看下方详情");
        }
        catch (Exception ex)
        {
            _testResult = new TemplateTestResult(false, $"试运行出错：{ex.Message}", string.Empty, string.Empty, TimeSpan.Zero);
            Toast.Error($"试运行出错：{ex.Message}");
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return; // 防止双击 / 重复提交

        NormalizeDraft();
        RefreshDerived();

        if (ErrorCount > 0)
        {
            Toast.Warning($"还有 {ErrorCount} 个错误未修正，无法保存。");
            return;
        }

        _isSaving = true;

        try
        {
            // 用数据库里是否真的存在这个 Id 来决定「新建」还是「更新」，
            // 不依赖父组件传进来的是 null 还是一个空的 CommandTemplate。
            var isNew = await TemplateService.GetTemplateByIdAsync(_draft.Id) is null;
            _isNew = isNew;

            var saved = _draft;

            if (IsSystem)
            {
                if (isNew)
                {
                    saved = await TemplateService.CreateSystemTemplateAsync(_draft);
                }
                else if (!await TemplateService.UpdateSystemTemplateAsync(_draft))
                {
                    Toast.Error("保存失败：系统预设可能已被删除，请刷新页面后重试。");
                    return;
                }
            }
            else
            {
                if (isNew)
                {
                    saved = await TemplateService.CreateTemplateAsync(_draft);
                }
                else if (!await TemplateService.UpdateTemplateAsync(_draft))
                {
                    Toast.Error("保存失败：模板可能已被删除，或它是系统预设（系统预设请在系统模板管理中编辑）。");
                    return;
                }
            }

            var finalName = string.IsNullOrWhiteSpace(saved?.Name) ? _draft.Name : saved!.Name;
            Toast.Success($"模板「{finalName}」已保存");

            // 已写进数据库，关闭时不再提示「未保存的修改」
            _originalFingerprint = Fingerprint(_draft);

            await OnSaved.InvokeAsync(saved ?? _draft);
            await CloseModalAsync();
        }
        catch (Exception ex)
        {
            Toast.Error($"保存失败：{ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>保存 / 试运行前统一规范化一次（与服务端 NormalizeTemplate 的行为保持一致）</summary>
    private void NormalizeDraft()
    {
        _draft.Name = (_draft.Name ?? string.Empty).Trim().Trim('{', '}');
        _draft.Description = (_draft.Description ?? string.Empty).Trim();
        _draft.CommandArgs = (_draft.CommandArgs ?? string.Empty).Trim();
        _draft.Category = (_draft.Category ?? string.Empty).Trim();
        _draft.OutputExtension = NormalizeExtension(_draft.OutputExtension);
        _draft.TargetCodec = (_draft.TargetCodec ?? string.Empty).Trim();
        _draft.RequiredEncoder = string.IsNullOrWhiteSpace(_draft.RequiredEncoder) ? null : _draft.RequiredEncoder.Trim();
        _draft.RequiresHardwareAcceleration = _draft.HardwareMode == HardwareAccelerationMode.Required;
        if (_draft.HardwareMode == HardwareAccelerationMode.None) _draft.RequiredEncoder = null;

        _draft.SupportedInputFormats = SplitFormats(_inputFormatsText);
        _inputFormatsText = string.Join(", ", _draft.SupportedInputFormats);
        _draft.Tags = SplitTags(_tagsText);
        _tagsText = string.Join(", ", _draft.Tags);

        foreach (var parameter in _draft.Parameters)
        {
            parameter.Name = NormalizePlaceholderName(parameter.Name);
            parameter.Label = (parameter.Label ?? string.Empty).Trim();
            parameter.Description = (parameter.Description ?? string.Empty).Trim();
            parameter.DefaultValue ??= string.Empty;

            foreach (var option in parameter.Options)
            {
                option.Value = (option.Value ?? string.Empty).Trim();
                option.Label = string.IsNullOrWhiteSpace(option.Label) ? option.Value : option.Label.Trim();
                option.Description = (option.Description ?? string.Empty).Trim();
            }
        }
    }

    // ────────────────────────────────────────────────────────────────
    // 深拷贝 / 脏检查
    // ────────────────────────────────────────────────────────────────

    private static CommandTemplate CloneTemplate(CommandTemplate? source)
    {
        var clone = new CommandTemplate();

        if (source is null) return clone;

        clone.Id = source.Id ?? ObjectId.NewObjectId();
        clone.Name = source.Name ?? string.Empty;
        clone.Description = source.Description ?? string.Empty;
        clone.CommandArgs = source.CommandArgs ?? string.Empty;
        clone.Type = source.Type;
        clone.Category = source.Category ?? string.Empty;
        clone.SupportedInputFormats = source.SupportedInputFormats is null
            ? new List<string>()
            : [.. source.SupportedInputFormats];
        clone.OutputExtension = source.OutputExtension ?? string.Empty;
        clone.TargetCodec = source.TargetCodec ?? string.Empty;
        clone.HardwareMode = source.HardwareMode;
        clone.RequiresHardwareAcceleration = source.HardwareMode == HardwareAccelerationMode.Required;
        clone.RequiredEncoder = source.RequiredEncoder;
        clone.Parameters = source.Parameters is null ? new List<TemplateParameter>() : source.Parameters
            .Select(parameter => new TemplateParameter
            {
                Name = parameter.Name ?? string.Empty,
                Label = parameter.Label ?? string.Empty,
                Description = parameter.Description ?? string.Empty,
                Kind = parameter.Kind,
                DefaultValue = parameter.DefaultValue ?? string.Empty,
                Options = parameter.Options is null
                    ? new List<TemplateParameterOption>()
                    : parameter.Options
                        .Select(option => new TemplateParameterOption(
                            option.Value ?? string.Empty,
                            option.Label ?? string.Empty,
                            option.Description ?? string.Empty))
                        .ToList(),
                Min = parameter.Min,
                Max = parameter.Max,
                TrueValue = parameter.TrueValue ?? string.Empty,
                FalseValue = parameter.FalseValue ?? string.Empty
            })
            .ToList();
        clone.Tags = source.Tags is null ? new List<string>() : [.. source.Tags];
        clone.IsRecommended = source.IsRecommended;
        clone.PresetVersion = source.PresetVersion;
        clone.CreatedAt = source.CreatedAt;
        clone.UpdatedAt = source.UpdatedAt;
        clone.SortOrder = source.SortOrder;

        return clone;
    }

    /// <summary>把模板序列化成稳定字符串，用来判断是否有未保存的修改</summary>
    private static string Fingerprint(CommandTemplate template)
    {
        var builder = new StringBuilder();

        void Field(string? value) => builder.Append(value ?? string.Empty).Append('\u001f');

        Field(template.Name);
        Field(template.Description);
        Field(template.CommandArgs);
        Field(template.Category);
        Field(template.OutputExtension);
        Field(template.TargetCodec);
        Field(((int)template.HardwareMode).ToString(CultureInfo.InvariantCulture));
        Field(template.RequiredEncoder);
        Field(template.SortOrder.ToString(CultureInfo.InvariantCulture));
        Field(template.IsRecommended ? "1" : "0");

        builder.Append('\u001e');
        foreach (var format in template.SupportedInputFormats) Field(format);

        builder.Append('\u001e');
        foreach (var tag in template.Tags) Field(tag);

        builder.Append('\u001e');
        foreach (var parameter in template.Parameters)
        {
            Field(parameter.Name);
            Field(parameter.Label);
            Field(parameter.Description);
            Field(((int)parameter.Kind).ToString(CultureInfo.InvariantCulture));
            Field(parameter.DefaultValue);
            Field(parameter.TrueValue);
            Field(parameter.FalseValue);
            Field(parameter.Min?.ToString("R", CultureInfo.InvariantCulture));
            Field(parameter.Max?.ToString("R", CultureInfo.InvariantCulture));

            foreach (var option in parameter.Options)
            {
                Field(option.Value);
                Field(option.Label);
                Field(option.Description);
            }

            builder.Append('\u001d');
        }

        return builder.ToString();
    }
