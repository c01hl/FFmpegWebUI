@using System.Text
@using LiteDB
@using FFmpegWebUI.Models
@using FFmpegWebUI.Services
@inject ITemplateService TemplateService
@inject IFFmpegService FFmpeg
@inject IHardwareDetectionService HardwareDetection
@inject IToastService Toast
@inject IJSRuntime JS

@*
    模板编辑器（新建 / 编辑模板与系统预设）。

    设计要点：
    - 一律在 _draft（深拷贝）上编辑，绝不修改 Template 参数；
    - 校验、命令预览、占位符使用情况全部来自服务层
      （ITemplateService.Validate / IFFmpegService.BuildCommand / CommandLineBuilder.ExtractPlaceholders），
      界面里不重复实现一套“近似校验”；
    - 关闭有未保存修改时用 ConfirmDialog 二次确认，不静默丢弃；
    - 试运行会真的在本机跑一次 FFmpeg，作者可以在保存前确认模板可用。

    Modal 只有一个渲染片段（隐式 ChildContent），因此底部按钮栏是内容里的最后一个元素。
*@

<Modal IsOpen="IsOpen" IsOpenChanged="OnModalIsOpenChanged" Title="@Title" Size="xl"
       DisableClose="@(_isSaving || _isTesting)">

    <div class="te-badges">
        <span class="ffui-badge @(IsSystem ? "ffui-badge-primary" : "ffui-badge-info")">
            @(IsSystem ? "系统预设" : "用户模板")
        </span>
        <span class="ffui-badge">@(_isNew ? "新建" : "编辑")</span>
    </div>

    @if (_isLoading)
    {
        <div class="ffui-loading-row">
            <span class="spinner" aria-hidden="true"></span>
            <span>正在读取分类与硬件编码器状态…</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="ffui-alert ffui-alert-warning" role="status">
            <span aria-hidden="true">⚠️</span>
            <span>辅助信息加载失败：@_loadError（不影响手动填写与保存）</span>
        </div>
    }

    @if (IsSystem)
    {
        <div class="ffui-alert ffui-alert-info" role="note">
            <span aria-hidden="true">ℹ️</span>
            <span>系统预设可以编辑，但应用升级时同名预设会被内置内容覆盖（按预设版本同步）。需要长期保留修改，请改完后复制成普通模板。</span>
        </div>
    }

    @* ── 基本信息 ─────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">基本信息</h3>

        <div class="te-grid">
            <div class="te-field">
                <label for="te-name">模板名称 <span class="te-req" aria-hidden="true">*</span></label>
                <input id="te-name" type="text" value="@_draft.Name" @oninput="OnNameInput" @onblur="NormalizeName"
                       placeholder="例如：压缩 · 均衡（CRF 23）" />
            </div>

            <div class="te-field">
                <label for="te-category">分类</label>
                <input id="te-category" type="text" list="ffui-template-editor-categories"
                       value="@_draft.Category" @onchange="OnCategoryChanged"
                       placeholder="选择已有分类，或直接输入新分类" />
                <datalist id="ffui-template-editor-categories">
                    @foreach (var category in _existingCategories)
                    {
                        <option value="@category"></option>
                    }
                </datalist>
                <span class="te-hint">留空会保存为「未分类」。</span>
            </div>
        </div>

        @if (DuplicateName is { } duplicate)
        {
            <div class="ffui-alert ffui-alert-warning" role="status">
                <span aria-hidden="true">⚠️</span>
                <span>
                    已经有同名模板「@duplicate.Name」（@(duplicate.Type == TemplateType.System ? "系统预设" : "用户模板")）。
                    保存时服务会自动改名（追加序号）；如果这是有意覆盖同名模板，请忽略这条提示。
                </span>
            </div>
        }

        <div class="te-field">
            <label for="te-description">描述</label>
            <textarea id="te-description" rows="2" value="@_draft.Description" @onchange="OnDescriptionChanged"
                      placeholder="一句话说明这个模板做什么、什么场景用"></textarea>
        </div>

        <div class="te-grid">
            <div class="te-field">
                <label for="te-extension">输出扩展名 <span class="te-req" aria-hidden="true">*</span></label>
                <input id="te-extension" type="text" value="@_draft.OutputExtension" @oninput="OnExtensionInput"
                       @onblur="NormalizeExtensionField" placeholder="mp4" />
                <span class="te-hint">不需要写点号，会自动转成小写（mp4 / mkv / mp3 …）。</span>
            </div>

            <div class="te-field">
                <label for="te-sortorder">排序权重</label>
                <input id="te-sortorder" type="number" value="@_draft.SortOrder" @onchange="OnSortOrderChanged" />
                <span class="te-hint">数字越小越靠前。</span>
            </div>
        </div>

        <div class="te-field">
            <label for="te-formats">支持的输入格式</label>
            <input id="te-formats" type="text" value="@_inputFormatsText" @oninput="OnFormatsInput"
                   @onblur="NormalizeFormatsText" placeholder="mp4, mkv, avi（逗号或空格分隔）" />
            <span class="te-hint">留空表示不限格式；会自动去点号、转小写、去重。</span>
            @if (_draft.SupportedInputFormats.Count > 0)
            {
                <div class="te-chips">
                    @foreach (var format in _draft.SupportedInputFormats)
                    {
                        <span class="ffui-badge ffui-badge-info" @key="format">
                            @format
                            <button type="button" class="te-chip-remove" aria-label="移除输入格式 @format"
                                    @onclick="() => RemoveFormat(format)">✕</button>
                        </span>
                    }
                </div>
            }
        </div>

        <div class="te-field">
            <label for="te-tags">标签</label>
            <input id="te-tags" type="text" value="@_tagsText" @oninput="OnTagsInput" @onblur="NormalizeTagsText"
                   placeholder="压缩, 归档, 手机（逗号或空格分隔）" />
            @if (_draft.Tags.Count > 0)
            {
                <div class="te-chips">
                    @foreach (var tag in _draft.Tags)
                    {
                        <span class="ffui-badge" @key="tag">
                            @tag
                            <button type="button" class="te-chip-remove" aria-label="移除标签 @tag"
                                    @onclick="() => RemoveTag(tag)">✕</button>
                        </span>
                    }
                </div>
            }
        </div>

        <div class="te-check">
            <input id="te-recommended" type="checkbox" checked="@_draft.IsRecommended" @onchange="OnRecommendedChanged" />
            <label for="te-recommended">在模板列表中标记为推荐</label>
        </div>
    </section>

    @* ── 命令参数 ─────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">FFmpeg 命令参数</h3>

        <div class="te-field">
            <label for="te-command">命令参数 <span class="te-req" aria-hidden="true">*</span></label>
            <textarea id="te-command" rows="5" value="@_draft.CommandArgs" @oninput="OnCommandInput"
                      @ref="_commandElement"
                      placeholder="-i &quot;{input}&quot; -c:v {encoder} {quality_args} {preset_args} {hwupload_args} -c:a aac &quot;{output}&quot;"></textarea>
            <span class="te-hint">
                不含 ffmpeg 本身；不要写 -y / -n（执行层会按「文件已存在时的处理方式」自动添加）。
                含空格的路径写成 "{input}" 这种带引号的形式。
            </span>
        </div>

        <div class="te-insert-row">
            <div class="te-field te-field-inline">
                <label for="te-placeholder-select">内置占位符</label>
                <select id="te-placeholder-select" @bind="_selectedPlaceholder">
                    @foreach (var group in PlaceholderGroups)
                    {
                        <optgroup label="@group.Title">
                            @foreach (var placeholder in group.Items)
                            {
                                <option value="@placeholder.Name" @key="placeholder.Name">
                                    @Braced(placeholder.Name) — @placeholder.Description
                                </option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <button type="button" class="ffui-btn" @onclick="InsertSelectedPlaceholderAsync">插入占位符</button>
        </div>
        <span class="te-hint">
            浏览器端拿不到可靠的光标位置（app.js 里没有「插入到光标」的函数），所以这里只有一种行为：把选中的占位符追加到命令末尾。
        </span>

        <details class="te-details">
            <summary>全部内置占位符说明（共 @CommandLineBuilder.BuiltInPlaceholders.Count 个）</summary>
            <table class="te-table">
                <thead>
                    <tr>
                        <th scope="col">占位符</th>
                        <th scope="col">含义</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in PlaceholderGroups)
                    {
                        <tr @key="group.Title">
                            <th scope="colgroup" colspan="2" class="te-table-group">@group.Title</th>
                        </tr>
                        @foreach (var placeholder in group.Items)
                        {
                            <tr @key="placeholder.Name">
                                <td class="te-mono">@Braced(placeholder.Name)</td>
                                <td>@placeholder.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </details>
    </section>

    @* ── 命令预览 ─────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">命令预览</h3>
        <div class="te-insert-row">
            <span class="te-hint">
                按各参数的默认值展开；{"{input}"} 与 {"{output}"} 用占位路径代替。
            </span>
            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="CopyCommandAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_previewCommand))">
                📋 复制
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_previewError))
        {
            <div class="ffui-alert ffui-alert-danger" role="status">
                <span aria-hidden="true">❌</span>
                <span>命令预览生成失败：@_previewError</span>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(_previewCommand))
        {
            <div class="ffui-alert ffui-alert-warning" role="status">
                <span aria-hidden="true">⚠️</span>
                <span>命令参数为空，暂时无法生成预览。</span>
            </div>
        }
        else
        {
            <pre class="te-code">ffmpeg @_previewCommand</pre>
        }

        @if (_previewWarnings.Count > 0)
        {
            <div class="ffui-alert ffui-alert-warning" role="status">
                <span aria-hidden="true">⚠️</span>
                <div>
                    @for (var i = 0; i < _previewWarnings.Count; i++)
                    {
                        <div @key="i">@_previewWarnings[i]</div>
                    }
                </div>
            </div>
        }
    </section>

    @* ── 试运行 ───────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">试运行</h3>
        <div class="te-insert-row">
            <button type="button" class="ffui-btn" @onclick="RunTestAsync" disabled="@_isTesting">
                @if (_isTesting)
                {
                    <span class="spinner" aria-hidden="true"></span>
                    <span>试运行中…</span>
                }
                else
                {
                    <span>🧪 试运行模板</span>
                }
            </button>
            <span class="te-hint">
                会用 FFmpeg 合成 3 秒测试素材真实执行一次，可验证模板在<b>本机</b>能否跑通（通常几秒钟）。
            </span>
        </div>

        @if (_testResult is { } test)
        {
            <div class="ffui-alert @(test.Success ? "ffui-alert-success" : "ffui-alert-danger")" role="status" aria-live="polite">
                <span aria-hidden="true">@(test.Success ? "✅" : "❌")</span>
                <div class="te-test-body">
                    <div>@test.Message</div>
                    <div class="te-hint">耗时 @FormatDuration(test.Duration)</div>
                    @if (!string.IsNullOrWhiteSpace(test.Command))
                    {
                        <pre class="te-code">@test.Command</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(test.Output))
                    {
                        <details>
                            <summary>FFmpeg 输出（诊断信息）</summary>
                            <pre class="te-code">@test.Output</pre>
                        </details>
                    }
                </div>
            </div>
        }
    </section>

    @* ── 校验结果 ─────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">校验结果（实时）</h3>
        <div aria-live="polite">
            @if (_issues.Count == 0)
            {
                <div class="ffui-alert ffui-alert-success" role="status">
                    <span aria-hidden="true">✅</span>
                    <span>没有发现问题。</span>
                </div>
            }
            else
            {
                for (var i = 0; i < _issues.Count; i++)
                {
                    var issue = _issues[i];
                    <div class="ffui-alert @IssueClass(issue)" role="status" @key="i">
                        <span aria-hidden="true">@IssueIcon(issue)</span>
                        <div>
                            <span class="te-issue-label">@IssueLabel(issue)</span>
                            @issue.Message
                            @if (FieldLabel(issue.Field) is { } fieldLabel)
                            {
                                <span class="te-hint">（字段：@fieldLabel）</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        <span class="te-hint">这里是 ITemplateService.Validate 的完整结果（错误 / 警告 / 提示）；存在错误时无法保存。</span>
    </section>

    @* ── 参数 ─────────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">参数（@_draft.Parameters.Count）</h3>
        <div class="te-insert-row te-wrap">
            <span class="te-hint">添加常用参数：</span>
            @foreach (var preset in ParameterPresets)
            {
                <button type="button" class="ffui-btn ffui-btn-sm" @key="preset.Key"
                        @onclick="() => AddPresetParameter(preset.Key)">@preset.Label</button>
            }
        </div>

        @if (UndeclaredPlaceholders.Count > 0)
        {
            <div class="ffui-alert ffui-alert-warning" role="status">
                <span aria-hidden="true">⚠️</span>
                <div>
                    <div>命令里用到、但没有声明的占位符（保存后用户无法为它们填值）：</div>
                    <div class="te-chips">
                        @foreach (var name in UndeclaredPlaceholders)
                        {
                            <span class="ffui-badge ffui-badge-warning" @key="name">
                                @Braced(name)
                                <button type="button" class="te-chip-remove" aria-label="为 @name 创建参数"
                                        @onclick="() => DeclarePlaceholder(name)">＋</button>
                            </span>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_draft.Parameters.Count == 0)
        {
            <div class="ffui-empty-state">
                还没有声明任何参数。无参数模板也能用，只是用户在转换时无法调整这一项。
            </div>
        }

        @for (var i = 0; i < _draft.Parameters.Count; i++)
        {
            var index = i;
            var parameter = _draft.Parameters[i];
            <div class="te-param" @key="parameter">
                <div class="te-param-head">
                    <span class="ffui-badge ffui-badge-primary">#@(index + 1)</span>
                    @if (IsParameterUsed(parameter))
                    {
                        <span class="ffui-badge ffui-badge-success">命令中已使用</span>
                    }
                    else
                    {
                        <span class="ffui-badge ffui-badge-warning">命令中未使用</span>
                    }
                    <span class="te-spacer"></span>
                    <button type="button" class="ffui-icon-btn" aria-label="上移参数 @parameter.Name"
                            disabled="@(index == 0)" @onclick="() => MoveParameter(index, -1)">↑</button>
                    <button type="button" class="ffui-icon-btn" aria-label="下移参数 @parameter.Name"
                            disabled="@(index == _draft.Parameters.Count - 1)" @onclick="() => MoveParameter(index, 1)">↓</button>
                    <button type="button" class="ffui-icon-btn" aria-label="删除参数 @parameter.Name"
                            @onclick="() => RemoveParameter(index)">✕</button>
                </div>

                <div class="te-grid">
                    <div class="te-field">
                        <label for="te-p@(index)-name">参数名（占位符）</label>
                        <input id="te-p@(index)-name" type="text" value="@parameter.Name"
                               @onchange="e => OnParameterNameChanged(index, e)"
                               @onblur="() => NormalizeParameterName(index)" placeholder="quality" />
                        <span class="te-hint">命令里用 @Braced(parameter.Name) 引用；会自动转小写、去花括号、非法字符换成下划线。</span>
                    </div>

                    <div class="te-field">
                        <label for="te-p@(index)-label">界面显示名称</label>
                        <input id="te-p@(index)-label" type="text" value="@parameter.Label"
                               @onchange="e => OnParameterLabelChanged(index, e)" placeholder="质量" />
                    </div>

                    <div class="te-field">
                        <label for="te-p@(index)-kind">控件类型</label>
                        <select id="te-p@(index)-kind" value="@parameter.Kind" @onchange="e => OnParameterKindChanged(index, e)">
                            <option value="@TemplateParameterKind.Select">下拉选择</option>
                            <option value="@TemplateParameterKind.Number">数字输入</option>
                            <option value="@TemplateParameterKind.Text">文本输入</option>
                            <option value="@TemplateParameterKind.Boolean">开关（是 / 否）</option>
                        </select>
                    </div>

                    <div class="te-field">
                        <label for="te-p@(index)-default">默认值</label>
                        <input id="te-p@(index)-default" type="text" value="@parameter.DefaultValue"
                               @onchange="e => OnParameterDefaultChanged(index, e)" placeholder="留空表示不设置" />
                    </div>
                </div>

                <div class="te-field">
                    <label for="te-p@(index)-description">帮助说明</label>
                    <input id="te-p@(index)-description" type="text" value="@parameter.Description"
                           @onchange="e => OnParameterDescriptionChanged(index, e)" placeholder="显示在参数控件下方的一句话说明" />
                </div>

                @if (!IsValidPlaceholderName(parameter.Name))
                {
                    <div class="ffui-alert ffui-alert-warning" role="status">
                        <span aria-hidden="true">⚠️</span>
                        <span>参数名无效：只允许小写字母、数字和下划线，且不能以数字开头，否则 @Braced(parameter.Name) 不会被识别成占位符。</span>
                    </div>
                }

                @if (parameter.Kind == TemplateParameterKind.Number)
                {
                    <div class="te-grid">
                        <div class="te-field">
                            <label for="te-p@(index)-min">最小值</label>
                            <input id="te-p@(index)-min" type="number" step="any" value="@parameter.Min"
                                   @onchange="e => OnParameterMinChanged(index, e)" />
                        </div>
                        <div class="te-field">
                            <label for="te-p@(index)-max">最大值</label>
                            <input id="te-p@(index)-max" type="number" step="any" value="@parameter.Max"
                                   @onchange="e => OnParameterMaxChanged(index, e)" />
                        </div>
                    </div>
                }

                @if (parameter.Kind == TemplateParameterKind.Boolean)
                {
                    <div class="te-grid">
                        <div class="te-field">
                            <label for="te-p@(index)-true">开启时替换成</label>
                            <input id="te-p@(index)-true" type="text" value="@parameter.TrueValue"
                                   @onchange="e => OnParameterTrueChanged(index, e)" placeholder="1" />
                        </div>
                        <div class="te-field">
                            <label for="te-p@(index)-false">关闭时替换成</label>
                            <input id="te-p@(index)-false" type="text" value="@parameter.FalseValue"
                                   @onchange="e => OnParameterFalseChanged(index, e)" placeholder="留空表示移除该片段" />
                        </div>
                    </div>
                }

                @if (parameter.Kind == TemplateParameterKind.Select)
                {
                    <div class="te-options">
                        <div class="te-param-head">
                            <span class="te-hint">下拉选项（@parameter.Options.Count）</span>
                            <span class="te-spacer"></span>
                            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => AddOption(index)">＋ 添加选项</button>
                        </div>
                        @if (parameter.Options.Count == 0)
                        {
                            <div class="ffui-alert ffui-alert-warning" role="status">
                                <span aria-hidden="true">⚠️</span>
                                <span>下拉参数至少需要一个选项，否则转换时用户没有可选的值。</span>
                            </div>
                        }
                        @for (var j = 0; j < parameter.Options.Count; j++)
                        {
                            var optionIndex = j;
                            var option = parameter.Options[j];
                            <div class="te-option-row" @key="option">
                                <div class="te-field">
                                    <label class="visually-hidden" for="te-p@(index)-opt@(optionIndex)-value">选项值</label>
                                    <input id="te-p@(index)-opt@(optionIndex)-value" type="text" value="@option.Value"
                                           @onchange="e => OnOptionValueChanged(index, optionIndex, e)" placeholder="值" />
                                </div>
                                <div class="te-field">
                                    <label class="visually-hidden" for="te-p@(index)-opt@(optionIndex)-label">显示文本</label>
                                    <input id="te-p@(index)-opt@(optionIndex)-label" type="text" value="@option.Label"
                                           @onchange="e => OnOptionLabelChanged(index, optionIndex, e)" placeholder="显示文本" />
                                </div>
                                <div class="te-field">
                                    <label class="visually-hidden" for="te-p@(index)-opt@(optionIndex)-description">选项说明</label>
                                    <input id="te-p@(index)-opt@(optionIndex)-description" type="text" value="@option.Description"
                                           @onchange="e => OnOptionDescriptionChanged(index, optionIndex, e)" placeholder="说明（可选）" />
                                </div>
                                <div class="te-option-actions">
                                    <button type="button" class="ffui-icon-btn" aria-label="上移选项"
                                            disabled="@(optionIndex == 0)" @onclick="() => MoveOption(index, optionIndex, -1)">↑</button>
                                    <button type="button" class="ffui-icon-btn" aria-label="下移选项"
                                            disabled="@(optionIndex == parameter.Options.Count - 1)"
                                            @onclick="() => MoveOption(index, optionIndex, 1)">↓</button>
                                    <button type="button" class="ffui-icon-btn" aria-label="删除选项"
                                            @onclick="() => RemoveOption(index, optionIndex)">✕</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div>
            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="AddEmptyParameter">＋ 添加空参数</button>
        </div>
    </section>

    @* ── 硬件加速 ─────────────────────────────────────────────── *@
    <section class="te-section">
        <h3 class="ffui-section-title">硬件加速</h3>

        <div class="te-grid">
            <div class="te-field">
                <label for="te-hardware-mode">硬件加速策略</label>
                <select id="te-hardware-mode" value="@_draft.HardwareMode" @onchange="OnHardwareModeChanged">
                    <option value="@HardwareAccelerationMode.None">不使用（纯软件编码）</option>
                    <option value="@HardwareAccelerationMode.Auto">自动（有硬件就用，没有回退软件）</option>
                    <option value="@HardwareAccelerationMode.Required">必须使用硬件（没有就失败）</option>
                </select>
                <span class="te-hint">「是否需要硬件加速」由这一项推导，两者不会再出现不一致。</span>
            </div>

            <div class="te-field">
                <label for="te-required-encoder">所需编码器</label>
                <select id="te-required-encoder" value="@(_draft.RequiredEncoder ?? string.Empty)"
                        @onchange="OnRequiredEncoderChanged"
                        disabled="@(_draft.HardwareMode == HardwareAccelerationMode.None)">
                    <option value="">（不指定）</option>
                    @if (UnknownEncoderOption is { } unknown)
                    {
                        <option value="@unknown.Value">@unknown.Label</option>
                    }
                    <optgroup label="按编码器族">
                        @foreach (var choice in FamilyEncoderChoices)
                        {
                            <option value="@choice.Value" @key="choice.Value">@choice.Label</option>
                        }
                    </optgroup>
                    <optgroup label="按具体编码器">
                        @foreach (var choice in ConcreteEncoderChoices)
                        {
                            <option value="@choice.Value" @key="choice.Value">@choice.Label</option>
                        }
                    </optgroup>
                </select>
                <span class="te-hint">
                    「不使用」时会清空这一项；标记「（本机不可用）」的选项仍可选——模板也可能是为别的机器准备的。
                    @if (DetectionLabel.Length > 0)
                    {
                        <span>本机可用性来自 @DetectionLabel 的硬件检测。</span>
                    }
                    else if (_isLoading)
                    {
                        <span>正在检测本机编码器，完成后会刷新标记…</span>
                    }
                </span>
            </div>

            <div class="te-field">
                <label for="te-target-codec">目标编码格式</label>
                <select id="te-target-codec" value="@_draft.TargetCodec" @onchange="OnTargetCodecChanged">
                    <option value="">自动推断</option>
                    @foreach (var codec in CodecChoices)
                    {
                        <option value="@codec.Value" @key="codec.Value">@codec.Label</option>
                    }
                </select>
                <span class="te-hint">决定 {encoder} 会挑哪一类编码器，也决定没有硬件时回退到哪个软件编码器。</span>
            </div>
        </div>

        <div class="ffui-alert ffui-alert-info" role="note">
            <span aria-hidden="true">ℹ️</span>
            <div>
                <div>
                    硬件加速模板推荐用 {encoder} + {quality_args} + {preset_args} + {hwupload_args} 组合：
                </div>
                <ul class="te-list">
                    <li>{encoder}：按目标格式和本机硬件自动挑编码器（h264_nvenc / h264_qsv / h264_videotoolbox / h264_vaapi / libx264 …）。</li>
                    <li>{quality_args}：展开成当前编码器真正接受的质量参数（-crf / -cq / -qp / -q:v / -global_quality …），由名为 quality 的参数驱动。</li>
                    <li>{preset_args}：展开成该编码器的预设参数（如 -preset medium / -quality balanced）。</li>
                    <li>{hwupload_args}：需要把帧上传到显存时补上滤镜（VA-API 的 format=nv12,hwupload）。</li>
                </ul>
                <div>
                    不要硬写 -crf：硬件编码器不接受它，FFmpeg 只会打印一条警告然后忽略，命令照样成功退出，
                    画质却完全没变——这种「看起来生效了」的模板最难排查。上面的校验会用警告提示这种情况。
                </div>
            </div>
        </div>
    </section>

    @* 底部按钮栏：Modal 只有一个渲染片段，所以它是内容的最后一个元素 *@
    <div class="ffui-modal-footer te-footer te-footer-sticky">
        @if (ErrorCount > 0)
        {
            <span class="ffui-badge ffui-badge-danger">@ErrorCount 个错误，无法保存</span>
        }
        else if (WarningCount > 0)
        {
            <span class="ffui-badge ffui-badge-warning">@WarningCount 个警告</span>
        }
        @if (_isTesting)
        {
            <span class="ffui-badge ffui-badge-info">试运行中…</span>
        }
        <span class="te-spacer"></span>
        <button type="button" class="ffui-btn" @onclick="RequestCloseAsync" disabled="@(_isSaving || _isTesting)">取消</button>
        <button type="button" class="ffui-btn ffui-btn-primary" @onclick="SaveAsync"
                disabled="@(_isSaving || ErrorCount > 0)">
            @if (_isSaving)
            {
                <span class="spinner" aria-hidden="true"></span>
                <span>保存中…</span>
            }
            else
            {
                <span>保存</span>
            }
        </button>
    </div>
</Modal>

<ConfirmDialog IsOpen="_confirmDiscardOpen" IsOpenChanged="OnDiscardDialogOpenChanged"
               Title="放弃未保存的修改？" Message="@DiscardMessage"
               Detail="关闭后会丢失本次编辑的全部内容，此操作无法撤销。"
               ConfirmText="放弃修改" CancelText="继续编辑" Danger="true"
               OnConfirm="DiscardAndCloseAsync" OnCancel="CancelDiscard" />

