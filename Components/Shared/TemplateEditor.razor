    /// <summary>参数是否真的会被命令用到（quality / q / crf 通过 {quality_args} 间接生效）</summary>
    private bool IsParameterUsed(TemplateParameter parameter)
    {
        var name = parameter.Name?.Trim() ?? string.Empty;
        if (name.Length == 0) return false;
        if (_usedPlaceholders.Contains(name)) return true;

        return name is "quality" or "q" or "crf"
            && (_usedPlaceholders.Contains("quality_args")
                || _usedPlaceholders.Contains("crf")
                || _usedPlaceholders.Contains("quality")
                || _usedPlaceholders.Contains("q"));
    }

    private IReadOnlyList<string> UndeclaredPlaceholders
    {
        get
        {
            var declared = _draft.Parameters
                .Select(parameter => (parameter.Name ?? string.Empty).Trim())
                .Where(name => name.Length > 0)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            return _usedPlaceholders
                .Where(name => !CommandLineBuilder.BuiltInPlaceholders.Contains(name))
                .Where(name => !declared.Contains(name))
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

