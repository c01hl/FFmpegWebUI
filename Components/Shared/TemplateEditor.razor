@code {
    // ────────────────────────────────────────────────────────────────
    // 参数契约（其它页面依赖，勿改签名）
    // ────────────────────────────────────────────────────────────────

    /// <summary>要编辑的模板；null 表示新建</summary>
    [Parameter] public CommandTemplate? Template { get; set; }

    /// <summary>是否显示</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>显示状态变化回调（配合 @bind-IsOpen）</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>true 表示编辑 / 新建系统预设（走 Create/UpdateSystemTemplateAsync）</summary>
    [Parameter] public bool IsSystem { get; set; }

    /// <summary>保存成功后回调（返回实际保存的模板，可能被服务改名）</summary>
    [Parameter] public EventCallback<CommandTemplate> OnSaved { get; set; }

    // ────────────────────────────────────────────────────────────────
    // 状态
    // ────────────────────────────────────────────────────────────────

    /// <summary>编辑中的深拷贝，绝不直接改 Template</summary>
    private CommandTemplate _draft = new();

    /// <summary>打开时克隆的源对象，用于判断「重新打开的是不是同一个模板」</summary>
    private CommandTemplate? _loadedTemplate;

    private bool _hasDraft;
    private bool _isNew = true;
    private bool _isSaving;
    private bool _isTesting;
    private bool _isLoading;
    private bool _confirmDiscardOpen;

    private string _originalFingerprint = string.Empty;
    private string _inputFormatsText = string.Empty;
    private string _tagsText = string.Empty;
    private string _selectedPlaceholder = "encoder";
    private string _previewCommand = string.Empty;
    private string _previewError = string.Empty;
    private string _loadError = string.Empty;

    private IReadOnlyList<string> _previewWarnings = [];
    private IReadOnlyList<TemplateIssue> _issues = [];
    private HashSet<string> _usedPlaceholders = new(StringComparer.OrdinalIgnoreCase);

    private List<string> _existingCategories = [];
    private List<CommandTemplate> _allTemplates = [];
    private HashSet<string>? _availableEncoders;
    private DateTime? _detectedAt;
    private List<EncoderChoice> _encoderOptions = [];

    private TemplateTestResult? _testResult;
    private ElementReference _commandElement;

    /// <summary>打开 / 重新加载的序号，避免迟到的异步结果覆盖新一轮状态</summary>
    private int _loadVersion;

    // ────────────────────────────────────────────────────────────────
    // 生命周期：打开时深拷贝，关闭时清理
    // ────────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            if (!_hasDraft)
            {
                _hasDraft = true;
                BeginLoad();
            }
            else if (!SameId(Template?.Id, _loadedTemplate?.Id) && !IsDirty)
            {
                // 父组件在同一次打开期间换成了另一个模板（例如先 IsOpen=true 再设置 Template）。
                // 只有没编辑过时才重新加载，避免覆盖用户正在填的内容。
                BeginLoad();
            }
        }
        else if (_hasDraft)
        {
            _hasDraft = false;
            ResetDraft();
        }
    }

    private void BeginLoad()
    {
        var source = Template;

        // 防御：如果父组件在脏状态下重新打开同一个模板，保留用户正在编辑的内容
        if (IsDirty && ReferenceEquals(source, _loadedTemplate)) return;

        _loadedTemplate = source;
        // 页面可能传 null，也可能传一个空的 CommandTemplate 表示新建；保存前还会用
        // GetTemplateByIdAsync 做一次权威判断，这里只是为了标题不闪错。
        _isNew = source is null
                 || (string.IsNullOrWhiteSpace(source.Name) && string.IsNullOrWhiteSpace(source.CommandArgs));
        _draft = CloneTemplate(source);
        _originalFingerprint = Fingerprint(_draft);
        _inputFormatsText = string.Join(", ", _draft.SupportedInputFormats);
        _tagsText = string.Join(", ", _draft.Tags);
        _selectedPlaceholder = "encoder";
        _testResult = null;
        _previewError = string.Empty;
        _loadError = string.Empty;
        _confirmDiscardOpen = false;
        _existingCategories = [];
        _allTemplates = [];
        _availableEncoders = null;
        _detectedAt = null;

        RefreshDerived();
        BuildEncoderOptions();

        _isLoading = true;
        var version = ++_loadVersion;
        _ = LoadLookupsAsync(version);
    }

    /// <summary>分类 / 同名模板 / 本机编码器可用性——异步加载，不阻塞编辑器打开</summary>
    private async Task LoadLookupsAsync(int version)
    {
        try
        {
            var categoriesTask = TemplateService.GetCategoriesAsync();
            var templatesTask = TemplateService.GetAllTemplatesAsync();
            await Task.WhenAll(categoriesTask, templatesTask);

            if (version != _loadVersion) return;
            _existingCategories = await categoriesTask;
            _allTemplates = await templatesTask;

            // Template == null 只是「新建」的一种情况：页面也可能传一个空的 CommandTemplate。
            // 以数据库里是否存在同一个 Id 为准，避免把新建当成编辑（那样保存会失败）。
            if (!_allTemplates.Any(template => SameId(template.Id, _draft.Id))) _isNew = true;

            var report = HardwareDetection.LastReport ?? await HardwareDetection.DetectAsync();
            if (version != _loadVersion) return;

            _availableEncoders = report.Encoders
                .Where(encoder => encoder.IsAvailable)
                .Select(encoder => encoder.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _detectedAt = report.DetectedAt;
            BuildEncoderOptions();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Toast.Warning($"模板辅助信息加载失败：{ex.Message}");
        }
        finally
        {
            if (version == _loadVersion)
            {
                _isLoading = false;
                try
                {
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception)
                {
                    // 组件已经被移除（例如用户已经离开页面），此时没有任何界面可以提示
                }
            }
        }
    }

    private void ResetDraft()
    {
        _draft = new CommandTemplate();
        _loadedTemplate = null;
        _originalFingerprint = Fingerprint(_draft);
        _issues = [];
        _usedPlaceholders = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _previewCommand = string.Empty;
        _previewWarnings = [];
        _previewError = string.Empty;
        _testResult = null;
        _inputFormatsText = string.Empty;
        _tagsText = string.Empty;
        _confirmDiscardOpen = false;
        _loadVersion++;
    }

    // ────────────────────────────────────────────────────────────────
    // 关闭流程：脏检查 → ConfirmDialog
    // ────────────────────────────────────────────────────────────────

    private string Title => _isNew
        ? (IsSystem ? "新建系统预设" : "新建模板")
        : (IsSystem ? "编辑系统预设" : "编辑模板");

    private string DiscardMessage
    {
        get
        {
            var name = _draft.Name?.Trim() ?? string.Empty;
            return $"模板「{(name.Length > 0 ? name : "未命名")}」有未保存的修改。";
        }
    }

    private bool IsDirty => Fingerprint(_draft) != _originalFingerprint;

    /// <summary>
    /// Modal 在 Esc / 遮罩 / ✕ 时会先把自己的 IsOpen 置为 false，再用 false 调用这个回调。
    /// 有未保存修改（或正在保存/试运行）时，我们立刻用 true 回推一次，让父组件的
    /// @bind-IsOpen 保持打开，改用 ConfirmDialog 询问。
    /// </summary>
    private async Task OnModalIsOpenChanged(bool value)
    {
        if (value)
        {
            await IsOpenChanged.InvokeAsync(true);
            return;
        }

        if (_isSaving || _isTesting || IsDirty)
        {
            if (IsDirty && !_isSaving && !_isTesting) _confirmDiscardOpen = true;
            await IsOpenChanged.InvokeAsync(true);
            return;
        }

        await CloseModalAsync();
    }

    private async Task RequestCloseAsync()
    {
        if (_isSaving || _isTesting) return;

        if (IsDirty)
        {
            _confirmDiscardOpen = true;
            return;
        }

        await CloseModalAsync();
    }

    private Task OnDiscardDialogOpenChanged(bool value)
    {
        _confirmDiscardOpen = value;
        return Task.CompletedTask;
    }

    private Task CancelDiscard()
    {
        _confirmDiscardOpen = false;
        return Task.CompletedTask;
    }

    private async Task DiscardAndCloseAsync()
    {
        _confirmDiscardOpen = false;
        await CloseModalAsync();
    }

    private async Task CloseModalAsync()
    {
        IsOpen = false;
        ResetDraft();
        await IsOpenChanged.InvokeAsync(false);
    }

    // ────────────────────────────────────────────────────────────────
    // 校验 / 预览（每次改动后重算一次）
    // ────────────────────────────────────────────────────────────────

    private void RefreshDerived()
    {
        _issues = TemplateService.Validate(_draft)
            .OrderByDescending(issue => (int)issue.Severity)
            .ToList();

        _usedPlaceholders = new HashSet<string>(
            CommandLineBuilder.ExtractPlaceholders(_draft.CommandArgs),
            StringComparer.OrdinalIgnoreCase);

        _previewError = string.Empty;
        _previewWarnings = [];

        try
        {
            var context = new CommandContext
            {
                InputPath = "<输入文件>",
                OutputPath = "<输出文件>",
                Parameters = BuildPreviewParameters(),
                Encoder = ResolvePreviewEncoder()
            };

            var built = FFmpeg.BuildCommand(_draft, context);
            _previewCommand = built.CommandLine;
            _previewWarnings = built.Warnings;
        }
        catch (Exception ex)
        {
            _previewCommand = string.Empty;
            _previewError = ex.Message;
        }
    }

    /// <summary>预览用的参数值：每个参数取 DefaultValue</summary>
    private Dictionary<string, string> BuildPreviewParameters()
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var parameter in _draft.Parameters)
        {
            var name = parameter.Name?.Trim() ?? string.Empty;
            if (name.Length == 0) continue;
            values[name] = parameter.DefaultValue ?? string.Empty;
        }
        return values;
    }

    /// <summary>
    /// 预览用的编码器画像：具体编码器名优先；族名取该族优先级最高的画像；
    /// 其余情况回退到目标格式的软件编码器，这样 {quality_args} / {preset_args} 一定能展开。
    /// </summary>
    private EncoderProfile? ResolvePreviewEncoder()
    {
        var required = _draft.RequiredEncoder?.Trim();
        if (!string.IsNullOrEmpty(required))
        {
            var exact = EncoderCatalog.Find(required);
            if (exact is not null) return exact;

            var inFamily = EncoderCatalog.ByFamily(required)
                .OrderByDescending(profile => profile.SupportsCurrentPlatform)
                .ThenBy(profile => profile.SortPreference)
                .FirstOrDefault();
            if (inFamily is not null) return inFamily;
        }

        var codec = string.IsNullOrWhiteSpace(_draft.TargetCodec) ? "h264" : _draft.TargetCodec.Trim();
        return EncoderCatalog.SoftwareFallback(codec)
               ?? EncoderCatalog.SoftwareFallback("h264")
               ?? EncoderCatalog.Find("libx264");
    }

    private int ErrorCount => _issues.Count(issue => issue.Severity == TemplateIssueSeverity.Error);
    private int WarningCount => _issues.Count(issue => issue.Severity == TemplateIssueSeverity.Warning);

    private static string IssueClass(TemplateIssue issue) => issue.Severity switch
    {
        TemplateIssueSeverity.Error => "ffui-alert-danger",
        TemplateIssueSeverity.Warning => "ffui-alert-warning",
        _ => "ffui-alert-info"
    };

    private static string IssueIcon(TemplateIssue issue) => issue.Severity switch
    {
        TemplateIssueSeverity.Error => "❌",
        TemplateIssueSeverity.Warning => "⚠️",
        _ => "ℹ️"
    };

    private static string IssueLabel(TemplateIssue issue) => issue.Severity switch
    {
        TemplateIssueSeverity.Error => "错误",
        TemplateIssueSeverity.Warning => "警告",
        _ => "提示"
    };

    private static string? FieldLabel(string? field) => field switch
    {
        nameof(CommandTemplate.Name) => "模板名称",
        nameof(CommandTemplate.CommandArgs) => "命令参数",
        nameof(CommandTemplate.OutputExtension) => "输出扩展名",
        nameof(CommandTemplate.Category) => "分类",
        nameof(CommandTemplate.Parameters) => "参数",
        nameof(CommandTemplate.RequiredEncoder) => "所需编码器",
        null or "" => null,
        _ => field
    };

    // ────────────────────────────────────────────────────────────────
    // 基本信息编辑
    // ────────────────────────────────────────────────────────────────

    private static string Str(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    /// <summary>同名模板（忽略大小写，排除自己）</summary>
    private CommandTemplate? DuplicateName
    {
        get
        {
            var name = _draft.Name?.Trim() ?? string.Empty;
            if (name.Length == 0) return null;

            return _allTemplates.FirstOrDefault(template =>
                !SameId(template.Id, _draft.Id) &&
                string.Equals((template.Name ?? string.Empty).Trim(), name, StringComparison.CurrentCultureIgnoreCase));
        }
    }

    private void OnNameInput(ChangeEventArgs e)
    {
        _draft.Name = Str(e);
        RefreshDerived();
