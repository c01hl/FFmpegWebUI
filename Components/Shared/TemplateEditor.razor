    private void BuildEncoderOptions()
    {
        var choices = new List<EncoderChoice>();

        // 1) 编码器族：始终列出，便于为别的机器编写模板
        foreach (var family in EncoderFamilies)
        {
            var profiles = EncoderCatalog.ByFamily(family).ToList();
            var availableHere = profiles.Count > 0 && profiles.Any(profile =>
                profile.SupportsCurrentPlatform &&
                (_availableEncoders is null || _availableEncoders.Contains(profile.Name)));

            choices.Add(new EncoderChoice(
                family,
                $"{EncoderCatalog.FamilyDisplayName(family)} · 按族自动挑选{(availableHere ? string.Empty : UnavailableSuffix)}",
                true));
        }

        // 2) 具体编码器：以 EncoderCatalog 为准，本机不支持的也保留并写明原因
        foreach (var profile in EncoderCatalog.Profiles
                     .OrderByDescending(profile => profile.SupportsCurrentPlatform)
                     .ThenBy(profile => profile.Family, StringComparer.Ordinal)
                     .ThenBy(profile => profile.SortPreference))
        {
            var machineAvailable = !profile.IsHardware
                                   || _availableEncoders is null
                                   || _availableEncoders.Contains(profile.Name);
            var available = profile.SupportsCurrentPlatform && machineAvailable;

            var suffix = available ? string.Empty : $"{UnavailableSuffix}（{UnavailableReason(profile)}）";
            choices.Add(new EncoderChoice(profile.Name, $"{profile.Name} · {profile.DisplayName}{suffix}", false));
        }

        _encoderOptions = choices;
    }

    private static string UnavailableReason(EncoderProfile profile)
    {
        if (!profile.SupportsCurrentPlatform)
        {
            var platforms = profile.Family switch
            {
                "nvenc" or "amf" or "vulkan" => "Windows / Linux",
                "videotoolbox" => "macOS",
                "vaapi" => "Linux",
                "mf" => "Windows",
                _ => "其它平台"
            };
            return $"仅 {platforms} 可用";
        }

        return "本机未检测到可用硬件";
    }

    private IEnumerable<EncoderChoice> FamilyEncoderChoices => _encoderOptions.Where(choice => choice.IsFamily);

    private IEnumerable<EncoderChoice> ConcreteEncoderChoices => _encoderOptions.Where(choice => !choice.IsFamily);

