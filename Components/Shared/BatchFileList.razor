@using System.Globalization
@inject IFileService FileService
@inject IFileDialogService FileDialogService
@inject IToastService Toast

<div class="batch-files">
    <div class="bf-header">
        <h3 class="bf-title">
            📄 待处理文件
            <span class="ffui-badge">@Files.Count</span>
            @if (TotalSize > 0)
            {
                <span class="ffui-badge">共 @FileService.FormatFileSize(TotalSize)</span>
            }
        </h3>

        @if (Files.Count > 0)
        {
            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => _showConfirmClear = true"
                    disabled="@IsProcessing">
                清空
            </button>
        }
    </div>

    <div class="bf-add">
        <label class="visually-hidden" for="batch-path-input">要添加的文件或文件夹路径</label>
        <input id="batch-path-input" type="text"
               value="@_newPath"
               disabled="@IsProcessing"
               placeholder="粘贴文件或文件夹的完整路径，按 Enter 添加（可一次粘贴多行）"
               @oninput="e => _newPath = e.Value?.ToString() ?? string.Empty"
               @onkeydown="OnPathKeyDownAsync" />

        <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-primary"
                @onclick="AddTypedPathAsync" disabled="@(IsProcessing || string.IsNullOrWhiteSpace(_newPath))">
            添加
        </button>
        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="BrowseFilesAsync" disabled="@IsProcessing || _isScanning">
            选择文件
        </button>
        <button type="button" class="ffui-btn ffui-btn-sm" @onclick="BrowseFolderAsync" disabled="@IsProcessing || _isScanning">
            选择文件夹
        </button>
    </div>

    <div class="bf-options">
        <label class="bf-check">
            <input type="checkbox" @bind="_recursive" disabled="@IsProcessing || _isScanning" />
            递归扫描子文件夹
        </label>
        <span class="bf-dialog-hint">浏览按钮使用 @FileDialogService.BackendDescription</span>
    </div>

    @if (_isScanning)
    {
        <div class="ffui-loading-row"><span class="spinner"></span> 正在扫描目录…</div>
    }

    @if (Files.Count > 6)
    {
        <div class="bf-filter">
            <label class="visually-hidden" for="batch-filter">按文件名筛选</label>
            <input id="batch-filter" type="search" @bind="_filter" @bind:event="oninput" placeholder="按文件名筛选…" />
            @if (!string.IsNullOrEmpty(_filter))
            {
                <span class="muted">匹配 @FilteredFiles.Count / @Files.Count</span>
            }
        </div>
    }

    @if (Files.Count == 0)
    {
        <div class="ffui-empty-state">
            还没有添加文件。<br />
            用上面的输入框粘贴路径，或点击「选择文件 / 选择文件夹」批量添加。
        </div>
    }
    else if (FilteredFiles.Count == 0)
    {
        <div class="ffui-empty-state">
            <p>没有匹配「@_filter」的文件。</p>
            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => _filter = string.Empty">清除筛选</button>
        </div>
    }
    else
    {
        <ul class="bf-list">
            @foreach (var file in FilteredFiles)
            {
                <li class="bf-item @RowClass(file)" @key="file">
                    <span class="bf-icon" aria-hidden="true">@RowIcon(file)</span>

                    <div class="bf-item-main">
                        <div class="bf-name" title="@file">@Path.GetFileName(file)</div>
                        <div class="bf-path" title="@file">@Path.GetDirectoryName(file)</div>
                    </div>

                    <span class="bf-size">@SizeOf(file)</span>

                    @if (StatusOf(file) is { } status)
                    {
                        <span class="ffui-badge @StatusBadgeClass(status)">@StatusText(status)</span>
                    }

                    <button type="button" class="ffui-icon-btn" aria-label="移除 @Path.GetFileName(file)"
                            disabled="@IsProcessing" @onclick="() => RemoveAsync(file)">
                        ✕
                    </button>
                </li>
            }
        </ul>
    }
</div>

<ConfirmDialog IsOpen="_showConfirmClear" IsOpenChanged="v => _showConfirmClear = v"
               Title="清空文件列表" Danger
               Message="确定要清空待处理文件列表吗？"
               Detail="@($"将移除列表中的 {Files.Count} 个文件。不会删除磁盘上的任何文件。")"
               ConfirmText="清空列表"
               OnConfirm="ClearAsync" />

<style>
    .batch-files { display: flex; flex-direction: column; gap: 0.65rem; }

    .bf-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
    .bf-title { margin: 0; font-size: 1rem; display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap; }

    .bf-add { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .bf-add input { flex: 1; min-width: 220px; }

    .bf-options { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; font-size: 0.82rem; color: var(--text-muted); }
    .bf-check { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
    .bf-dialog-hint { color: var(--text-muted); }

    .bf-filter { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .bf-filter input { max-width: 320px; }

    .muted { color: var(--text-muted); font-size: 0.82rem; }

    .bf-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        max-height: 380px;
        overflow-y: auto;
    }

    .bf-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0.55rem;
        border: 1px solid var(--border-color);
        border-left-width: 3px;
        border-radius: var(--radius-sm);
        background: var(--surface-3);
    }

    .bf-item.state-running { border-left-color: var(--info-color); }
    .bf-item.state-completed { border-left-color: var(--success-color); }
    .bf-item.state-failed { border-left-color: var(--danger-color); }
    .bf-item.state-cancelled, .bf-item.state-skipped { border-left-color: var(--warning-color); }
    .bf-item.state-pending { border-left-color: var(--border-strong); }

    .bf-icon { flex-shrink: 0; }
    .bf-item-main { flex: 1; min-width: 0; }
    .bf-name { font-size: 0.88rem; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bf-path { font-size: 0.75rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bf-size { font-size: 0.78rem; color: var(--text-muted); flex-shrink: 0; font-family: var(--font-mono); }
</style>

@code {
    /// <summary>待处理文件列表（由父组件持有）</summary>
    [Parameter] public List<string> Files { get; set; } = [];

    /// <summary>列表变化回调</summary>
    [Parameter] public EventCallback<List<string>> FilesChanged { get; set; }

    /// <summary>每个文件的处理状态（键为完整路径，值为 TaskStatus 名称）</summary>
    [Parameter] public Dictionary<string, string>? FileStatuses { get; set; }

    /// <summary>是否正在处理（处理期间禁止改动列表）</summary>
    [Parameter] public bool IsProcessing { get; set; }

    /// <summary>单次扫描的文件数量上限，避免误选根目录时把内存打满</summary>
    [Parameter] public int ScanLimit { get; set; } = 5000;

    private string _newPath = string.Empty;
    private string _filter = string.Empty;
    private bool _recursive = true;
    private bool _isScanning;
    private bool _showConfirmClear;

    /// <summary>文件大小缓存：旧实现每次渲染都对每行做同步 IO，网络盘上会卡住界面</summary>
    private readonly Dictionary<string, long> _sizeCache = new(StringComparer.Ordinal);

    private List<string> FilteredFiles
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filter)) return Files;
            return Files
                .Where(f => Path.GetFileName(f).Contains(_filter, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private long TotalSize => Files.Sum(SizeOf);

    private long SizeOf(string path)
    {
        if (_sizeCache.TryGetValue(path, out var cached)) return cached;
        var size = FileService.GetFileSize(path);
        _sizeCache[path] = size;
        return size;
    }

    // ── 添加 ────────────────────────────────────────────────────────

    private async Task OnPathKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is not ("Enter" or "NumpadEnter")) return;
        if (string.IsNullOrWhiteSpace(_newPath)) return;
        await AddTypedPathAsync();
    }

    private async Task AddTypedPathAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPath)) return;

        try
        {
            // 一次可以粘贴多行路径
            var candidates = _newPath
                .Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();

            _newPath = string.Empty;

            var files = new List<string>();
            var directories = new List<string>();
            var missing = new List<string>();

            foreach (var candidate in candidates)
            {
                var path = AppPaths.ToAbsolute(candidate);
                if (File.Exists(path)) files.Add(path);
                else if (Directory.Exists(path)) directories.Add(path);
                else missing.Add(candidate);
            }

            if (missing.Count > 0)
            {
                var shown = string.Join("、", missing.Take(3));
                Toast.Warning($"以下路径不存在，已忽略：{shown}" + (missing.Count > 3 ? $" 等共 {missing.Count} 个" : ""));
            }

            if (directories.Count > 0)
            {
                await ScanDirectoriesAsync(directories);
            }

            if (files.Count > 0)
            {
                await AddFilesAsync(files);
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"添加失败：{ex.Message}");
        }
    }

    private async Task BrowseFilesAsync()
    {
        try
        {
            var initial = Files.Count > 0 ? Path.GetDirectoryName(Files[0]) : null;
            var picked = await FileDialogService.PickFileAsync("选择媒体文件", null, initial);

            if (string.IsNullOrEmpty(picked))
            {
                // 返回 null 既可能是用户取消，也可能是该平台没有可用的对话框后端
                Toast.Show($"没有选择文件。如果对话框没有弹出，可以直接把路径粘贴到上方输入框。" +
                           $"（当前后端：{FileDialogService.BackendDescription}）");
                return;
            }

            await AddFilesAsync([picked]);
        }
        catch (Exception ex)
        {
            Toast.Error($"打开文件选择器失败：{ex.Message}");
        }
    }

    private async Task BrowseFolderAsync()
    {
        try
        {
            var picked = await FileDialogService.PickFolderAsync("选择包含媒体文件的文件夹");

            if (string.IsNullOrEmpty(picked))
            {
                Toast.Show($"没有选择文件夹。如果对话框没有弹出，可以直接把文件夹路径粘贴到上方输入框。" +
                           $"（当前后端：{FileDialogService.BackendDescription}）");
                return;
            }

            await ScanDirectoriesAsync([picked]);
        }
        catch (Exception ex)
        {
            Toast.Error($"打开文件夹选择器失败：{ex.Message}");
        }
    }

    /// <summary>扫描目录。放到后台线程执行，避免阻塞渲染线程。</summary>
    private async Task ScanDirectoriesAsync(List<string> directories)
    {
        _isScanning = true;
        try
        {
            var recursive = _recursive;
            var limit = Math.Max(1, ScanLimit);

            var found = await Task.Run(() =>
            {
                var result = new List<string>();
                foreach (var directory in directories)
                {
                    result.AddRange(FileService.ScanMediaFiles(directory, null, recursive));
                }
                return result.Distinct(StringComparer.Ordinal).ToList();
            });

            if (found.Count == 0)
            {
                Toast.Warning("所选目录中没有找到可识别的媒体文件。");
                return;
            }

            var truncated = found.Count > limit;
            await AddFilesAsync(truncated ? found.Take(limit).ToList() : found);

            if (truncated)
            {
                Toast.Warning($"该目录文件过多，只添加了前 {limit} 个。建议缩小范围后分批处理。");
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"扫描目录失败：{ex.Message}");
        }
        finally
        {
            _isScanning = false;
        }
    }

    private async Task AddFilesAsync(IEnumerable<string> paths)
    {
        // 永远构造新列表再回传：就地修改父组件持有的列表会让 @bind 可能跳过重渲染
        var next = new List<string>(Files);
        var existing = new HashSet<string>(next, StringComparer.Ordinal);
        var added = 0;
        var duplicates = 0;

        foreach (var path in paths)
        {
            var absolute = AppPaths.ToAbsolute(path);
            if (!existing.Add(absolute))
            {
                duplicates++;
                continue;
            }
            next.Add(absolute);
            added++;
        }

        if (added == 0)
        {
            Toast.Show(duplicates > 0 ? "这些文件已经在列表中了。" : "没有可添加的文件。");
            return;
        }

        await FilesChanged.InvokeAsync(next);

        var message = $"已添加 {added} 个文件";
        if (duplicates > 0) message += $"，跳过 {duplicates} 个重复项";
        Toast.Success(message);
    }

    private async Task RemoveAsync(string path)
    {
        var next = Files.Where(f => !string.Equals(f, path, StringComparison.Ordinal)).ToList();
        _sizeCache.Remove(path);
        await FilesChanged.InvokeAsync(next);
    }

    private async Task ClearAsync()
    {
        _sizeCache.Clear();
        _showConfirmClear = false;
        await FilesChanged.InvokeAsync([]);
        Toast.Success("已清空文件列表（磁盘上的文件未受影响）");
    }

    // ── 状态展示 ────────────────────────────────────────────────────

    /// <summary>把父组件传入的状态字符串解析成 <see cref="TaskStatus"/></summary>
    private TaskStatus? StatusOf(string path)
    {
        if (FileStatuses == null || !FileStatuses.TryGetValue(path, out var raw)) return null;
        if (string.IsNullOrWhiteSpace(raw)) return null;

        // 兼容旧数据里写入的大写枚举名
        return Enum.TryParse<TaskStatus>(raw, ignoreCase: true, out var status) ? status : null;
    }

    private string RowClass(string path) => StatusOf(path) is { } status
        ? "state-" + status.ToString().ToLowerInvariant()
        : "state-pending";

    private string RowIcon(string path) => StatusOf(path) switch
    {
        TaskStatus.Running => "⏳",
        TaskStatus.Completed => "✅",
        TaskStatus.Failed => "❌",
        TaskStatus.Cancelled => "⏹️",
        TaskStatus.Skipped => "⏭️",
        TaskStatus.Pending => "⏸️",
        _ => ExtensionIcon(path)
    };

    private static string ExtensionIcon(string path) => Path.GetExtension(path).ToLowerInvariant() switch
    {
        ".mp4" or ".m4v" or ".mov" or ".mkv" or ".avi" or ".webm" or ".wmv" or ".flv" => "🎬",
        ".mp3" or ".wav" or ".flac" or ".aac" or ".ogg" or ".m4a" or ".opus" or ".wma" => "🎵",
        ".gif" or ".png" or ".jpg" or ".jpeg" or ".bmp" or ".webp" => "🖼️",
        _ => "📄"
    };

    private static string StatusText(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "已完成",
        TaskStatus.Failed => "失败",
        TaskStatus.Running => "进行中",
        TaskStatus.Cancelled => "已取消",
        TaskStatus.Skipped => "已跳过",
        _ => "等待中"
    };

    private static string StatusBadgeClass(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "ffui-badge-success",
        TaskStatus.Failed => "ffui-badge-danger",
        TaskStatus.Running => "ffui-badge-info",
        TaskStatus.Cancelled => "ffui-badge-warning",
        TaskStatus.Skipped => "ffui-badge-warning",
        _ => string.Empty
    };
}
