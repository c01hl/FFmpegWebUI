@using LiteDB
@inject IToastService Toast
@inject IJSRuntime JS
@inject IFileService FileService

@{
    var total = Tasks.Count;
    var completed = Tasks.Count(t => t.Status == TaskStatus.Completed);
    var failed = Tasks.Count(t => t.Status == TaskStatus.Failed);
    var cancelled = Tasks.Count(t => t.Status == TaskStatus.Cancelled);
    var skipped = Tasks.Count(t => t.Status == TaskStatus.Skipped);
    var running = Tasks.Count(t => t.Status == TaskStatus.Running);
    var pending = Tasks.Count(t => t.Status == TaskStatus.Pending);
    var finished = completed + failed + cancelled + skipped;
    var percent = total > 0 ? Math.Clamp(finished * 100.0 / total, 0, 100) : 0;
    var visible = VisibleTasks;
    var hidden = Math.Max(0, total - visible.Count);
}

<div class="batch-progress">
    @if (total == 0)
    {
        <div class="ffui-empty-state">还没有开始批量处理。添加文件、选好模板后点击「开始批量处理」。</div>
    }
    else
    {
        <div class="summary" aria-live="polite">
            <div class="summary-main">
                <span class="summary-count">@finished / @total</span>
                <span class="muted">已处理</span>
                @if (running > 0)
                {
                    <span class="ffui-badge ffui-badge-info">@running 个进行中</span>
                }
                @if (pending > 0)
                {
                    <span class="ffui-badge">@pending 个等待中</span>
                }
                @if (!IsProcessing && finished == total)
                {
                    <span class="ffui-badge @(failed + cancelled == 0 ? "ffui-badge-success" : "ffui-badge-warning")">
                        @(failed + cancelled == 0 ? "全部成功" : "已完成，含失败项")
                    </span>
                }
            </div>

            <div class="ffui-progress-track" role="progressbar"
                 aria-valuemin="0" aria-valuemax="100"
                 aria-valuenow="@percent.ToString("0", CultureInfo.InvariantCulture)"
                 aria-label="批量处理总进度">
                <div class="ffui-progress-fill" style="width:@(percent.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
            </div>

            <div class="counters">
                <span class="counter ok">✅ 已完成 @completed</span>
                @if (failed > 0)
                {
                    <span class="counter bad">❌ 失败 @failed</span>
                }
                @if (cancelled > 0)
                {
                    <span class="counter warn">⏹️ 已取消 @cancelled</span>
                }
                @if (skipped > 0)
                {
                    <span class="counter warn">⏭️ 已跳过 @skipped</span>
                }
                @if (Elapsed is { } elapsed)
                {
                    <span class="counter muted">已用时 @FormatDuration(elapsed)</span>
                }
                @if (EtaSeconds is { } eta)
                {
                    <span class="counter muted">预计还需 @FormatDuration(TimeSpan.FromSeconds(eta))</span>
                }
            </div>
        </div>

        <div class="task-rows" role="list">
            @foreach (var task in visible)
            {
                <div class="task-row @RowClass(task.Status)" role="listitem" @key="task.Id">
                    <span class="row-status" aria-hidden="true">@StatusIcon(task.Status)</span>

                    <div class="row-main">
                        <div class="row-name" title="@task.InputPath">@Path.GetFileName(task.InputPath)</div>
                        <div class="row-sub">
                            <span class="ffui-badge @StatusBadgeClass(task.Status)">@StatusText(task.Status)</span>
                            @if (task.Status == TaskStatus.Running)
                            {
                                <span class="muted">@task.Progress.ToString("0.#", CultureInfo.InvariantCulture)%</span>
                                @if (task.ProcessingSpeed is > 0)
                                {
                                    <span class="muted">@task.ProcessingSpeed.Value.ToString("0.##", CultureInfo.InvariantCulture)x</span>
                                }
                            }
                            else if (task.OutputFileSize is > 0)
                            {
                                <span class="muted">@FileService.FormatFileSize(task.OutputFileSize.Value)</span>
                            }
                            @if (!string.IsNullOrEmpty(task.ErrorMessage))
                            {
                                <span class="row-error" title="@task.ErrorMessage">@Shorten(task.ErrorMessage, 90)</span>
                            }
                        </div>
                    </div>

                    <div class="row-actions">
                        @if (task.Status == TaskStatus.Running)
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm ffui-btn-danger"
                                    @onclick="() => OnCancel.InvokeAsync(task.Id)">终止</button>
                        }
                        else if (task.Status == TaskStatus.Pending)
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm"
                                    @onclick="() => OnCancel.InvokeAsync(task.Id)">取消</button>
                        }
                        else
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm"
                                    @onclick="() => OnRetry.InvokeAsync(task.Id)">重试</button>
                        }

                        @if (task.Status is TaskStatus.Failed or TaskStatus.Cancelled && !string.IsNullOrEmpty(task.ErrorMessage))
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm" @onclick="() => CopyErrorAsync(task)">
                                复制错误
                            </button>
                        }

                        @if (task.Status == TaskStatus.Completed)
                        {
                            <button type="button" class="ffui-btn ffui-btn-sm"
                                    @onclick="() => OnOpenOutputFolder.InvokeAsync(task.OutputPath)">
                                打开目录
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (hidden > 0 || _showAll)
        {
            <button type="button" class="ffui-btn ffui-btn-sm more-btn" @onclick="ToggleShowAll">
                @(_showAll ? "只看进行中与失败的任务" : $"还有 {hidden} 个任务，展开全部")
            </button>
        }
    }
</div>

<style>
    .summary { margin-bottom: 0.85rem; }
    .summary-main { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
    .summary-count { font-size: 1.15rem; font-weight: 650; color: var(--text-primary); }
    .muted { color: var(--text-muted); font-size: 0.83rem; }
    .counters { display: flex; gap: 0.9rem; margin-top: 0.5rem; flex-wrap: wrap; font-size: 0.84rem; }
    .counter.ok { color: var(--success-color); }
    .counter.bad { color: var(--danger-color); }
    .counter.warn { color: var(--warning-color); }
    .counter.muted { color: var(--text-muted); }

    .task-rows { display: flex; flex-direction: column; gap: 0.4rem; max-height: 460px; overflow-y: auto; }

    .task-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.5rem 0.65rem;
        border: 1px solid var(--border-color);
        border-left-width: 3px;
        border-radius: var(--radius-sm);
        background: var(--surface-3);
    }

    .task-row.state-running { border-left-color: var(--info-color); }
    .task-row.state-completed { border-left-color: var(--success-color); }
    .task-row.state-failed { border-left-color: var(--danger-color); }
    .task-row.state-cancelled, .task-row.state-skipped { border-left-color: var(--warning-color); }

    .row-status { flex-shrink: 0; }
    .row-main { flex: 1; min-width: 0; }
    .row-name { font-size: 0.88rem; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .row-sub { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-top: 0.2rem; }
    .row-error { color: var(--danger-color); font-size: 0.8rem; }
    .row-actions { display: flex; gap: 0.35rem; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }

    .more-btn { margin-top: 0.6rem; }
</style>

@code {
    /// <summary>本批次的全部任务</summary>
    [Parameter] public List<ConversionTask> Tasks { get; set; } = [];

    /// <summary>是否正在处理（仅用于状态显示）</summary>
    [Parameter] public bool IsProcessing { get; set; }

    /// <summary>重试某个任务</summary>
    [Parameter] public EventCallback<ObjectId> OnRetry { get; set; }

    /// <summary>取消某个任务</summary>
    [Parameter] public EventCallback<ObjectId> OnCancel { get; set; }

    /// <summary>打开输出目录（参数为输出文件路径）</summary>
    [Parameter] public EventCallback<string> OnOpenOutputFolder { get; set; }

    private bool _showAll;

    /// <summary>
    /// 全部计数都从 <see cref="Tasks"/> 推导。
    /// 旧实现把计数做成参数，还伪造 RunningCount = IsProcessing ? 1 : 0，
    /// 导致数字会出现负数或与实际不符。
    /// </summary>
    private List<ConversionTask> VisibleTasks
    {
        get
        {
            if (_showAll) return Tasks.OrderBy(t => t.CreatedAt).ToList();

            var priority = Tasks
                .Where(t => t.Status is TaskStatus.Running or TaskStatus.Pending
                            or TaskStatus.Failed or TaskStatus.Cancelled)
                .ToList();

            var filler = Tasks
                .Where(t => !priority.Contains(t))
                .OrderByDescending(t => t.CreatedAt)
                .Take(Math.Max(0, 8 - priority.Count))
                .ToList();

            return priority.Concat(filler).OrderBy(t => t.CreatedAt).ToList();
        }
    }

    private TimeSpan? Elapsed => Tasks.Count == 0
        ? null
        : Tasks.Max(t => t.CompletedAt ?? DateTime.UtcNow) - Tasks.Min(t => t.CreatedAt);

    /// <summary>剩余时间：运行中任务的 ETA 最大值 + 等待中任务的粗略估算</summary>
    private double? EtaSeconds
    {
        get
        {
            var estimates = Tasks
                .Where(t => t.Status == TaskStatus.Running && t.EstimatedTimeRemaining is > 0)
                .Select(t => t.EstimatedTimeRemaining!.Value)
                .ToList();

            if (estimates.Count == 0) return null;

            var pending = Tasks.Count(t => t.Status == TaskStatus.Pending);
            return estimates.Max() + pending * estimates.Average();
        }
    }

    private void ToggleShowAll() => _showAll = !_showAll;

    private async Task CopyErrorAsync(ConversionTask task)
    {
        var text = string.IsNullOrEmpty(task.ErrorMessage) ? "(没有错误信息)" : task.ErrorMessage;
        var ok = await JS.InvokeAsync<bool>("ffui.copyText", text);

        if (ok) Toast.Success("错误信息已复制");
        else Toast.Error("复制失败：浏览器不允许访问剪贴板，请手动选中文本复制。");
    }

    private static string StatusIcon(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "✅",
        TaskStatus.Failed => "❌",
        TaskStatus.Running => "⏳",
        TaskStatus.Cancelled => "⏹️",
        TaskStatus.Skipped => "⏭️",
        _ => "⏸️"
    };

    private static string StatusText(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "已完成",
        TaskStatus.Failed => "失败",
        TaskStatus.Running => "进行中",
        TaskStatus.Cancelled => "已取消",
        TaskStatus.Skipped => "已跳过",
        _ => "等待中"
    };

    private static string StatusBadgeClass(TaskStatus status) => status switch
    {
        TaskStatus.Completed => "ffui-badge-success",
        TaskStatus.Failed => "ffui-badge-danger",
        TaskStatus.Running => "ffui-badge-info",
        TaskStatus.Cancelled => "ffui-badge-warning",
        TaskStatus.Skipped => "ffui-badge-warning",
        _ => string.Empty
    };

    private static string RowClass(TaskStatus status) => "state-" + status.ToString().ToLowerInvariant();

    private static string FormatDuration(TimeSpan? span)
    {
        if (span is not { } value || value.TotalSeconds <= 0) return "-";
        return value.TotalHours >= 1
            ? $"{(int)value.TotalHours}:{value.Minutes:D2}:{value.Seconds:D2}"
            : $"{value.Minutes:D2}:{value.Seconds:D2}";
    }

    private static string Shorten(string text, int max) =>
        text.Length <= max ? text : text[..max] + "…";
}
